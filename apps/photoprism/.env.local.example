# PhotoPrism — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=260601
DB_TAG=11.4

# --- User Mapping ---------------------------------------------------- [app] --
PUID=1000
PGID=1000

# --- Storage --------------------------------------------------------- [app] --
ORIGINALS_PATH=./volumes/local/originals

# --- Database --------------------------------------------------------- [db] --
DB_NAME=photoprism
DB_USER=photoprism
# openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__
# openssl rand -hex 32
DB_ROOT_PASSWORD=__REPLACE_ME__

# --- Admin account ---------------------------------------------------- [app] --
ADMIN_USER=admin
# openssl rand -base64 24 | tr -d '\n'
ADMIN_PASSWORD=__REPLACE_ME__

# --- Site metadata ---------------------------------------------------- [app] --
SITE_TITLE=PhotoPrism (local)
SITE_CAPTION=AI-Powered Photos App
DEFAULT_LOCALE=en
PLACES_LOCALE=local

# --- Timezone --------------------------------------------------------- [app] --
TZ=UTC
