# Reference App — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=1.29-alpine
DB_TAG=16-alpine

# --- Database -------------------------------------------------------- [app] --
DB_NAME=reference
DB_USER=reference
# Hex, because it is embedded in DATABASE_URL:  openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__

# --- App Configuration ----------------------------------------------- [app] --
# openssl rand -base64 32 | tr -d '\n'
APP_KEY=__REPLACE_ME__
APP_LOG_LEVEL=debug

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
