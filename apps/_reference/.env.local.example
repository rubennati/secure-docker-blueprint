# =============================================================================
# Reference App – LOCAL environment  (docker-compose.local.yml)
# =============================================================================
# Copy to .env.local and fill in. Plain values, gitignored — LOCAL ONLY.
#   cp .env.local.example .env.local
#
# Deliberately short: only what the local stack needs. No Traefik section (no
# proxy), no container-name section (fixed -local names), no SMTP.
# =============================================================================

# --- Images ------------------------------------------------------- [image] --
# Same pins as production, so local tests the same code.
APP_TAG=1.29-alpine
DB_TAG=16-alpine

# --- Database -------------------------------------------------------- [app] --
DB_NAME=reference
DB_USER=reference
# Hex, because it is embedded in DATABASE_URL:  openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__

# --- App Configuration ----------------------------------------------- [app] --
# openssl rand -base64 32 | tr -d '\n'
APP_KEY=__REPLACE_ME__
APP_LOG_LEVEL=debug

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
