# =============================================================================
# Reference App – Environment
# =============================================================================
# THE canonical .env.example. Copy this file when adding a new app, then delete
# what the app does not need. Sections you keep must stay in this order.
#
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================
#
# LAYERS — every variable belongs to exactly one. Sections are ordered by
# how often you touch them, and tagged with the layer they configure:
#
#   [compose]  Docker Compose itself — project, container, network names
#   [traefik]  the reverse proxy — hostname, TLS, access, security chain
#   [image]    which image versions get pulled
#   [app]      the application's own settings
#   [secrets]  documented here, values live in .secrets/ — never in this file
#
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
# First, and without a section header: everything else derives from it.
# Drives container names, the internal network name, and Traefik router names.
# Use the app's short lowercase name — must be unique across the whole stack.
COMPOSE_PROJECT_NAME=reference


# --- Domain & Traefik ------------------------------------------- [traefik] --
# How the app is reached from outside. First real section because this is what
# changes on every deployment.

# Public hostname. Always example.com in a committed .env.example.
APP_TRAEFIK_HOST=reference.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
#   cloudflare-dns  DNS-01 — wildcards, no port 80 needed
#   httpResolver    HTTP-01 — no DNS provider needed
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS profile:
#   tls-basic   TLS 1.2+ — broad client compatibility
#   tls-aplus   TLS 1.2+ strict cipher set — the default for public apps
#   tls-modern  TLS 1.3 only — modern clients only
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach the app:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=acc-public

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
#   sec-2           standard default for a new app
#   sec-3           public-facing and hardened (recommended once it works)
#   *e suffix       iframe-friendly (embedded apps: OnlyOffice, Vaultwarden)
#   *-spa suffix    high burst rate limit for code-split SPAs
APP_TRAEFIK_SECURITY=sec-2
# Threat enforcement — the third axis, independent of the two above.
# Empty by default: no CrowdSec bouncer on this router.
#
# To enable, name a profile from core/crowdsec/docs/profiles.md and keep the
# trailing comma — the value is prepended to the middleware list, and it has to
# come first so a banned address is rejected before anything else does work on
# the request:
#   APP_TRAEFIK_THREAT=crowdsec-basic@file,
APP_TRAEFIK_THREAT=

# Port the app listens on INSIDE its container — not a host port.
APP_INTERNAL_PORT=8080

# Shared proxy network, created by core/traefik. Same value in every app.
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# One tag variable per image. The image NAME is hardcoded in docker-compose.yml;
# only the tag lives here, with the registry link as a comment above it.
#
# Pinning — two tiers (docs/standards/env-structure.md):
#   app images    major.minor.patch   — a patch can carry DB migrations
#   infra images  major.minor         — patches are security fixes, safe to float
# Never :latest. Never major-only (8, v2).
#
# Strongest form is a digest pin — a re-pushed tag then cannot change the image:
#   APP_TAG=1.2.3@sha256:<digest>
#   docker buildx imagetools inspect <image>:<tag>     # to read the digest
# Use it for anything security-critical or without trustworthy tags.

# nginx-unprivileged (https://hub.docker.com/r/nginxinc/nginx-unprivileged)
# — stand-in for the real app image; runs as non-root, listens on 8080
APP_TAG=1.29-alpine
# postgres (https://hub.docker.com/_/postgres)
DB_TAG=16-alpine


# --- Containers -------------------------------------------------- [compose] --
# Derived from COMPOSE_PROJECT_NAME so names stay predictable: reference-app,
# reference-db. One line per service in docker-compose.yml.
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db


# --- Database -------------------------------------------------------- [app] --
# Non-sensitive database settings only. The password is a Docker Secret.
# Delete this whole section if the app has no database.
DB_NAME=reference
DB_USER=reference


# --- App Configuration ----------------------------------------------- [app] --
# The application's own settings. Prefix app-specific variables so their origin
# stays obvious (VW_ for Vaultwarden, PAPERLESS_ for Paperless, …).
# Comment anything whose name is not self-explanatory; keep real, working
# defaults where one exists.

# Log verbosity — example of a documented, sensible default.
APP_LOG_LEVEL=info

# Attack surface: disable public self-registration unless the app is meant to
# be open. Security-relevant toggles belong here, with the reason stated.
APP_DISABLE_SIGNUP=true


# --- SMTP ------------------------------------------------------------ [app] --
# Mail relay. Delete if the app sends no mail. The password is a Docker Secret —
# never in this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDRESS=reference@example.com
SMTP_FROM_NAME=Reference
SMTP_USERNAME=


# --- Timezone -------------------------------------------------------- [app] --
# Near the end: set once, rarely touched. UTC is the committed default.
# Examples: UTC, Europe/Vienna, Europe/Berlin, America/New_York
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
# Read them in the container from /run/secrets/, never from the environment.
#
#   mkdir -p .secrets volumes/postgres
#
# Passwords that end up inside a URL (postgres://user:pw@host/db) must be hex —
# base64 produces + / = which break URL parsing:
#   openssl rand -hex 32 > .secrets/db_pwd.txt
#
# Everything else (tokens, signing keys) can be base64 — always strip the
# newline, or the value silently gains a trailing \n:
#   openssl rand -base64 32 | tr -d '\n' > .secrets/app_key.txt
#
# File name (db_pwd.txt) maps to the secret NAME (DB_PWD) in docker-compose.yml,
# which the container reads at /run/secrets/DB_PWD. Keep the three aligned.
#
# Optional secrets still need the file to exist (empty is fine):
#   touch .secrets/smtp_password.txt
