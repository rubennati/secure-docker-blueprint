# =============================================================================
# calrs – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=calrs


# --- Domain & Traefik ------------------------------------------- [traefik] --
# One host serves both the booking pages guests open and the pages the
# administrator works in. Confirmation mail and OIDC redirects are built from it.
APP_TRAEFIK_HOST=cal.example.com


# WHO may reach it.
#   access-public   everyone
#   access-trusted  the ranges TRUSTED_RANGES declares in core/traefik/.env; empty: nobody
#   access-vpn      VPN only
#   access-trusted-vpn  those ranges + VPN
#   access-blocked  nobody — the emergency kill switch
#
# VPN-only by default, deliberately: until ops/bootstrap-admin.sh has run,
# whoever reaches the instance first can register and becomes the
# administrator. Guests cannot book through a closed router, so opening it is
# the deliberate step after the bootstrap — see the README.
APP_TRAEFIK_ACCESS=access-vpn

# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file


TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# calrs (https://github.com/olivierlambert/calrs)
APP_TAG=1.17.1


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- Logging --------------------------------------------------------- [app] --
# error, warn, info, debug, trace
LOG_LEVEL=info


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the file:
#
#   ops/init.sh
#
#   .secrets/calrs_secret_key.txt   encrypts stored CalDAV and SMTP passwords
#
# Back it up with the data directory and never change it once calendars are
# connected: the stored passwords are unreadable without it.
