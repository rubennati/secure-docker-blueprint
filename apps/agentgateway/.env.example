# =============================================================================
# agentgateway – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=agentgateway


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The traffic gateway: LLM under /v1, MCP under /mcp.
APP_TRAEFIK_HOST=agentgateway.example.com

# The web UI, on its own host name and gateway.
AGW_UI_TRAEFIK_HOST=agentgateway-ui.example.com

# TLS profile — see docs/standards/traefik-security.md.
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach the traffic gateway. Requests also need the API key.
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=acc-private

# WHO may reach the UI. It also asks for the basic-auth login. An administrative
# surface: keep it narrower than the traffic gateway.
AGW_UI_TRAEFIK_ACCESS=acc-private

# WHAT headers / rate limit apply — see docs/standards/traefik-security.md.
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — empty by default: no CrowdSec bouncer on these routers.
# See core/crowdsec/docs/profiles.md to enable one; keep the trailing comma.
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# agentgateway (https://github.com/agentgateway/agentgateway)
APP_TAG=v1.5.0


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates everything:
#
#   ops/init.sh [ui-user]
#   sudo chown 65532:65532 volumes/data
#
# It writes .secrets/agw_api_key.txt (the client key), .secrets/agw_ui_password.txt
# and .secrets/agw_ui_htpasswd.txt (mounted as a Docker Secret), and renders
# config/config.yaml with the key's SHA-256 — the key itself is not stored there.
