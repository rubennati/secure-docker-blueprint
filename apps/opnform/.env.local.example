# OpnForm — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=2.2.2
NGINX_TAG=1.29
DB_TAG=16-alpine
REDIS_TAG=7.4-alpine

# --- Web ------------------------------------------------------------ [app] --
NGINX_MAX_BODY_SIZE=64m

# --- Database -------------------------------------------------------- [db] --
DB_NAME=opnform
DB_USER=opnform
#   openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__

# --- App Keys & Secrets --------------------------------------------- [app] --
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=__REPLACE_ME__

#   openssl rand -base64 32 | tr -d '\n'
JWT_SECRET=__REPLACE_ME__

#   openssl rand -base64 32 | tr -d '\n'
FRONT_API_SECRET=__REPLACE_ME__

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
