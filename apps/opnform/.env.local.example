# OpnForm — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=2.8.4
NGINX_TAG=1.31.8
DB_TAG=16.15-alpine
REDIS_TAG=8.10.3-alpine

# --- Web ------------------------------------------------------------ [app] --
NGINX_MAX_BODY_SIZE=64m

# --- Database -------------------------------------------------------- [db] --
DB_NAME=opnform
DB_USER=opnform
#   openssl rand -hex 32
DB_PASSWORD=

# --- App Keys & Secrets --------------------------------------------- [app] --
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

#   openssl rand -base64 32 | tr -d '\n'
JWT_SECRET=

#   openssl rand -base64 32 | tr -d '\n'
FRONT_API_SECRET=

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
