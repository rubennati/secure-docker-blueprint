# =============================================
# Tymeslot – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# Tymeslot is AGPL-3.0, published by Diletta Luna OÜ (Tallinn, Estonia).
# The first account that registers becomes the instance admin.
# =============================================

COMPOSE_PROJECT_NAME=tymeslot

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=tymeslot.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
# Booking pages exist for guests, so a production instance would run
# acc-public. Until that is decided, nothing is published.
APP_TRAEFIK_ACCESS=acc-tailscale
# sec-3: a first load is about ten requests, far below the soft burst of 50
# (measured 2026-09-07). Every page carries the app's own CSP with
# frame-ancestors 'none', so the chain's X-Frame-Options: DENY agrees with it.
# DENY also stops booking pages from being embedded in other sites (embed.js);
# if that feature is wanted, the embed routes need a per-app middleware.
APP_TRAEFIK_SECURITY=sec-3
# Threat enforcement — the third axis, independent of the two above.
# Empty by default: no CrowdSec bouncer on this router.
#
# To enable, name a profile from core/crowdsec/docs/profiles.md and keep the
# trailing comma — the value is prepended to the middleware list, and it has to
# come first so a banned address is rejected before anything else does work on
# the request:
#   APP_TRAEFIK_THREAT=crowdsec-basic@file,
APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# luka1thb/tymeslot (https://hub.docker.com/r/luka1thb/tymeslot)
# Always the -slim tag: the plain tag bundles a PostgreSQL server in the app
# container. Releases are frequent (eight in the first week of September 2026),
# so pin by digest and move the pin deliberately:
#   docker buildx imagetools inspect luka1thb/tymeslot:1.15.1-slim   # index digest
APP_TAG=1.15.1-slim@sha256:4bde62fd9bb1b0e477242adbae94662ec8b6f1d26e935f81d38d3f5c52212f58
# postgres (https://hub.docker.com/_/postgres) — upstream's compose uses 17
DB_TAG=17.11-alpine

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db

# --- Database ---
DB_NAME=tymeslot
DB_USER=tymeslot
# Ecto connection pool; keep PostgreSQL's max_connections (default 100) above it.
DATABASE_POOL_SIZE=10

# --- App Configuration ---
# Open until the first (admin) account exists, then set to false. The admin UI
# at /admin overrides this value at runtime.
REGISTRATION_ENABLED=true

# --- SMTP ---
# test  — discards every mail silently: password resets, confirmations, reminders
# smtp  — the relay below; SMTP_USERNAME and the password file must be non-empty
EMAIL_ADAPTER=test
EMAIL_FROM_NAME=Tymeslot
EMAIL_FROM_ADDRESS=tymeslot@example.com
SMTP_HOST=
# 587 = STARTTLS required, 465 = implicit TLS, any other port = opportunistic TLS
SMTP_PORT=587
SMTP_USERNAME=

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# Create the secrets directory and generate all required files:
#   mkdir -p .secrets volumes/postgres volumes/data
#   openssl rand -base64 64 | tr -d '\n' > .secrets/secret_key_base.txt       # at least 64 characters
#   openssl rand -base64 48 | tr -d '\n' > .secrets/data_encryption_key.txt   # never rotate — encrypts stored credentials
#   openssl rand -hex 32    | tr -d '\n' > .secrets/db_pwd.txt
#   touch .secrets/smtp_password.txt      # relay password — must be non-empty when EMAIL_ADAPTER=smtp
