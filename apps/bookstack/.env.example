# =============================================
# BookStack – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=bookstack

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=wiki.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# Ships closed: a new instance accepts the default admin admin@admin.com /
# password until it is changed. Change it over the VPN, then open the route
# (access-public) for readers — README, Security Model.
APP_TRAEFIK_ACCESS=access-vpn
# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file
# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge

# --- Images ---
# linuxserver/bookstack (https://docs.linuxserver.io/images/docker-bookstack/)
APP_TAG=version-v26.09.2@sha256:33f61a72d9aaa021f7e687987b9fcb992673d9ca3fc08f63f5ddaddf59e94efc
# mariadb (https://hub.docker.com/_/mariadb)
DB_TAG=12.3.3

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db

# --- User Mapping ---
# Must match the UID/GID that owns ./volumes/config/ on the host.
PUID=1000
PGID=1000

# --- Database ---
DB_NAME=bookstack
DB_USER=bookstack
# BookStack reads DB_PASSWORD from a single env var (no _FILE support).
# Value must match the content of ./.secrets/db_pwd.txt verbatim.
# See README "Known Issues" for rationale.
DB_PWD_INLINE=

# --- BookStack App Key ---
# Laravel APP_KEY — encrypts sessions, cookies, and password-reset tokens.
# Generate once with:
#   docker run --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:${APP_TAG} appkey
# Keep the "base64:" prefix in the output. Rotating invalidates sessions.
APP_KEY=

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/London, America/New_York
TZ=UTC
