# BookStack — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=version-v26.09.3@sha256:5e44313f320a8a6f92f171b1beca4748f3e0a5110a4f4c19047cb4b4e43695a2
DB_TAG=12.3.3

# --- User Mapping ---------------------------------------------------- [app] --
# id -u ; id -g
PUID=1000
PGID=1000

# --- Database -------------------------------------------------------- [app] --
DB_NAME=bookstack
DB_USER=bookstack
# openssl rand -base64 32 | tr -d '\n'
DB_PASSWORD=
# openssl rand -base64 32 | tr -d '\n'
DB_ROOT_PASSWORD=

# --- BookStack App Key ----------------------------------------------- [app] --
# docker run --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:version-v26.09.3 appkey
APP_KEY=

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
