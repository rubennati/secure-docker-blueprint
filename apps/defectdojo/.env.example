# =============================================================================
# DefectDojo – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=defectdojo


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=defectdojo.example.com

# TLS profile — see docs/standards/traefik-security.md.
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it.
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# A database of unfixed vulnerabilities is a list of ways in. VPN-only by
# default. Scanners that import over the API have to reach it too.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply — see docs/standards/traefik-security.md.
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — empty by default: no CrowdSec bouncer on this router.
# See core/crowdsec/docs/profiles.md to enable one; keep the trailing comma.
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# DefectDojo django and nginx images move together
# (https://github.com/DefectDojo/django-DefectDojo)
APP_TAG=3.3.100
# PostgreSQL and Valkey — the lines upstream's compose pins
DB_TAG=18.6-alpine
VALKEY_TAG=9.1.2-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-nginx
CONTAINER_NAME_UWSGI=${COMPOSE_PROJECT_NAME}-uwsgi
CONTAINER_NAME_WORKER=${COMPOSE_PROJECT_NAME}-celeryworker
CONTAINER_NAME_BEAT=${COMPOSE_PROJECT_NAME}-celerybeat
CONTAINER_NAME_INIT=${COMPOSE_PROJECT_NAME}-initializer
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_VALKEY=${COMPOSE_PROJECT_NAME}-valkey


# --- Database -------------------------------------------------------- [db] --
# ops/init.sh builds the connection URL from these; change them before it runs.
DB_NAME=defectdojo
DB_USER=defectdojo


# --- Application ----------------------------------------------------- [app] --
# The first administrator, created by the initializer on an empty database.
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com

TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the files:
#
#   ops/init.sh
#
# PostgreSQL and Valkey passwords, the three connection URLs that embed them,
# Django's secret key, the key that encrypts stored tool credentials, and the
# first administrator's password. Back up dd_credential_aes_256_key.txt: stored
# integration credentials are unreadable without it.
