# =============================================
# Vaultwarden – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# SECURITY: This is a password manager.
# Use tls-strict (TLS 1.3), strong admin token,
# and disable signups after creating your accounts.
# =============================================

COMPOSE_PROJECT_NAME=vaultwarden

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=vault.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# TLS: the deployment standard (TLS_DEFAULT_OPTION in core/traefik/.env) serves
# every router that names no option. This stack names one — a documented
# exception, kept from before the model:
# tls-strict (TLS 1.3 only) — recommended for a password manager.
APP_TRAEFIK_TLS_OPTION=tls-strict
APP_TRAEFIK_ACCESS=access-vpn
# limit-standard. Headers, measured 2026-10-18: Vaultwarden sends nosniff,
# SAMEORIGIN, a same-origin referrer policy, a 23-directive Permissions-Policy
# and a CSP. The proxy adds the HSTS base and nothing else, so Vaultwarden's
# per-route frame header reaches the browser — SAMEORIGIN on the vault, absent
# on the 2FA connector pages its admin diagnostics need.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-application-owned
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# vaultwarden (https://hub.docker.com/r/vaultwarden/server)
APP_TAG=1.37.3
# mariadb (https://hub.docker.com/_/mariadb)
DB_TAG=11.4

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db

# --- Database ---
DB_NAME=vaultwarden
DB_USER=vw_user

# --- Vaultwarden ---
# Set to true for initial account creation, then set to false
VW_SIGNUPS_ALLOWED=false
# Allow existing users/admins to invite new users (even when signups=false)
VW_INVITATIONS_ALLOWED=false
VW_LOG_LEVEL=warn

# --- Push Notifications (optional — improves mobile/extension real-time sync) ---
# Push is not required for login, SMTP, invites, 2FA, or manual sync.
# Register free at https://bitwarden.com/host/ to get an Installation ID and Key.
# Only works with official Bitwarden apps (App Store / Google Play, not F-Droid).
#
# Global host (default): leave PUSH_RELAY_URI and PUSH_IDENTITY_URI empty.
# EU host: set both URIs below. Using EU credentials without EU URIs causes
# "Unexpected push token received from bitwarden server: error decoding response body".
VW_PUSH_ENABLED=false
VW_PUSH_INSTALLATION_ID=
VW_PUSH_INSTALLATION_KEY=
# Leave empty for global host. For EU host:
#   VW_PUSH_RELAY_URI=https://api.bitwarden.eu
#   VW_PUSH_IDENTITY_URI=https://identity.bitwarden.eu
VW_PUSH_RELAY_URI=
VW_PUSH_IDENTITY_URI=

# --- SMTP (required for 2FA recovery, invitations, etc.) ---
# VW_SMTP_FROM must be a plain email address — no display name, no angle brackets.
# VW_SMTP_FROM_NAME is the display name shown to recipients.
# Brevo: VW_SMTP_USERNAME = SMTP login (not email); VW_SMTP_PASSWORD = SMTP key (not API key).
# Port 587 + starttls is the recommended default.
VW_SMTP_HOST=
VW_SMTP_FROM=vault@example.com
VW_SMTP_FROM_NAME=Vaultwarden
VW_SMTP_PORT=587
VW_SMTP_SECURITY=starttls
VW_SMTP_USERNAME=
VW_SMTP_PASSWORD=

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Passwords & Keys ---
# Generate DB passwords (hex only — no special chars that break DATABASE_URL):
#   openssl rand -hex 32
#
# Or replace in-place:
#   sed -i "s|^DB_PASSWORD=.*|DB_PASSWORD=$(openssl rand -hex 32)|" .env
#   sed -i "s|^DB_ROOT_PASSWORD=.*|DB_ROOT_PASSWORD=$(openssl rand -hex 32)|" .env
DB_PASSWORD=__REPLACE_ME__
DB_ROOT_PASSWORD=__REPLACE_ME__

# Admin token — MUST be Argon2 hash, NOT plain text!
# Generate with:
#   docker run --rm -it vaultwarden/server:1.37.0 /vaultwarden hash
# Enter a strong password when prompted.
# Copy the $argon2id$... output below.
# IMPORTANT: In .env files, replace every $ with $$ (double dollar)
# Example: $$argon2id$$v=19$$m=65540,t=3,p=4$$...
VW_ADMIN_TOKEN=__REPLACE_ME__
