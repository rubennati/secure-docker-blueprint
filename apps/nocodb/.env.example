# =============================================
# NocoDB – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=nocodb

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=nocodb.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_ACCESS=access-vpn
# limit-standard: NocoDB is a code-split SPA — it loads 100+ JS chunks in
# parallel on first visit. The burst of 500 absorbs the surge without 429.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file
# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge

# --- Images ---
# nocodb (https://hub.docker.com/r/nocodb/nocodb)
APP_TAG=2026.09.0

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- App Configuration ---
# Super-admin account created on first start (bypasses email verification).
# Password requirements: min 8 chars, uppercase letter, number, special char.
# Example: MyPass1! — use a real strong password, not this placeholder.
NC_ADMIN_EMAIL=admin@example.com
NC_ADMIN_PASSWORD=

# Signup policy:
# "true"  = only users invited by an admin can sign up (recommended)
# "false" = anyone who reaches the URL can create an account
NC_INVITE_ONLY_SIGNUP=true

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# Generate JWT secret:
#   mkdir -p .secrets
#   openssl rand -base64 32 | tr -d '\n' > .secrets/nc_jwt_secret.txt
