# LibrePhotos — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=2026w25
DB_TAG=16-bookworm

# --- Database -------------------------------------------------------- [app] --
DB_NAME=librephotos
DB_USER=librephotos
#   openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__

# --- Admin bootstrap ------------------------------------------------- [app] --
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__REPLACE_ME__

# --- App Configuration ----------------------------------------------- [app] --
#   openssl rand -base64 48 | tr -d '\n'
SECRET_KEY=__REPLACE_ME__

# --- Storage --------------------------------------------------------- [app] --
SCAN_DIRECTORY=./volumes/local/pictures

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
