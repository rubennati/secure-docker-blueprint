# =============================================================================
# Open WebUI – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=open-webui


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=chat.example.com

# TLS profile — see docs/standards/traefik-security.md.
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it.
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=acc-private

# WHAT headers / rate limit apply — see docs/standards/traefik-security.md.
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — empty by default: no CrowdSec bouncer on this router.
# See core/crowdsec/docs/profiles.md to enable one; keep the trailing comma.
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# Open WebUI (https://github.com/open-webui/open-webui)
APP_TAG=v0.11.3


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- Application ----------------------------------------------------- [app] --
# The initial administrator, created on the first start of an empty database.
ADMIN_EMAIL=admin@example.com

# An OpenAI-compatible endpoint the container can reach — LiteLLM, vLLM, Ollama's
# /v1, agentgateway or a hosted provider. Any one; none is required by this stack.
BACKEND_URL=http://ollama:11434/v1

# 0 = download the embedding model from Hugging Face on first start.
# Set to 1 afterwards: the model is cached in volumes/data and no request leaves.
HF_HUB_OFFLINE=0

# Owner of volumes/data (chown it to this uid:gid).
WEBUI_UID=1000
WEBUI_GID=1000

TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the files:
#
#   ops/init.sh
#
#   .secrets/webui_secret_key.txt       signs sessions
#   .secrets/webui_admin_password.txt   initial administrator password
#   .secrets/openai_api_key.txt         key for BACKEND_URL ("none" if it needs none)
