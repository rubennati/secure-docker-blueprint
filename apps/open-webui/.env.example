# =============================================================================
# Open WebUI – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=open-webui


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=chat.example.com


# WHO may reach it.
#   access-public   everyone
#   access-trusted  the ranges TRUSTED_RANGES declares in core/traefik/.env; empty: nobody
#   access-vpn      VPN only
#   access-trusted-vpn  those ranges + VPN
#   access-blocked  nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=access-trusted-vpn

# limit-standard: the web app requests over 200 files at once on its first load;
# the standard bucket of 500 holds them.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file


# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge


# --- Images -------------------------------------------------------- [image] --
# Open WebUI (https://github.com/open-webui/open-webui)
APP_TAG=v0.11.3


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- Application ----------------------------------------------------- [app] --
# The initial administrator, created on the first start of an empty database.
ADMIN_EMAIL=admin@example.com

# An OpenAI-compatible endpoint the container can reach — LiteLLM, vLLM, Ollama's
# /v1, agentgateway or a hosted provider. Any one; none is required by this stack.
BACKEND_URL=http://ollama:11434/v1

# 0 = download the embedding model from Hugging Face on first start.
# Set to 1 afterwards: the model is cached in volumes/data and no request leaves.
HF_HUB_OFFLINE=0

# Owner of volumes/data (chown it to this uid:gid).
WEBUI_UID=1000
WEBUI_GID=1000

TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the files:
#
#   ops/init.sh
#
#   .secrets/webui_secret_key.txt       signs sessions
#   .secrets/webui_admin_password.txt   initial administrator password
#   .secrets/openai_api_key.txt         key for BACKEND_URL ("none" if it needs none)
