# =============================================================================
# obot – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=obot


# --- Domain & Traefik ------------------------------------------- [traefik] --
# obot builds its redirect URLs from this, so it has to be the address browsers
# actually use.
APP_TRAEFIK_HOST=obot.example.com

APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# **Do not open this one.** obot can create containers on this host, which is
# root-equivalent — see README, "The deviation this stack carries". VPN-only is
# the floor, not a starting point to relax.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
APP_TRAEFIK_SECURITY=sec-2

APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# obot (https://github.com/obot-platform/obot)
APP_TAG=v0.26.0

# PostgreSQL — replaces the one the obot image bundles.
DB_TAG=18.6-alpine

# The filtered Docker API in front of obot.
SOCKET_PROXY_TAG=v0.5.0


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_SOCKET_PROXY=${COMPOSE_PROJECT_NAME}-socket-proxy


# --- App Configuration ----------------------------------------------- [app] --
# The uid obot runs as. The image declares root and does not need it; ./volumes/data
# has to belong to this uid before the first start.
APP_UID=1000
APP_GID=1000


# --- Database --------------------------------------------------------- [db] --
# These two also appear inside .secrets/obot_server_dsn.txt, which is what obot
# reads. ops/init.sh writes both from one password.
DB_NAME=obot
DB_USER=obot


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
#
# `ops/init.sh` creates all three and the volume directories. By hand:
#
#   mkdir -p .secrets
#   PW="$(openssl rand -hex 24)"
#   printf '%s' "$PW" > .secrets/db_pwd.txt
#   printf 'postgresql://obot:%s@obot-db:5432/obot' "$PW" > .secrets/obot_server_dsn.txt
#   openssl rand -hex 24 | tr -d '\n' > .secrets/obot_bootstrap_token.txt
#   chmod 644 .secrets/*.txt && chmod 700 .secrets
#
# OBOT_SERVER_DSN does two jobs: it points obot at the PostgreSQL beside it, and
# setting it is what stops the image starting the PostgreSQL it bundles — whose
# user and password are `obot`/`obot`, baked into the image.
#
# OBOT_BOOTSTRAP_TOKEN is the first sign-in. Leave it unset and obot generates
# one and prints it into the container log, where it stays.
