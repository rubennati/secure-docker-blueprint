# obot — local env
#   cp .env.local.example .env.local
#
# "Local" here means not routed. The socket proxy and its consequence are the
# same as in the production file — see README, "The deviation this stack
# carries".

APP_TAG=v0.26.0
DB_TAG=18.6-alpine
SOCKET_PROXY_TAG=v0.5.0
DB_NAME=obot
DB_USER=obot
APP_UID=1000
APP_GID=1000
TZ=UTC
