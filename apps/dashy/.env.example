# =============================================
# Dashy – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=dashy

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=dashy.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# Personal dashboard — VPN-only default
APP_TRAEFIK_ACCESS=access-vpn

# HTTP basic auth in front of the router — `user:hash`, several separated by
# commas: the gate before an application that has no login of its own
# (DEC-077). Every `$` in the hash is doubled, or Compose expands `$apr1` as a
# variable; the command does the doubling — paste the whole line:
#   htpasswd -nbB ops 'the-password' | sed -e 's/\$/\$\$/g'
# The hash lives in this gitignored file because a Traefik middleware reads its
# users from the label (docs/standards/secrets.md, Pattern 3).
APP_BASIC_AUTH_USERS=ops:$$apr1$$REPLACE$$WITH_A_REAL_HASH
# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: basic — Dashy's own auth is client-side only; the basicAuth gate from APP_BASIC_AUTH_USERS
APP_TRAEFIK_AUTH=${COMPOSE_PROJECT_NAME}-auth@docker
# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge

# --- Images ---
# dashy (https://hub.docker.com/r/lissy93/dashy)
APP_TAG=4.8.7

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Timezone ---
TZ=UTC
