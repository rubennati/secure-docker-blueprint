# =============================================================================
# HeyForm – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================
#
#   [compose]  Docker Compose itself — project and container names
#   [traefik]  the reverse proxy — hostname, TLS, access, security chain
#   [image]    which image version gets pulled
#   [app]      the application's own settings
#   [secrets]  documented here, values live in .secrets/ — never in this file
#
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
# Drives the container names and the Traefik router name.
COMPOSE_PROJECT_NAME=heyform


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The host name the instance is reached at. It also becomes APP_HOMEPAGE_URL,
# from which HeyForm derives three things: the session cookie's Domain, the
# allowed CORS origin, and every absolute link in an outgoing e-mail. Set it to
# anything but the real host name and sign-in succeeds while the browser drops
# the cookie, which looks like a wrong password.
APP_TRAEFIK_HOST=heyform.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
#   cloudflare-dns  DNS-01 — wildcards, no port 80 needed
#   httpResolver    HTTP-01 — no DNS provider needed
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS profile:
#   tls-basic   TLS 1.2+ — broad client compatibility
#   tls-aplus   TLS 1.2+ strict cipher set — the default for public apps
#   tls-modern  TLS 1.3 only — modern clients only
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# VPN-only, which is the whole instance: the form builder, the submissions
# already collected, and the pages respondents fill in. HeyForm serves all of
# them from one port and one GraphQL endpoint, so there is no path split that
# publishes the forms and keeps the rest private.
#
# Forms meant for people outside the VPN therefore need acc-public on this
# router — a deliberate change, with consequences worth reading first. See
# README, "Publishing forms to the outside".
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
#   sec-2           standard default for a new app
#   sec-3           public-facing and hardened
#   *e suffix       iframe-friendly (embedded apps)
#   *-spa suffix    high burst rate limit — documented for VPN-gated apps only
#
# Not measured against this application, which is a React front end that loads
# its assets in one burst — see README, "Known limits".
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — the third axis, independent of the two above.
# Empty by default: no CrowdSec bouncer on this router.
#
# To enable, name a profile from core/crowdsec/docs/profiles.md and keep the
# trailing comma — the value is prepended to the middleware list, and it has to
# come first so a banned address is rejected before anything else does work on
# the request. The @file is part of the value:
#   APP_TRAEFIK_THREAT=crowdsec-basic@file,
APP_TRAEFIK_THREAT=

# Shared proxy network, created by core/traefik. Same value in every app.
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# App image → pin major.minor.patch. Never :latest, never major-only.
# heyform (https://github.com/heyform/heyform)
# Upstream's own compose uses `:latest`, which also moves on release
# candidates.
APP_TAG=v3.0.3

# MongoDB. Upstream pins percona/percona-server-mongodb:4.4, whose newest
# image is from 2024-04. Verified against 8.0 here — see UPSTREAM.md.
DB_TAG=8.0.32

# Valkey. Upstream pins eqalpha/keydb:latest, last released 2023-10, run with
# protected mode off. Verified against Valkey 8 here — see UPSTREAM.md.
CACHE_TAG=8.1.4-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_CACHE=${COMPOSE_PROJECT_NAME}-cache


# --- Database --------------------------------------------------------- [db] --
# These two also appear inside .secrets/mongo_uri.txt, which is what the
# application reads. ops/init.sh writes both from one password.
DB_ROOT_USER=heyform
DB_NAME=heyform


# --- App Configuration ----------------------------------------------- [app] --
# Who may create an account.
#
#   true   closed — the sign-up page is gone. Accounts arrive by workspace
#          invitation, which still works with this on.
#   false  open — anyone who can reach the host name can create an account.
#
# Upstream's default is false. Closed here, because the first thing a
# reachable instance would otherwise do is hand an account to whoever asks.
# The first account has to be created with this briefly set to true — see
# README, "Setup".
APP_DISABLE_REGISTRATION=true

# Loads the form editor's fonts from Google, for whoever fills in a form as
# much as for whoever builds it. Upstream defaults this to true; off here, and
# the bundled fonts are used instead.
APP_ENABLE_GOOGLE_FONTS=false

# Whether a new account must confirm its e-mail address before signing in.
# Needs working SMTP below — with none, the code is generated and never
# arrives, and the account cannot be used. Turn it on together with mail.
APP_VERIFY_USER_EMAIL=false

# How many proxies sit in front of this container, counted from the
# application outwards. 1 = Traefik alone, which is this stack. Raise it only
# if you put something else in front of Traefik, and only by what you actually
# added: the value decides which entry in X-Forwarded-For is believed to be
# the client, and too high a number believes a header the client wrote.
APP_TRUST_PROXY=1

# Largest single upload a form may accept, as a size string. Upstream's
# default is 10mb. Files land in volumes/upload and are served back from
# there, so this is also what a form can be used to store.
APP_UPLOAD_FILE_SIZE=10mb

# How long a signed-in session stays valid, as a duration string (`15d`, `24h`).
# Upstream's default is 15d.
APP_SESSION_MAX_AGE=15d


# --- SMTP ------------------------------------------------------------ [app] --
# Outgoing mail: workspace invitations, password resets, e-mail verification
# and the alert sent when an account signs in from an unfamiliar device.
#
# Leave SMTP_HOST empty and none of them are sent. The instance still works —
# see README, "Without SMTP", for what that costs and which parts stop.
SMTP_FROM=heyform@example.com
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on 465; false for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=


# --- Timezone -------------------------------------------------------- [app] --
# Examples: UTC, Europe/Vienna, Europe/Berlin
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
#
# HeyForm reads every setting from the environment and has no _FILE variant,
# so config/entrypoint.sh exports these before the image's own entrypoint runs.
#
# `ops/init.sh` creates all six and the data directories, and refuses to
# overwrite anything that exists. By hand:
#
#   mkdir -p .secrets
#   PW="$(openssl rand -hex 24)"
#   printf '%s' "$PW" > .secrets/db_root_pwd.txt
#   printf 'mongodb://heyform:%s@heyform-db:27017/heyform?authSource=admin' \
#       "$PW" > .secrets/mongo_uri.txt
#   openssl rand -hex 24 | tr -d '\n' > .secrets/cache_pwd.txt
#   openssl rand -hex 32 | tr -d '\n' > .secrets/session_key.txt
#   openssl rand -hex 32 | tr -d '\n' > .secrets/form_encryption_key.txt
#   : > .secrets/smtp_pwd.txt
#   chmod 644 .secrets/*.txt && chmod 700 .secrets
#
# `authSource=admin` because MONGO_INITDB_ROOT_* creates the user in the admin
# database, not in the application one.
#
# Hex throughout: the password goes into a MongoDB URL and onto Valkey's
# command line, and hex has no character either of them would have to escape.
#
# SESSION_KEY signs the session cookie. Changing it signs everyone out.
#
# FORM_ENCRYPTION_KEY encrypts form-level passwords and the hidden-field
# payloads carried in a form URL. Changing it after forms exist makes those
# unreadable — there is no re-encryption step.
#
# smtp_pwd.txt is created empty. An instance without mail has no password to
# put in it, and the empty file is what keeps the mount from failing.
