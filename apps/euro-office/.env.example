# =============================================
# Euro-Office Document Server – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================
#
# EU-governed fork of OnlyOffice (Nextcloud, IONOS, XWiki, Proton).
# Drop-in replacement for OnlyOffice Document Server — in-browser editing
# of docx/xlsx/pptx for Seafile, Nextcloud, or any WOPI-compatible app.
#
# After setup, each consuming app connects to:
#   https://<APP_TRAEFIK_HOST>/web-apps/apps/api/documents/api.js
# and authenticates with the JWT secret in ./.secrets/jwt_secret.txt
# =============================================

COMPOSE_PROJECT_NAME=euro-office

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=office.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# Access: access-public, access-trusted, access-vpn, access-trusted-vpn, access-blocked
APP_TRAEFIK_ACCESS=access-public
# limit-none: the server is called by the office client in the browser and by
# the file host, and has not been measured against a counter — none, as before
# the model. Headers: the proxy sets what this stack set before the model —
# nosniff and the frame-ancestors CSP (both named in docker-compose.yml) over
# the HSTS base; which headers the server sends itself is not measured.
APP_TRAEFIK_LIMIT=limit-none
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-application-owned
# auth posture: public — a document server; the embedding application authorises with the shared JWT secret, there is no user login
APP_TRAEFIK_AUTH=auth-none@file
# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge

# --- Images ---
# ghcr.io/euro-office/documentserver (https://github.com/euro-office/DocumentServer)
APP_TAG=v9.3.4-hotfix.1

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Integration ---
# Domains allowed to embed Euro-Office in an iframe (CSP frame-ancestors).
# Space-separated, each with https:// prefix.
EURO_OFFICE_ALLOWED_ORIGINS=https://files.example.com https://cloud.example.com

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna
TZ=UTC

# --- Secrets ---
# Create the secrets directory and generate the JWT secret:
#   mkdir -p .secrets
#   openssl rand -base64 30 | tr -d '\n' > .secrets/jwt_secret.txt
#
# Each consuming app (Seafile, Nextcloud, …) needs the same secret.
