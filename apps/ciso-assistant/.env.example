# =============================================================================
# CISO Assistant – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=ciso-assistant


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=grc.example.com


# WHO may reach it.
#   access-public   everyone
#   access-trusted  the ranges TRUSTED_RANGES declares in core/traefik/.env; empty: nobody
#   access-vpn      VPN only
#   access-trusted-vpn  those ranges + VPN
#   access-blocked  nobody — the emergency kill switch
#
# A register of an organisation's risks, gaps and controls is a map of where it
# is weak. VPN-only by default.
APP_TRAEFIK_ACCESS=access-vpn

# limit-standard: the interface's first load requests about 80 script chunks and
# assets; a burst of 50 answered 14 of them 429. The standard bucket of 500
# holds them.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file


TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# CISO Assistant backend and frontend (https://github.com/intuitem/ciso-assistant-community)
APP_TAG=v4.0.9
# PostgreSQL — upstream's template runs the 16 line
DB_TAG=16.14


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_BACKEND=${COMPOSE_PROJECT_NAME}-backend
CONTAINER_NAME_WORKER=${COMPOSE_PROJECT_NAME}-huey
CONTAINER_NAME_FRONTEND=${COMPOSE_PROJECT_NAME}-frontend
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db


# --- Database -------------------------------------------------------- [db] --
DB_NAME=ciso_assistant
DB_USER=ciso_assistant


# --- Application ----------------------------------------------------- [app] --
# The first administrator, created on the first start of an empty database.
ADMIN_EMAIL=admin@example.com

TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the files:
#
#   ops/init.sh
#
#   .secrets/db_pwd.txt              PostgreSQL
#   .secrets/django_secret_key.txt   signs sessions and tokens
#   .secrets/admin_pwd.txt           first administrator's password
