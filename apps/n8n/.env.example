# =============================================
# n8n – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=n8n

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=n8n.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_ACCESS=access-vpn
# limit-standard: n8n is a code-split SPA — it loads many JS/CSS assets in
# parallel on first visit. The burst of 500 absorbs the surge without 429.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# n8n (https://hub.docker.com/r/n8nio/n8n) — pinned by the digest of the
# multi-arch index (linux/amd64, linux/arm64), so the image is the same on
# every host and in the scan.
APP_TAG=2.41.7@sha256:bcef56dd44014e09774219536a3f8cb07f1b553fcba94044bd9fc0f21f8676a3

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# Encryption key for stored credentials (OAuth tokens, API keys).
# CRITICAL: generate once, never rotate — changing it invalidates all stored credentials.
#   mkdir -p .secrets
#   openssl rand -hex 32 | tr -d '\n' > .secrets/n8n_encryption_key.txt
