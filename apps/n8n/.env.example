# =============================================
# n8n – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=n8n

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=n8n.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
APP_TRAEFIK_ACCESS=acc-tailscale
# sec-3-spa: n8n is a code-split SPA — it loads many JS/CSS assets in parallel
# on first visit. rl-spa (burst: 500) absorbs the initial surge without 429
# errors. Safe here because the app is VPN-only (acc-tailscale).
APP_TRAEFIK_SECURITY=sec-3-spa
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# n8n (https://hub.docker.com/r/n8nio/n8n) — pinned by the digest of the
# multi-arch index (linux/amd64, linux/arm64), so the image is the same on
# every host and in the scan.
APP_TAG=2.38.7@sha256:a8c95f75c6fdf65f5f2b7a7b354744eaa1c62bb911b5c00af6499c3f38e4cd32

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# Encryption key for stored credentials (OAuth tokens, API keys).
# CRITICAL: generate once, never rotate — changing it invalidates all stored credentials.
#   mkdir -p .secrets
#   openssl rand -hex 32 | tr -d '\n' > .secrets/n8n_encryption_key.txt
