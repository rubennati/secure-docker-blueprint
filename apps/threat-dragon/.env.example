# =============================================================================
# OWASP Threat Dragon – Environment
# =============================================================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================================================

COMPOSE_PROJECT_NAME=threat-dragon

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=threatdragon.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
APP_TRAEFIK_ACCESS=acc-tailscale
APP_TRAEFIK_SECURITY=sec-3
APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# threat-dragon (https://hub.docker.com/r/owasp/threat-dragon)
APP_TAG=v2.6.2

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Timezone ---
TZ=UTC

# --- Optional: Git-provider OAuth ---
# Without any of these, Threat Dragon still runs — models are stored in the
# browser's own local storage, no server-side account needed. Add ONE
# provider's variables to docker-compose.yml's `environment:` block (with
# secrets for the *_CLIENT_SECRET values, following the same _FILE pattern
# already used below) if you want threat models stored in a real Git
# repository instead. See UPSTREAM.md for exact variable names per provider.

# --- Secrets ---
# Create the secrets directory:
#   mkdir -p .secrets
#
# A JSON array of encryption keys — Threat Dragon's own required format.
# "isPrimary": true marks which key is used to encrypt going forward; keep
# older keys in the array (isPrimary: false) so previously-encrypted data
# stays readable after a rotation:
#   KEY_ID=$(openssl rand -hex 4)
#   KEY_VALUE=$(openssl rand -hex 32)
#   printf '[{"isPrimary": true, "id": "%s", "value": "%s"}]' "$KEY_ID" "$KEY_VALUE" \
#     > .secrets/encryption_keys.txt
#
# Session-signing keys:
#   openssl rand -base64 48 | tr -d '\n' > .secrets/jwt_signing_key.txt
#   openssl rand -base64 48 | tr -d '\n' > .secrets/jwt_refresh_signing_key.txt
