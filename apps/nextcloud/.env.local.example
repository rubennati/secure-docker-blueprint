# Nextcloud — local
#
#   cp .env.local.example .env.local

# --- Images ---
APP_TAG=34.0.2-fpm-alpine
DB_TAG=11.8
REDIS_TAG=7.4-alpine
NGINX_TAG=1.29-alpine-slim

# --- Database ---
DB_NAME=nextcloud
DB_USER=nextcloud
# openssl rand -base64 32 | tr -d '\n'
DB_PASSWORD=__REPLACE_ME__
# openssl rand -base64 32 | tr -d '\n'
DB_ROOT_PASSWORD=__REPLACE_ME__

# --- Redis ---
#   openssl rand -hex 32
REDIS_PASSWORD=__REPLACE_ME__

# --- Administrator ---
ADMIN_USER=admin
# openssl rand -base64 24 | tr -d '\n'
ADMIN_PASSWORD=__REPLACE_ME__

# --- PHP ---
PHP_MEMORY_LIMIT=1024M
PHP_UPLOAD_LIMIT=128M

# --- Timezone ---
TZ=UTC
