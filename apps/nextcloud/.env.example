# =============================================
# Nextcloud – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=nextcloud

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=cloud.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# TLS: the deployment standard (TLS_DEFAULT_OPTION in core/traefik/.env) serves
# every router that names no option. This stack names one — a documented
# exception, kept from before the model:
# no reason recorded. Verify on a host whether the standard serves its clients,
# then remove this variable and the tls.options label in docker-compose.yml.
APP_TRAEFIK_TLS_OPTION=tls-compatible
# Who may reach it:
#   access-trusted-vpn  the ranges TRUSTED_RANGES declares (core/traefik/.env) + VPN — the default
#   access-vpn          VPN only
#   access-trusted      the declared ranges only
#   access-public       everyone
#
# No closed policy admits a Docker network. An office server calls Nextcloud
# back over the Docker network the two stacks share, not through this route —
# the connector's internal address settings (README, "Office servers behind a
# closed route"). The instance's own setup checks call its public name and
# report failures while it is closed (README, "Setup checks while access is
# restricted"); they are the policy working. Open the route once the instance is
# configured and you have logged in — Nextcloud has its own login and lockout.
APP_TRAEFIK_ACCESS=access-trusted-vpn
# limit-sync: the desktop client runs up to 20 requests in parallel for as long
# as it has files to move (measured). Headers: headers-standard with frame-self
# before it in docker-compose.yml — Nextcloud requires X-Frame-Options:
# SAMEORIGIN. Which of the other headers it sends itself is not measured yet;
# then it is headers-application-owned plus the blocks it lacks.
APP_TRAEFIK_LIMIT=limit-sync
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# nextcloud fpm-alpine (https://hub.docker.com/_/nextcloud)
APP_TAG=34.0.4-fpm-alpine
# mariadb LTS (https://hub.docker.com/_/mariadb)
DB_TAG=11.8
# redis (https://hub.docker.com/_/redis)
REDIS_TAG=7.4-alpine
# nginx (https://hub.docker.com/_/nginx)
NGINX_TAG=1.29-alpine-slim

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis
CONTAINER_NAME_NGINX=${COMPOSE_PROJECT_NAME}-nginx
CONTAINER_NAME_CRON=${COMPOSE_PROJECT_NAME}-cron

# --- Database ---
DB_NAME=nextcloud
DB_USER=nextcloud

# --- Nextcloud ---
# Every subnet of proxy-public, space-separated. With IPv6 enabled that is two;
# miss one and Nextcloud logs the proxy's address instead of the client's, which
# makes brute-force protection count every user against the same address.
#   docker network inspect proxy-public \
#     --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
NC_TRUSTED_PROXIES=172.19.0.0/16

# --- PHP ---
# PHP_UPLOAD_LIMIT must match client_max_body_size in nginx/nginx.conf.
# Sizing for both values: README, "Tuning rationale".
PHP_MEMORY_LIMIT=1024M
PHP_UPLOAD_LIMIT=128M

# --- SMTP ---
# Required: without it, users cannot reset their password.
#
# MAIL_FROM_ADDRESS is the local part only. The From address is assembled as
# MAIL_FROM_ADDRESS@MAIL_DOMAIN and must be a sender your provider has verified,
# with SPF, DKIM and DMARC in place.
#
# Transport: `ssl` on port 465 wraps the session in TLS from the first byte.
# `tls` on 587 starts in the clear and upgrades, so a network attacker can strip
# the upgrade. Prefer 465. Many hosting providers block outbound 465 and 25 —
# check before assuming, and fall back to 587 only if it is closed:
#
#   for p in 25 465 587; do
#     timeout 5 bash -c "exec 3<>/dev/tcp/smtp.example.com/$p" \
#       && echo "$p open" || echo "$p blocked"
#   done
#
# Set SMTP_PORT explicitly. Left empty it defaults to 465 whenever SMTP_SECURE
# is set, which silently contradicts a `tls` transport.
#
# Reference: https://github.com/nextcloud/docker#auto-configuration-via-environment-variables
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTHTYPE=LOGIN
SMTP_NAME=your-smtp-login
MAIL_FROM_ADDRESS=nextcloud
MAIL_DOMAIN=example.com

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# Create all six files before the first start. Nextcloud installs itself from
# them; there is no setup wizard.
#
#   mkdir -p .secrets
#   openssl rand -base64 32 | tr -d '\n' > .secrets/db_pwd.txt
#   openssl rand -base64 32 | tr -d '\n' > .secrets/db_root_pwd.txt
#   openssl rand -hex 32    | tr -d '\n' > .secrets/redis_pwd.txt
#   printf 'admin'                        > .secrets/admin_user.txt
#   openssl rand -base64 24 | tr -d '\n' > .secrets/admin_pwd.txt
#   printf 'your-smtp-key'                > .secrets/smtp_pwd.txt
#   chmod 600 .secrets/*.txt
#
# The Redis password must be hex, not base64: `+/=` break URL encoding in PHP's
# Redis session handler.
#
# redis_pwd.txt and smtp_pwd.txt are read at PHP runtime and must be readable by
# the web user. Give them to that group rather than that user, so you can still
# edit them when a key is rotated:
#
#   sudo chown "$USER":82 .secrets/redis_pwd.txt .secrets/smtp_pwd.txt
#   chmod 640 .secrets/redis_pwd.txt .secrets/smtp_pwd.txt
#
# 82 is www-data in the Alpine images, 33 in the Debian ones. Confirm with:
#   docker compose exec -u root app id www-data
#
# Without this, occ fails with NOAUTH and mail silently does not send, while the
# container still reports healthy.
#
# Rotating a key: most editors save by writing a new file and renaming it over
# the old one. The container's mount still points at the replaced file, so it
# keeps reading the previous value. Recreate rather than restart:
#
#   docker compose up -d --force-recreate app cron
#
# Appending in place (`printf '%s' "$KEY" > .secrets/smtp_pwd.txt`) keeps the
# same file and needs no recreate.
#
# Reference: https://github.com/nextcloud/docker#docker-secrets
#
# The administrator password is generated, not shown. Read it once and store it:
#   cat .secrets/admin_pwd.txt
#
# Keep `tr -d '\n'` — a trailing newline breaks authentication.
#
# The `-apache` image is a supported alternative to fpm-alpine + nginx.
# Switching: UPSTREAM.md, "Fallback: Apache variant".
