# =============================================
# Nextcloud – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=nextcloud

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=cloud.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-basic
# NOTE: If using OnlyOffice integration, Nextcloud must be acc-public
# because OnlyOffice calls back to Nextcloud via the public domain.
# acc-tailscale would block this callback.
# Who may reach it:
#   acc-private    LAN + VPN — the default
#   acc-tailscale  VPN only
#   acc-local      LAN only
#   acc-public     everyone
#
# acc-private also covers the Docker gateway, so the instance can reach itself
# through the proxy — its own setup checks need that. acc-tailscale cannot.
#
# Switch to acc-public once the instance is configured and you have logged in.
# An office server (OnlyOffice, Euro-Office) calls back over the public domain
# and requires acc-public.
APP_TRAEFIK_ACCESS=acc-private
# sec-3-spa is preferred over sec-3 for Nextcloud.
# Nextcloud generates significant legitimate background traffic:
# OCS API, WebDAV, PROPFIND, sync clients, activity polling, notifications.
# sec-3 (rl-soft) can return 429 for this traffic under normal load.
# sec-3-spa uses rl-spa which allows the initial burst while still applying
# strict security headers and permissions-policy.
APP_TRAEFIK_SECURITY=sec-3-spa
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# nextcloud fpm-alpine (https://hub.docker.com/_/nextcloud)
APP_TAG=34.0.2-fpm-alpine
# mariadb LTS (https://hub.docker.com/_/mariadb)
DB_TAG=10.11
# redis (https://hub.docker.com/_/redis)
REDIS_TAG=7.4-alpine
# nginx (https://hub.docker.com/_/nginx)
NGINX_TAG=1.29-alpine-slim

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis
CONTAINER_NAME_NGINX=${COMPOSE_PROJECT_NAME}-nginx
CONTAINER_NAME_CRON=${COMPOSE_PROJECT_NAME}-cron

# --- Database ---
DB_NAME=nextcloud
DB_USER=nextcloud

# --- Nextcloud ---
# Trusted proxy: Docker subnet of proxy-public network
# Find with: docker network inspect proxy-public --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
NC_TRUSTED_PROXIES=172.19.0.0/16

# PHP tuning
#
# PHP_MEMORY_LIMIT — kept at 1024M intentionally.
# Nextcloud rarely exceeds 256M per request in normal operation.
# 1024M provides generous headroom for preview generation and
# full-text indexing without allowing runaway requests to exhaust RAM.
# Do not increase to 2048M unless there is measured evidence of need.
PHP_MEMORY_LIMIT=1024M
#
# PHP_UPLOAD_LIMIT — kept at 128M intentionally.
# This stack is a small business collaboration server, not a large
# file storage platform. 128M covers all normal document workflows.
# Raising this limit increases attack surface and memory pressure
# during uploads. Increase only when a specific business requirement
# is documented.
PHP_UPLOAD_LIMIT=128M

# Redis password (used in compose command, not a secret file —
# Redis --requirepass flag needs the value directly)
# IMPORTANT: Use hex, NOT base64 — base64 contains +/= which break
# PHP's Redis session handler URL encoding
# Generate with: openssl rand -hex 32
# Redis password: .secrets/redis_pwd.txt

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# Create all five files before the first start. Nextcloud installs itself from
# them; there is no setup wizard.
#
#   mkdir -p .secrets
#   openssl rand -base64 32 | tr -d '\n' > .secrets/db_pwd.txt
#   openssl rand -base64 32 | tr -d '\n' > .secrets/db_root_pwd.txt
#   openssl rand -hex 32    | tr -d '\n' > .secrets/redis_pwd.txt
#   printf 'admin'                        > .secrets/admin_user.txt
#   openssl rand -base64 24 | tr -d '\n' > .secrets/admin_pwd.txt
#   chmod 600 .secrets/*.txt
#
# redis_pwd.txt must be readable by the web user, or every occ command fails
# with NOAUTH while the container still reports healthy:
#
#   sudo chown 82:82 .secrets/redis_pwd.txt
#
# 82 is www-data in the Alpine images, 33 in the Debian ones. Confirm with:
#   docker compose exec -u root app id www-data
#
# Reference: https://github.com/nextcloud/docker#docker-secrets
#
# The administrator password is generated, not shown. Read it once and store it:
#   cat .secrets/admin_pwd.txt
#
# Keep `tr -d '\n'` — a trailing newline breaks authentication.
#
# FALLBACK: If fpm-alpine causes issues, switch to apache variant:
#   APP_TAG=32.0.13-apache
#   Remove the nginx service and mount nginx/nginx.conf
#   Move Traefik labels to the app service, port 80
