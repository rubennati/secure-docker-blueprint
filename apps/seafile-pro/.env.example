# =============================================
# Seafile Pro – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=seafile-pro

# --- Compose Files ---
# Add/remove optional components here:
#   seasearch.yml           – Full-text search (recommended, lightweight)
#   seadoc.yml              – Collaborative document editing
#   notification-server.yml – Real-time file change notifications
#   md-server.yml           – File metadata management
#   thumbnail-server.yml    – Image/video thumbnail generation
#   clamav.yml              – Antivirus scanning (optional)
#   seafile-ai.yml          – AI features (optional, configure separately)
#
# NOTE: For Elasticsearch instead of SeaSearch, see UPSTREAM.md
#   clamav.yml              – Antivirus scanning (recommended for production)
COMPOSE_FILE=seafile-server.yml,seadoc.yml,notification-server.yml,md-server.yml,thumbnail-server.yml,seasearch.yml,clamav.yml
COMPOSE_PATH_SEPARATOR=,

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=files.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
# acc-private (LAN + VPN), not acc-public. Two reasons, and the second is the
# one that bites: a personal file store has no business answering the open
# internet before anyone has verified it, and OnlyOffice and SeaDoc call back
# into Seafile from their own containers — those source addresses are RFC1918,
# which acc-private covers and acc-tailscale does not. apps/nextcloud ships the
# same default for the same reason. Open it deliberately once the instance is
# configured and verified.
APP_TRAEFIK_ACCESS=acc-private
APP_TRAEFIK_SECURITY=sec-2
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# seafile-pro-mc (https://hub.docker.com/r/seafileltd/seafile-pro-mc)
APP_TAG=13.0.21
# mariadb (https://hub.docker.com/_/mariadb)
DB_TAG=10.11
# redis (https://hub.docker.com/_/redis)
REDIS_TAG=7.4-alpine
# sdoc-server (https://hub.docker.com/r/seafileltd/sdoc-server)
SEADOC_TAG=2.0.9
# notification-server (https://hub.docker.com/r/seafileltd/notification-server)
NOTIFICATION_TAG=13.0.10
# seafile-md-server (https://hub.docker.com/r/seafileltd/seafile-md-server)
MD_TAG=13.0.20
# thumbnail-server (https://hub.docker.com/r/seafileltd/thumbnail-server)
THUMBNAIL_TAG=13.0.20
# seasearch (https://hub.docker.com/r/seafileltd/seasearch)
SEASEARCH_TAG=1.0.3
# clamav (https://hub.docker.com/r/clamav/clamav)
CLAMAV_TAG=1.4

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis
CONTAINER_NAME_SEADOC=${COMPOSE_PROJECT_NAME}-seadoc
CONTAINER_NAME_NOTIFICATION=${COMPOSE_PROJECT_NAME}-notification
CONTAINER_NAME_MD_SERVER=${COMPOSE_PROJECT_NAME}-md-server
CONTAINER_NAME_THUMBNAIL=${COMPOSE_PROJECT_NAME}-thumbnail
CONTAINER_NAME_SEASEARCH=${COMPOSE_PROJECT_NAME}-seasearch
CONTAINER_NAME_CLAMAV=${COMPOSE_PROJECT_NAME}-clamav

# --- Network ---
NETWORK_INTERNAL=${COMPOSE_PROJECT_NAME}-internal

# --- Database ---
DB_USER=seafile

# --- Seafile ---
SEAFILE_ADMIN_EMAIL=admin@example.com

# Feature toggles
ENABLE_SEADOC=true
ENABLE_NOTIFICATION_SERVER=true
ENABLE_SEAFILE_AI=false
ENABLE_FACE_RECOGNITION=false

# Storage (disk or s3)
SEAF_SERVER_STORAGE_TYPE=disk
MD_STORAGE_TYPE=disk
SS_STORAGE_TYPE=disk

# --- Database Names ---
# These names are chosen once — before first init. Changing them later requires
# manual database migration, not a simple .env edit.
# SEAHUB_DB_NAME is shared: Seafile writes it, SeaDoc reads it.
# Changing only one side breaks SeaDoc silently.
SEAHUB_DB_NAME=seahub_db

# --- Notification ---
NOTIFICATION_LOG_LEVEL=info

# --- Metadata Server ---
MD_LOG_LEVEL=info
MD_MAX_CACHE_SIZE=1GB
MD_FILE_COUNT_LIMIT=100000

# --- Thumbnail Server ---
THUMBNAIL_SIZE_LIMIT=256

# --- SeaSearch ---
SS_MAX_OBJ_CACHE_SIZE=10GB
SS_LOG_LEVEL=info

# --- SMTP ---
# Leave SEAFILE_SMTP_HOST empty to disable email entirely (share notifications,
# password reset, and invite emails will not work).
# Port 587 (STARTTLS):      SEAFILE_SMTP_USE_TLS=true  (default)
# Port 465 (implicit SSL):  SEAFILE_SMTP_PORT=465 and SEAFILE_SMTP_USE_TLS=false
# Password goes in the Passwords & Keys section below.
# NOTE: Unlike Seafile CE, the SMTP password is stored in .env (not a Docker
# Secret) because Phusion's my_init clears exported environment variables —
# the same limitation that affects all passwords in this stack.
SEAFILE_SMTP_HOST=
SEAFILE_SMTP_PORT=587
SEAFILE_SMTP_USER=
SEAFILE_SMTP_USE_TLS=true
SEAFILE_SMTP_FROM=

# --- OnlyOffice Integration ---
# Hostname only — no https://, no trailing slash.
# The Compose file constructs the full URL: https://${ONLYOFFICE_HOST}
# JWT secret must match the value on your OnlyOffice server exactly.
#
# Network requirements:
#   - Browser/client must reach OnlyOffice directly (loads the editor JS).
#   - OnlyOffice server must reach Seafile's configured hostname (APP_TRAEFIK_HOST)
#     to fetch and save files. The path can be public internet, Tailscale, or any
#     direct route. If DNS for APP_TRAEFIK_HOST resolves to a Tailscale address on
#     the OnlyOffice server, it will route via Tailscale automatically.
#   - On the OnlyOffice server, add the Seafile origin to ONLYOFFICE_ALLOWED_ORIGINS
#     so browsers are permitted to embed the editor in an iframe:
#       ONLYOFFICE_ALLOWED_ORIGINS=https://files.example.com
#     This value is a Traefik label — changes require container recreation
#     (docker compose up -d --force-recreate on the OnlyOffice server), not restart.
#     See core/onlyoffice/.env.example for how this is configured.
#
# Note: APP_TRAEFIK_ACCESS is a Traefik middleware setting, not a network exposure
# setting. acc-public removes the IP allowlist inside Traefik; it does not bypass
# upstream firewall rules. acc-tailscale enforces a source-IP allowlist but may
# fail if Docker bridge masquerades the source IP — see UPSTREAM.md.
ONLYOFFICE_HOST=office.example.com

# --- Timezone ---
TZ=UTC

# --- Passwords & Keys ---
# TODO: Migrate to Docker Secrets when entrypoint wrapper supports my_init.
# For now, passwords are stored in .env (which is in .gitignore).
#
# Generate with:
#   openssl rand -base64 32 | tr -d '\n'   (for passwords)
#   openssl rand -base64 48 | tr -d '\n'   (for JWT — min 32 chars)
#   openssl rand -hex 32                    (for Redis — no +/= chars)
#
# OnlyOffice JWT secret must match core/onlyoffice — copy from there.
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=__REPLACE_ME__
SEAFILE_MYSQL_DB_PASSWORD=__REPLACE_ME__
INIT_SEAFILE_ADMIN_PASSWORD=__REPLACE_ME__
JWT_PRIVATE_KEY=__REPLACE_ME__
REDIS_PASSWORD=__REPLACE_ME__
ONLYOFFICE_JWT_SECRET=__REPLACE_ME__
# SMTP password — leave empty if SMTP is disabled:
SEAFILE_SMTP_PASSWORD=

# IMPORTANT: After the very first start, you MUST restart the app container once:
#   docker compose restart app
# This injects OnlyOffice + Metadata settings into seahub_settings.py.
# Only needed once — survives all future restarts and updates.
