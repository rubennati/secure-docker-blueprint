# =============================================
# Collabora Online (CODE) – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# LibreOffice-based online office server — lightweight alternative to
# OnlyOffice / Euro-Office (~1 GB idle vs ~4 GB). Embedded via WOPI by
# Seafile / Nextcloud. Stateless, single container.
# =============================================

COMPOSE_PROJECT_NAME=collabora

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=office.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# Access: access-public, access-trusted, access-vpn, access-trusted-vpn, access-blocked
APP_TRAEFIK_ACCESS=access-public
# limit-none: the server is called by the office client in the browser and by
# the file host, and has not been measured against a counter — none, as before
# the model. Headers: the proxy sets what this stack set before the model —
# nosniff and the frame-ancestors CSP (both named in docker-compose.yml) over
# the HSTS base; which headers the server sends itself is not measured.
APP_TRAEFIK_LIMIT=limit-none
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-application-owned
# auth posture: public — a document server; the embedding application authorises through WOPI, there is no user login
APP_TRAEFIK_AUTH=auth-none@file
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# collabora/code (https://hub.docker.com/r/collabora/code/tags)
APP_TAG=26.04.3.2.1

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Integration ---
# aliasgroup1: regex of the host(s) allowed to embed Collabora via WOPI.
# Escape the dots; include the port. Space-separate multiple hosts.
#   Single:  https://cloud\.example\.com:443
COLLABORA_ALIASGROUP=https://cloud\.example\.com:443
# CSP frame-ancestors: the same embedding hosts, plain https:// form (no regex).
COLLABORA_ALLOWED_ORIGINS=https://cloud.example.com https://files.example.com

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna
TZ=UTC
