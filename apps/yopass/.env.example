# =============================================================================
# Yopass – Environment
# =============================================================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================================================

COMPOSE_PROJECT_NAME=yopass

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=secrets.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_ACCESS=access-public
# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: public — anonymous by design; the link is the capability
APP_TRAEFIK_AUTH=auth-none@file
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# yopass (https://hub.docker.com/r/jhaals/yopass)
APP_TAG=14.10.0
# memcached (https://hub.docker.com/_/memcached)
MEMCACHED_TAG=1.6-alpine

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_CACHE=${COMPOSE_PROJECT_NAME}-memcached

# --- Timezone ---
TZ=UTC

# --- Secrets ---
# None. Yopass holds no admin account, no database and no long-lived signing
# key — every secret it stores is user-supplied ciphertext with its own TTL,
# held only in Memcached (which itself needs no password).
