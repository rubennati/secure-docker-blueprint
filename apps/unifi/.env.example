# =============================================
# UniFi Network Application – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=unifi

# --- Domain & Traefik (Web UI only — device ports are direct) ---
APP_TRAEFIK_HOST=unifi.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_ACCESS=access-vpn
# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# LSIO UniFi Network Application
# (https://docs.linuxserver.io/images/docker-unifi-network-application/)
APP_TAG=10.6.101
# MongoDB. The image documents which versions the application accepts: 3.6 to 7.0
# from UniFi 8.1, and 8.0 as well from UniFi 9.0. APP_TAG above is 10.x, so 8.0 is
# supported. 4.4 was pinned here on the belief that nothing past it worked; that
# belief was wrong, and 4.4 reached end of life in February 2024.
#
# On x86_64 the image requires a CPU with AVX support for any MongoDB above 4.4.
# Check with: grep -o avx /proc/cpuinfo | head -1
#
# Existing installs cannot jump straight from 4.4 — MongoDB upgrades one major at
# a time. See UPSTREAM.md.
DB_TAG=8.0

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db

# --- User Mapping ---
PUID=1000
PGID=1000

# --- Database ---
DB_NAME=unifi
DB_ROOT_USER=root
DB_APP_USER=unifi-app
# UniFi's MONGO_PASS env var has no _FILE support. Value must match
# contents of .secrets/db_app_pwd.txt verbatim.
DB_APP_PWD_INLINE=__REPLACE_ME__

# --- Memory ---
# Java heap for the UniFi controller (MB). Raise for large sites:
#   - 1024 for <= 50 devices
#   - 2048 for <= 200 devices
#   - 4096 for large WISP/MSP deployments
MEM_LIMIT=1024

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/London, America/New_York
TZ=UTC
