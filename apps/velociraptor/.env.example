# =============================================================================
# Velociraptor – Environment
# =============================================================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# SECURITY: an operative DFIR platform, not a lightweight always-on app.
# Read README.md's Security model — especially the backup section — before
# deploying this anywhere with real endpoint clients in mind.
# =============================================================================

COMPOSE_PROJECT_NAME=velociraptor

# --- Images ---
# velociraptor-server (https://github.com/Velocidex/velociraptor/pkgs/container/velociraptor-server)
APP_TAG=0.77.2

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Network ---
# Baked into the server's certificate at first init — changing it later
# needs re-initialization, not a config edit. Must be the address/hostname
# your endpoint agents will actually reach.
VELOCIRAPTOR_HOSTNAME=velociraptor.example.com

# No Traefik — see docker-compose.yml for why. Bind each port to the
# interface it actually needs to be reachable from:
#   - Frontend (8000): wherever your endpoint agents connect from — often
#     0.0.0.0 if agents reach in from outside this host's own network
#   - GUI (8889): analysts only — a Tailscale/VPN interface IP, or
#     0.0.0.0 behind your own host firewall rule, not the open internet
VELOCIRAPTOR_FRONTEND_BIND=0.0.0.0
VELOCIRAPTOR_GUI_BIND=100.64.0.1

# --- Secrets ---
# Create the secrets directory:
#   mkdir -p .secrets volumes/etc volumes/datastore
#
# Only used on the very first start — every later start reuses the config
# already on disk and ignores this:
#   openssl rand -base64 24 | tr -d '\n' > .secrets/admin_password.txt
