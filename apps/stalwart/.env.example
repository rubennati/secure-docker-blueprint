# =============================================================================
# Stalwart – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=stalwart


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The server's hostname: the web interface, the SMTP greeting and the name the
# mail certificate is issued for.
APP_TRAEFIK_HOST=mail.example.com

APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach the web interface — the mail ports are not behind Traefik:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply — see docs/standards/traefik-security.md.
# sec-2: sign-in and the first page are 55 requests, measured 2026-10-03.
APP_TRAEFIK_SECURITY=sec-2

APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# Stalwart (https://hub.docker.com/r/stalwartlabs/stalwart)
APP_TAG=v0.16.24


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}


# --- App Configuration ----------------------------------------------- [app] --
# The first mail domain — addresses are <name>@${APP_MAIL_DOMAIN}.
APP_MAIL_DOMAIN=example.com

# Only used with mail.yml — the host address the mail ports 25, 465 and 993 are
# published on. A VPN address here keeps them off the public interface.
APP_MAIL_BIND=0.0.0.0


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
#
#   ops/init.sh
#   sudo chown -R 2000:2000 volumes/etc volumes/data
#   ops/setup.sh
#
# setup.sh writes the administrator's password to .secrets/admin_pwd.txt.
