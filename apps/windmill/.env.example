# =============================================================================
# Windmill – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=windmill


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=windmill.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns


# WHO may reach the app. Starts at access-blocked on purpose: a fresh Windmill ships
# a superadmin with a published password (admin@windmill.dev / changeme).
# Run ops/bootstrap-admin.sh first — it needs no Traefik route — then change
# this to the audience you want and `docker compose up -d`.
#   access-public   everyone
#   access-trusted  the ranges TRUSTED_RANGES declares in core/traefik/.env; empty: nobody
#   access-vpn      VPN only
#   access-trusted-vpn  those ranges + VPN
#   access-blocked  nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=access-blocked

# limit-extra-large: the interface's first load issues about 850 requests, more
# than the standard bucket of 500; the bucket of 1000 holds all of them —
# measured. CI accepts it only behind a closed access policy.
APP_TRAEFIK_LIMIT=limit-extra-large
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file


TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# windmill (https://github.com/windmill-labs/windmill/pkgs/container/windmill)
APP_TAG=1.814.0
# postgres (https://hub.docker.com/_/postgres) — Windmill requires 18; see
# UPSTREAM.md for the migration note if moving from an existing 16 install.
DB_TAG=18.6


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_SERVER=${COMPOSE_PROJECT_NAME}-server
CONTAINER_NAME_WORKER=${COMPOSE_PROJECT_NAME}-worker
CONTAINER_NAME_WORKER_NATIVE=${COMPOSE_PROJECT_NAME}-worker-native


# --- Database -------------------------------------------------------- [app] --
DB_NAME=windmill
DB_USER=postgres


# --- App Configuration ----------------------------------------------- [app] --
# The image ships a pre-created `windmill` user at this UID/GID — no init
# system, so running as it (instead of the image's own root default) is safe.
WM_UID=1000
WM_GID=1000


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
#
#   mkdir -p .secrets volumes/postgres volumes/worker_cache
#   sudo chown 1000:1000 volumes/worker_cache      # workers run as uid 1000
#
# Passwords that end up inside a URL (postgres://user:pw@host/db) must be hex —
# base64 produces + / = which break URL parsing:
#   openssl rand -hex 32 > .secrets/db_pwd.txt
#
# The operator account's password is generated by ops/bootstrap-admin.sh and
# written to .secrets/windmill_admin_pwd.txt.
