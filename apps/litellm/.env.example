# =============================================================================
# LiteLLM – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=litellm


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=litellm.example.com


# WHO may reach the gateway. Requests also need a key.
#   access-public   everyone
#   access-trusted  the ranges TRUSTED_RANGES declares in core/traefik/.env; empty: nobody
#   access-vpn      VPN only
#   access-trusted-vpn  those ranges + VPN
#   access-blocked  nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=access-trusted-vpn

# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file


TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# LiteLLM, non-root variant (https://github.com/BerriAI/litellm)
APP_TAG=v1.101.4
# PostgreSQL
DB_TAG=18.6


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db


# --- Database -------------------------------------------------------- [db] --
DB_NAME=litellm
DB_USER=litellm


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates all three files:
#
#   ops/init.sh
#
#   .secrets/db_pwd.txt               database password
#   .secrets/litellm_master_key.txt   operator / admin API key (starts with sk-)
#   .secrets/litellm_salt_key.txt     encrypts provider credentials stored in the DB
#
# Back up litellm_salt_key.txt: stored provider credentials cannot be decrypted
# without it, and it must not change once models are added.
