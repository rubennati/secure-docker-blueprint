# =============================================================================
# docker-mailserver – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=docker-mailserver


# --- Images -------------------------------------------------------- [image] --
# docker-mailserver (https://github.com/docker-mailserver/docker-mailserver/pkgs/container/docker-mailserver)
APP_TAG=16.0.1


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}


# --- App Configuration ----------------------------------------------- [app] --
# The server's host name: the SMTP greeting, the MX target and the name on the
# certificate in volumes/certs.
APP_MAIL_HOST=mail.example.com

# The first mail domain — addresses are <name>@${APP_MAIL_DOMAIN}.
APP_MAIL_DOMAIN=example.com

# Only used with mail.yml — the host address the mail ports 25, 465 and 993 are
# published on. A VPN address here keeps them off the public interface.
APP_MAIL_BIND=0.0.0.0

# 1 switches the virus scanner on. It holds about 850 MB of signatures in
# memory; raise the memory limit in docker-compose.yml to 4g with it.
APP_CLAMAV=0


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
#
#   ops/init.sh
#   # put fullchain.pem and privkey.pem into volumes/certs — README, "Certificate"
#   ops/setup.sh
#
# setup.sh writes the postmaster's password to .secrets/postmaster_pwd.txt.
