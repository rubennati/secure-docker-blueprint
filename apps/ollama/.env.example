# =============================================================================
# Ollama – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=ollama


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=ollama.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns


# WHO may reach the API. Ollama has no authentication of its own: whoever this
# admits can run inference on your hardware and pull or delete models. Keep it
# to an audience you trust, never access-public.
#   access-lan      LAN only (RFC1918)
#   access-vpn      VPN only
#   access-lan-vpn  LAN + VPN
#   access-blocked  nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=access-lan-vpn

# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file


TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# ollama (https://hub.docker.com/r/ollama/ollama)
APP_TAG=0.34.2


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- App Configuration ----------------------------------------------- [app] --
# The image starts as root; running as this uid/gid works and is the default.
# volumes/data must be owned by it: sudo chown 1000:1000 volumes/data
OLLAMA_UID=1000
OLLAMA_GID=1000

# Memory ceiling for the container. A loaded model, its context and the runtime
# all count against it — a limit the model exceeds gets the process killed
# mid-request. Roughly: model file size plus 1-2 GB, more for long contexts.
OLLAMA_MEMORY=8g

# CPU ceiling. CPU inference uses every core it is given.
OLLAMA_CPUS=4.00

# How long a model stays in memory after its last request.
OLLAMA_KEEP_ALIVE=5m


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
