# =============================================
# Cal.diy – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# Cal.diy is the MIT-licensed community edition of Cal.com.
# Upstream explicitly labels it as "strictly for personal,
# non-production use" with no security guarantees from Cal.com, Inc.
# =============================================

COMPOSE_PROJECT_NAME=caldiy

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=cal.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_ACCESS=access-public
# limit-standard. HSTS: the profile sends max-age only; before the model this
# host sent includeSubDomains and preload as well. That extension is a per-domain decision
# — browser-sticky for two years and, on an apex host, covering the whole zone.
# To restore it deliberately, place hsts-include-subdomains@file before
# ${APP_TRAEFIK_HEADERS}@file in docker-compose.yml once every subdomain below
# this host is HTTPS-capable. See docs/ops-runbook.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file
# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge

# --- Images ---
# ghcr.io/rubennati/cal.diy — cal.forte fork, reviewed `release` tags only, never `latest`.
# Pinned by digest (immutable) — refresh the sha256 on each new release.
# Use the digest for the architecture you run — the -arm tag is a different image,
# not a multi-arch index, so the digests are not interchangeable:
#   amd64  v6.2.0-6@sha256:538cbb4a22733d262057c4b2a47c700117766816f57732925b077267a0dbe0f1
#   arm64  v6.2.0-6-arm@sha256:5b2ffcb7fc0e752a40f079a4d580571da680af91238b0bdf1dbe170f246a2250
# Rollback pin: v6.2.0-5@sha256:c2facc284b28e1eea76b6d82c02e680d20d648dc255ef7f74520dbf30d18b17e
APP_TAG=v6.2.0-6@sha256:538cbb4a22733d262057c4b2a47c700117766816f57732925b077267a0dbe0f1
# postgres (https://hub.docker.com/_/postgres)
DB_TAG=17.11
# redis (https://hub.docker.com/_/redis)
REDIS_TAG=7.4-alpine

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis

# --- Database ---
DB_NAME=caldiy
DB_USER=caldiy

# --- App Configuration ---
# Branding — shown in the UI, support links, and page titles
NEXT_PUBLIC_APP_NAME=Cal.diy
NEXT_PUBLIC_COMPANY_NAME=Cal.diy
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=admin@example.com

# Legal — set to your own policy pages, or leave empty
NEXT_PUBLIC_WEBSITE_PRIVACY_POLICY_URL=
NEXT_PUBLIC_WEBSITE_TERMS_URL=

# VAPID keys for push notifications — required, app errors on boot without them.
# Generate a keypair: docker run --rm node:lts-alpine npx --yes web-push generate-vapid-keys
#   Public key  → VAPID_PUBLIC_KEY below (NEXT_PUBLIC_ prefix exposes it to the browser by design)
#   Private key → .secrets/vapid_private_key.txt (Docker Secret — never put it in .env)
VAPID_PUBLIC_KEY=__REPLACE_ME__

# Logging level (0=silly … 6=fatal; 3=info+ recommended for production)
NEXT_PUBLIC_LOGGER_LEVEL=3

# --- Attack surface ---
# Disable public self-registration. On an instance YOU operate, nobody outside
# needs to create an account — open signup is an attack foothold and a spam
# surface. Leave this =true unless you deliberately run an open instance.
# (Cal.com env flag; re-confirm it is honoured by the cal.forte build.)
NEXT_PUBLIC_DISABLE_SIGNUP=true

# Calendar integrations — set to true and fill credentials to enable
# Google credentials guide: https://github.com/rubennati/cal.diy#obtaining-the-google-api-credentials
GOOGLE_LOGIN_ENABLED=false
GOOGLE_API_CREDENTIALS=
GOOGLE_CALENDAR_API_KEY=
OUTLOOK_LOGIN_ENABLED=false

# --- SMTP ---
EMAIL_FROM=cal@example.com
EMAIL_FROM_NAME=Cal.diy
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# Create the secrets directory and generate all required files:
#   mkdir -p .secrets volumes/postgres volumes/redis
#   openssl rand -hex 32 > .secrets/db_pwd.txt
#   openssl rand -base64 32 | tr -d '\n' > .secrets/nextauth_secret.txt
#   openssl rand -base64 24 | tr -d '\n' > .secrets/encryption_key.txt
#   openssl rand -hex 16 | tr -d '\n' > .secrets/cron_api_key.txt
#   touch .secrets/smtp_password.txt           # write SMTP password here (dedicated credential)
#   touch .secrets/vapid_private_key.txt       # write VAPID private key here (from step 2 above)
