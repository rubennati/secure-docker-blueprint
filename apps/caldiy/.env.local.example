# =============================================
# Cal.diy – LOCAL test env  (docker-compose.local.yml)
# =============================================
# Copy to .env.local and fill in. Plain values, gitignored — LOCAL ONLY.
#   cp .env.local.example .env.local
# =============================================

# --- Images (same as prod; digest optional locally) ---
APP_TAG=v6.2.0-5@sha256:c2facc284b28e1eea76b6d82c02e680d20d648dc255ef7f74520dbf30d18b17e
DB_TAG=17.4
REDIS_TAG=7.4-alpine

# --- Database (use HEX password — URL-safe, no percent-encoding) ---
DB_NAME=caldiy
DB_USER=caldiy
# openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__

# --- App secrets (plain env for local) ---
# openssl rand -base64 32 | tr -d '\n'
NEXTAUTH_SECRET=__REPLACE_ME__
# openssl rand -base64 24 | tr -d '\n'
ENCRYPTION_KEY=__REPLACE_ME__
# openssl rand -hex 16
CRON_API_KEY=__REPLACE_ME__

# --- VAPID (required — app errors on boot without them) ---
# docker run --rm node:lts-alpine npx --yes web-push generate-vapid-keys
VAPID_PUBLIC_KEY=__REPLACE_ME__
VAPID_PRIVATE_KEY=__REPLACE_ME__

# --- SMTP (optional locally — leave blank to skip email) ---
EMAIL_FROM=cal@localhost
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# --- Timezone ---
TZ=Europe/Vienna
