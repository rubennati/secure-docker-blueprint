# Cal.diy — local
#
#   cp .env.local.example .env.local

# --- Images ---
APP_TAG=v6.2.0-9@sha256:bd6c53d80dcce24c2112c2878947d261f6bc825bda9fe93bf18e7e673d2f3034
DB_TAG=18.7
REDIS_TAG=8.10.3-alpine

# --- Database ---
DB_NAME=caldiy
DB_USER=caldiy
# openssl rand -hex 32
DB_PASSWORD=

# --- App secrets ---
# openssl rand -base64 32 | tr -d '\n'
NEXTAUTH_SECRET=
# openssl rand -base64 24 | tr -d '\n'
ENCRYPTION_KEY=
# openssl rand -hex 16
CRON_API_KEY=

# --- VAPID ---
# docker run --rm node:lts-alpine npx --yes web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- SMTP ---
EMAIL_FROM=cal@localhost
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# --- Timezone ---
TZ=Europe/Vienna
