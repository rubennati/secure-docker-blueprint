# Heimdall — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=2.8.1

# --- User Mapping (LinuxServer.io PUID/PGID pattern) ------------------ [app] --
#   id -u / id -g
PUID=1000
PGID=1000

# --- App Configuration ------------------------------------------------ [app] --
ALLOW_INTERNAL_REQUESTS=false

# --- Timezone --------------------------------------------------------- [app] --
TZ=UTC
