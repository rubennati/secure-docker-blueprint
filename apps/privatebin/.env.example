# =============================================================================
# PrivateBin – Environment
# =============================================================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================================================

COMPOSE_PROJECT_NAME=privatebin

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=paste.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
APP_TRAEFIK_ACCESS=acc-public
APP_TRAEFIK_SECURITY=sec-3
APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# privatebin (https://hub.docker.com/r/privatebin/nginx-fpm-alpine)
APP_TAG=2.0.6

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Timezone ---
TZ=UTC

# --- Secrets ---
# None. PrivateBin has no admin account and no server-side key of its own —
# every paste is encrypted in the sender's browser before it reaches the
# server, and the filesystem storage backend needs no credential.
#
# The data directory must be owned by the image's fixed UID/GID before first
# start:
#   mkdir -p volumes/data
#   sudo chown 65534:82 volumes/data
