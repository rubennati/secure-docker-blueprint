# Seafile CE — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=13.0.29
DB_TAG=10.11.19
MEMCACHED_TAG=1.6.45-alpine
REDIS_TAG=8.10.3-alpine

# --- Database -------------------------------------------------------- [app] --
SEAFILE_DB_USER=seafile
# openssl rand -base64 32 | tr -d '\n'
DB_ROOT_PASSWORD=
# openssl rand -base64 32 | tr -d '\n'
SEAFILE_DB_PASSWORD=

# --- Cache ----------------------------------------------------------- [app] --
# hex, not base64 — Seafile builds its Redis connection URL from this value
# without escaping it, and a "/" would terminate the URL early.
# openssl rand -hex 32
REDIS_PASSWORD=

# --- App Configuration ----------------------------------------------- [app] --
SEAFILE_ADMIN_EMAIL=admin@example.com
# openssl rand -base64 32 | tr -d '\n'
SEAFILE_ADMIN_PASSWORD=
# openssl rand -base64 48 | tr -d '\n'
JWT_PRIVATE_KEY=

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
