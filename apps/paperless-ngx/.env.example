# =============================================
# Paperless-ngx – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=paperless

# --- Compose Files ---
# Add sso.yml to enable Authentik OpenID Connect login:
#   COMPOSE_FILE=docker-compose.yml,sso.yml
COMPOSE_FILE=docker-compose.yml
COMPOSE_PATH_SEPARATOR=,

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=paperless.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# Access: access-public, access-trusted, access-vpn, access-trusted-vpn, access-blocked
# Default: VPN-only — Paperless holds personal documents, not a public service.
APP_TRAEFIK_ACCESS=access-vpn
# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file
# The optional -admin router in docker-compose.yml (commented out) puts the
# Django admin behind Authentik forward-auth; it reads this value.
# auth posture: forward-auth — the /admin path through core/authentik
ADMIN_TRAEFIK_AUTH=auth-authentik@file
# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge

# --- Images ---
# paperless-ngx (https://github.com/paperless-ngx/paperless-ngx/pkgs/container/paperless-ngx)
APP_TAG=3.4.2
# postgres (https://hub.docker.com/_/postgres)
DB_TAG=18.6
# redis (https://hub.docker.com/_/redis)
REDIS_TAG=8.10-alpine
# gotenberg (https://hub.docker.com/r/gotenberg/gotenberg)
GOTENBERG_TAG=8.39
# apache tika (https://hub.docker.com/r/apache/tika)
TIKA_TAG=3.3.3.0

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis
CONTAINER_NAME_GOTENBERG=${COMPOSE_PROJECT_NAME}-gotenberg
CONTAINER_NAME_TIKA=${COMPOSE_PROJECT_NAME}-tika

# --- Database ---
DB_NAME=paperless
DB_USER=paperless_user

# --- User Mapping ---
# Must match the UID/GID that owns ./volumes/ on the host.
USERMAP_UID=1000
USERMAP_GID=1000

# --- App Configuration ---
# Display name used in the UI and in outgoing emails (password reset, notifications).
# Replaces "Paperless-ngx" everywhere — set to match your instance name.
PAPERLESS_APP_TITLE=Paperless
# OCR language: three-letter code; several joined with + (deu+eng).
# PAPERLESS_OCR_LANGUAGES: extra language packs, SPACE-separated (deu eng ron) —
# a comma-separated list is read as one package name and skipped. deu, eng,
# fra, ita and spa ship in the image; any other is installed with apt each time
# the container is created, which needs outbound access, or it is skipped.
PAPERLESS_OCR_LANGUAGE=deu
PAPERLESS_OCR_LANGUAGES=deu
# Limit OCR to the first N pages per document (0 = all)
PAPERLESS_OCR_PAGES=3
PAPERLESS_WORKERS=1
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS=2

# --- SMTP ---
# Off as shipped: Paperless treats e-mail as off only while the host is
# localhost and the user is empty — the login page then offers no password
# reset. An empty host does not turn it off: the password reset answers 500.
# Used for: password reset, workflow notifications, sending documents by mail.
# To enable: your relay's host, user and FROM; STARTTLS on 587 is
# PAPERLESS_EMAIL_USE_TLS=true; implicit TLS on 465 is PAPERLESS_EMAIL_USE_TLS=false
# with PAPERLESS_EMAIL_USE_SSL=true — never both.
# Password goes in .secrets/email_pwd.txt (see Secrets section below).
PAPERLESS_EMAIL_HOST=localhost
PAPERLESS_EMAIL_PORT=587
PAPERLESS_EMAIL_HOST_USER=
PAPERLESS_EMAIL_USE_TLS=true
PAPERLESS_EMAIL_USE_SSL=false
PAPERLESS_EMAIL_FROM=Paperless <paperless@example.com>

# --- SSO (only active when sso.yml is in COMPOSE_FILE) ---
# Create an OAuth2/OIDC provider in Authentik, then set these.
# Redirect URI to configure in Authentik:
#   https://<APP_TRAEFIK_HOST>/accounts/oidc/<SSO_PROVIDER_ID>/login/callback/
# SSO_PROVIDER_ID=authentik
# SSO_PROVIDER_NAME=Single Sign-On
# SSO_CLIENT_ID=your-client-id
# SSO_CLIENT_SECRET=your-client-secret
# SSO_SERVER_URL=https://auth.example.com/application/o/paperless/.well-known/openid-configuration

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# Create the secrets directory and generate passwords/keys.
#   mkdir -p .secrets
#   openssl rand -base64 32 | tr -d '\n' > .secrets/db_pwd.txt
#   openssl rand -base64 48 | tr -d '\n' > .secrets/secret_key.txt
#
# SMTP password — the file must exist, empty while e-mail is off:
#   : > .secrets/email_pwd.txt
#   echo -n 'your-smtp-password' > .secrets/email_pwd.txt   # once enabled
