# Paperless-ngx — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=3.0.3
DB_TAG=16.14
REDIS_TAG=7.4-alpine
GOTENBERG_TAG=8.21
TIKA_TAG=3.1.0.0

# --- Database -------------------------------------------------------- [db] --
DB_NAME=paperless
DB_USER=paperless_user
# openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__

# --- App secrets ----------------------------------------------------- [app] --
# openssl rand -base64 48 | tr -d '\n'
SECRET_KEY=__REPLACE_ME__

# --- Admin account --------------------------------------------------- [app] --
ADMIN_USER=admin
# openssl rand -base64 24 | tr -d '\n'
ADMIN_PASSWORD=__REPLACE_ME__

# --- User Mapping ---------------------------------------------------- [app] --
USERMAP_UID=1000
USERMAP_GID=1000

# --- App Configuration ----------------------------------------------- [app] --
PAPERLESS_APP_TITLE=Paperless (local)
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_LANGUAGES=
PAPERLESS_OCR_PAGES=3

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
