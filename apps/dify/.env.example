# =============================================================================
# Dify – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=dify


# --- Domain & Traefik ------------------------------------------- [traefik] --
# One host name serves the console, the apps and the service API.
APP_TRAEFIK_HOST=dify.example.com

# TLS profile — see docs/standards/traefik-security.md.
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it. Applications published from Dify and their API keys are
# served from this same host, so this includes their consumers.
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=acc-private

# WHAT headers / rate limit apply — see docs/standards/traefik-security.md.
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — empty by default: no CrowdSec bouncer on these routers.
# See core/crowdsec/docs/profiles.md to enable one; keep the trailing comma.
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# Dify api, worker and web (https://github.com/langgenius/dify)
APP_TAG=1.17.1
PLUGIN_TAG=0.6.10-local
SANDBOX_TAG=0.2.15
SQUID_TAG=6.6-24.04_edge
DB_TAG=15.14-alpine
PGVECTOR_TAG=0.8.1-pg16
REDIS_TAG=7.4-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_API=${COMPOSE_PROJECT_NAME}-api
CONTAINER_NAME_WORKER=${COMPOSE_PROJECT_NAME}-worker
CONTAINER_NAME_BEAT=${COMPOSE_PROJECT_NAME}-worker-beat
CONTAINER_NAME_WEB=${COMPOSE_PROJECT_NAME}-web
CONTAINER_NAME_PLUGIN=${COMPOSE_PROJECT_NAME}-plugin-daemon
CONTAINER_NAME_SANDBOX=${COMPOSE_PROJECT_NAME}-sandbox
CONTAINER_NAME_SSRF=${COMPOSE_PROJECT_NAME}-ssrf-proxy
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_PGVECTOR=${COMPOSE_PROJECT_NAME}-pgvector
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis


# --- Databases -------------------------------------------------------- [db] --
DB_NAME=dify
DB_USER=postgres
VECTOR_DB_NAME=dify


# --- Application ----------------------------------------------------- [app] --
# true: model providers and tools are installed from Dify's marketplace, which
# needs outbound access from the plugin daemon. false: only plugins you upload.
MARKETPLACE_ENABLED=true

TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the files:
#
#   ops/init.sh
#
#   .secrets/init_password.txt       asked once on the first visit to /install
#   .secrets/secret_key.txt          signs sessions and encrypts stored provider credentials
#   .secrets/db_password.txt         PostgreSQL
#   .secrets/pgvector_password.txt   vector store
#   .secrets/redis_password.txt      Redis
#   .secrets/celery_broker_url.txt   the Redis URL, built from the password
#   .secrets/sandbox_api_key.txt     api → sandbox
#   .secrets/plugin_daemon_key.txt   api → plugin daemon
#   .secrets/plugin_inner_api_key.txt  plugin daemon → api
#
# secret_key.txt must not change once provider credentials are stored.
