# =============================================================================
# paperless-gpt – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================
#
#   [compose]  Docker Compose itself — project and container names
#   [traefik]  the reverse proxy — hostname, TLS, access, security chain
#   [image]    which image version gets pulled
#   [app]      the application's own settings
#   [secrets]  documented here, values live in .secrets/ — never in this file
#
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
# Drives container names, the Traefik router and the basic-auth middleware name.
COMPOSE_PROJECT_NAME=paperless-gpt


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=paperless-gpt.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
#   cloudflare-dns  DNS-01 — wildcards, no port 80 needed
#   httpResolver    HTTP-01 — no DNS provider needed
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS profile:
#   tls-basic   TLS 1.2+ — broad client compatibility
#   tls-aplus   TLS 1.2+ strict cipher set — the default for public apps
#   tls-modern  TLS 1.3 only — modern clients only
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# VPN-only, and this one is not a preference. paperless-gpt has no
# authentication of its own: whoever reaches it can rewrite documents in the
# connected Paperless-ngx, start model and OCR jobs on the configured keys, and
# change its settings. The password below is the second gate, not the first.
APP_TRAEFIK_ACCESS=acc-tailscale

# HTTP basic auth in front of the router — `user:hash`, several separated by
# commas. This is the only credential in front of an application that has none,
# so it is not optional.
#
# **Every `$` in the hash has to be doubled here.** Compose expands `$apr1` and
# `$2y` as variable names otherwise, and the label reaches Traefik as a few
# leftover characters — measured, not guessed. Both commands below already do
# the doubling; paste the whole line:
#
#   htpasswd -nbB ops 'the-password' | sed -e 's/\$/\$\$/g'
#   printf 'ops:%s\n' "$(openssl passwd -apr1 'the-password')" | sed -e 's/\$/\$\$/g'
#
# This file is gitignored, which is what keeps the hash out of the repository.
# `docs/standards/secrets.md` calls that Pattern 3, a documented deviation: a
# Traefik middleware reads its users from the label, not from a file this stack
# could mount as a Docker Secret.
APP_BASIC_AUTH_USERS=ops:$$apr1$$REPLACE$$WITH_A_REAL_HASH

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
#   sec-2           standard default for a new app
#   sec-3           public-facing and hardened
#   *e suffix       iframe-friendly (embedded apps)
#   *-spa suffix    high burst rate limit — documented for VPN-gated apps only
#
# The interface is a React application; its first load has not been measured
# behind Traefik. See README, "Known limits".
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — the third axis, independent of the two above.
# Empty by default: no CrowdSec bouncer on this router.
#
# To enable, name a profile from core/crowdsec/docs/profiles.md and keep the
# trailing comma — the value is prepended to the middleware list, and it has to
# come first so a banned address is rejected before anything else does work on
# the request. The @file is part of the value:
#   APP_TRAEFIK_THREAT=crowdsec-basic@file,
APP_TRAEFIK_THREAT=

# Shared proxy network, created by core/traefik. Same value in every app.
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# App image → pin major.minor.patch. Never :latest, never major-only.
# paperless-gpt (https://github.com/icereed/paperless-gpt/pkgs/container/paperless-gpt)
APP_TAG=v0.28.0


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- App Configuration ----------------------------------------------- [app] --
# The user the server runs as: the owner of ./volumes/db, ./volumes/config and
# ./volumes/prompts. Create those before the first start — Docker would create
# them as root, and the process runs without the capabilities root would need.
APP_UID=1000
APP_GID=1000

# Where Paperless-ngx answers. The container alias on proxy-public keeps the
# call between containers; PAPERLESS_PUBLIC_URL is only what the links in the
# interface point at.
PAPERLESS_BASE_URL=http://paperless-ngx-app:8000
PAPERLESS_PUBLIC_URL=https://paperless.example.com

# The model.
#   openai  every OpenAI-compatible endpoint, including apps/litellm — set
#           OPENAI_BASE_URL and put the key in .secrets/llm_api_key.txt
#   ollama  apps/ollama directly — set OLLAMA_HOST, no key needed
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OPENAI_BASE_URL=
OLLAMA_HOST=http://ollama-app:11434
LLM_LANGUAGE=English

# OCR for documents Paperless-ngx could not read.
#   llm      page images go to the vision model below
#   docling  page images go to a Docling server — apps/docling-serve is one
OCR_PROVIDER=llm
DOCLING_URL=
VISION_LLM_PROVIDER=ollama
VISION_LLM_MODEL=minicpm-v

# The tags it watches and sets in Paperless-ngx. All three are created there on
# the first start if they do not exist.
MANUAL_TAG=paperless-gpt
AUTO_TAG=paperless-gpt-auto
FAIL_TAG=paperless-gpt-failed

# Log verbosity: debug, info, warn, error
APP_LOG_LEVEL=info


# --- Timezone -------------------------------------------------------- [app] --
# Examples: UTC, Europe/Vienna, Europe/Berlin
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
#
#   mkdir -p .secrets volumes/db volumes/config volumes/prompts
#
# The Paperless-ngx API token, created there under Settings → API tokens for a
# user whose permissions are what paperless-gpt may do to your documents:
#   printf '%s' 'the-token' > .secrets/paperless_api_token.txt
#
# The model provider's key, for a hosted model or a gateway that demands one.
# Empty file when the model server needs none:
#   touch .secrets/llm_api_key.txt
#
# The three volume directories must belong to APP_UID:APP_GID:
#   sudo chown -R 1000:1000 volumes/db volumes/config volumes/prompts
