# paperless-gpt — local env
#   cp .env.local.example .env.local

APP_TAG=v0.28.0
APP_UID=1000
APP_GID=1000
PAPERLESS_BASE_URL=http://host.docker.internal:8000
LLM_PROVIDER=ollama
