# =============================================================================
# docling-serve – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=docling-serve


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=docling.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns


# WHO may reach the API. Document conversion is not meant for the open
# internet by default — start restricted.
#   access-public   everyone
#   access-lan      LAN only (RFC1918)
#   access-vpn      VPN only
#   access-lan-vpn  LAN + VPN
#   access-blocked  nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=access-lan-vpn

# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file


TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# docling-serve-cpu (https://github.com/docling-project/docling-serve) — CPU
# variant; -cu128/-cu130 exist for NVIDIA GPU hosts, not used here.
APP_TAG=v1.34.0


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- App Configuration ----------------------------------------------- [app] --
# The /ui playground at https://<host>/ui. Off by default — it is a debugging
# surface, not something an API consumer needs.
DOCLING_ENABLE_UI=0


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
#
#   mkdir -p .secrets
#   openssl rand -base64 32 | tr -d '\n' > .secrets/docling_api_key.txt
#
# Every request must then carry it: `-H "X-Api-Key: <value>"`.
