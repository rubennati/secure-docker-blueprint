# =============================================================================
# OpenCanary – Environment
# =============================================================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# SECURITY: a real user or service should never touch any of these ports.
# Deploy this only where you can treat a connection attempt as a signal —
# see README.md before exposing it anywhere with real traffic nearby.
# =============================================================================

COMPOSE_PROJECT_NAME=opencanary

# --- Images ---
# opencanary (https://hub.docker.com/r/thinkst/opencanary)
APP_TAG=0.9.10

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Network ---
# Direct published ports — see docker-compose.yml for why this does not go
# through Traefik. Match these against config/opencanary.conf's enabled
# modules; a port published here with its module disabled just refuses
# connections, and a module enabled without its port published here is
# unreachable from outside the container.
# The host address every honeypot port binds to — an IPv4 address; 0.0.0.0 is every IPv4
# address. A published port names its address, or it also listens on [::],
# where Docker hands an IPv6 client to the container as the bridge gateway
# (DEC-075). Narrow it to one interface — a VPN address such as 100.64.0.1 —
# where the whole LAN or internet need not reach it. Required: unset stops Compose.
OPENCANARY_BIND=0.0.0.0
OPENCANARY_FTP_PORT=21
OPENCANARY_TELNET_PORT=23
OPENCANARY_HTTP_PORT=80
OPENCANARY_MYSQL_PORT=3306
OPENCANARY_RDP_PORT=3389

# --- Secrets ---
# None. OpenCanary holds no credentials — it only pretends to ask for
# other services' credentials and logs the attempt.
