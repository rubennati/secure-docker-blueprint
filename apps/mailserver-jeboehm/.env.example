# =============================================================================
# mailserver (jeboehm) – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=mailserver-jeboehm


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The server's host name: the web interface, the SMTP greeting and the name on
# the certificate in volumes/certs.
APP_TRAEFIK_HOST=mail.example.com

APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach the web interface — the mail ports are not behind Traefik:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply — see docs/standards/traefik-security.md.
APP_TRAEFIK_SECURITY=sec-2

APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# mailserver-mta, -mda, -filter, -web, -unbound (https://github.com/jeboehm?tab=packages&repo_name=docker-mailserver)
APP_TAG=8.0.8
# MySQL (https://hub.docker.com/_/mysql)
DB_TAG=8.4.11
# Redis (https://hub.docker.com/_/redis)
REDIS_TAG=8.2.10-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_MTA=${COMPOSE_PROJECT_NAME}-mta
CONTAINER_NAME_MDA=${COMPOSE_PROJECT_NAME}-mda
CONTAINER_NAME_FILTER=${COMPOSE_PROJECT_NAME}-filter
CONTAINER_NAME_WEB=${COMPOSE_PROJECT_NAME}-web
CONTAINER_NAME_UNBOUND=${COMPOSE_PROJECT_NAME}-unbound
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis


# --- Database -------------------------------------------------------- [db] --
DB_NAME=mailserver
DB_USER=mailserver


# --- App Configuration ----------------------------------------------- [app] --
# The first mail domain — addresses are <name>@${APP_MAIL_DOMAIN}.
APP_MAIL_DOMAIN=example.com

# The proxy network's address range, so the web interface reads the client
# address Traefik forwards.
APP_TRAEFIK_TRUSTED_PROXIES=172.16.0.0/12

# Only used with mail.yml — the host address the mail ports 25, 587 and 993 are
# published on. A VPN address here keeps them off the public interface.
APP_MAIL_BIND=0.0.0.0


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
#
#   ops/init.sh      # creates the directories and generates every secret
#   # put tls.crt and tls.key into volumes/certs — README, "Certificate"
#   ops/setup.sh
#
# setup.sh writes the administrator's password to .secrets/admin_pwd.txt.
