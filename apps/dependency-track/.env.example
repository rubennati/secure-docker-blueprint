# =============================================================================
# Dependency-Track – Environment
# =============================================================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================================================

COMPOSE_PROJECT_NAME=dependency-track

# --- Domain & Traefik ---
# Two separate origins: the frontend (what people open in a browser) and
# the API server (what the frontend's own JS calls, and what CI/CD uploads
# SBOMs to directly). Different subdomains, both through Traefik.
APP_TRAEFIK_HOST=dtrack.example.com
APP_TRAEFIK_HOST_API=dtrack-api.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
APP_TRAEFIK_ACCESS=acc-tailscale
APP_TRAEFIK_SECURITY=sec-3
APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# dependencytrack apiserver + frontend (https://github.com/DependencyTrack/dependency-track/pkgs/container/apiserver)
# WARNING verified 2026-09-19: the `latest` tag on Docker Hub still points
# to the old v4 line (EOL December 2026), not v5 — see UPSTREAM.md. Always
# pin the full X.Y.Z tag.
APP_TAG=5.1.0
# postgres (https://hub.docker.com/_/postgres)
DB_TAG=16-alpine

# --- Containers ---
CONTAINER_NAME_API=${COMPOSE_PROJECT_NAME}-api
CONTAINER_NAME_FRONTEND=${COMPOSE_PROJECT_NAME}-frontend
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db

# --- Database ---
DB_NAME=dtrack
DB_USER=dtrack

# --- Timezone ---
TZ=UTC

# --- Secrets ---
# Create the secrets directory:
#   mkdir -p .secrets volumes/postgres volumes/data
#
# Database password — hex, since it goes into a JDBC URL-adjacent context:
#   openssl rand -hex 32 > .secrets/db_pwd.txt
#
# Secret-management KEK (key encryption key) — protects every secret this
# instance stores internally (integration API tokens for Jira/Snyk/etc, if
# you configure any). MUST be a base64-encoded 32-byte AES-256 key, and
# MUST NOT change after go-live: rotating or losing it makes every secret
# encrypted under the old key permanently unreadable. Back this up with the
# same care as the database itself — see README.md#backup.
#   openssl rand -base64 32 | tr -d '\n' > .secrets/dt_kek.txt
