# =============================================
# Easy!Appointments – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=easyappointments

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=appointments.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# WHO may reach it.
#   access-public       everyone
#   access-trusted      the ranges TRUSTED_RANGES declares in core/traefik/.env; empty: nobody
#   access-vpn          VPN only
#   access-trusted-vpn  those ranges + VPN
#
# VPN-only by default, deliberately: until the installation wizard has run,
# whoever reaches /index.php/installation first sets the administrator. Guests
# cannot book through a closed router, so access-public is the deliberate step
# after the wizard — see the README, "The open window".
APP_TRAEFIK_ACCESS=access-vpn
# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file
# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge

# --- Images ---
# alextselegidis/easyappointments (https://hub.docker.com/r/alextselegidis/easyappointments)
APP_TAG=1.6.1
# mariadb (https://hub.docker.com/_/mariadb)
DB_TAG=11.4

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db

# --- Database ---
DB_NAME=easyappointments
DB_USER=easyappointments
# Easy!Appointments reads DB_PASSWORD inline from env (no _FILE support).
# Value must match contents of .secrets/db_pwd.txt verbatim.
DB_PWD_INLINE=__REPLACE_ME__

# --- Timezone ---
TZ=UTC
