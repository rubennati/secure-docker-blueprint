# =============================================================================
# Calnode – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=calnode


# --- Domain & Traefik ------------------------------------------- [traefik] --
# One host serves the booking pages, the admin interface and the REST API.
# The https:// form of this value is what puts the application into production
# mode — secure cookies, and the encryption key becomes mandatory.
APP_TRAEFIK_HOST=booking.example.com

# TLS profile — see docs/standards/traefik-security.md.
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it.
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# VPN-only by default, deliberately: POST /v1/setup is public and unauthenticated
# until it has run once, and it hands the workspace to whoever calls it first.
# Guests cannot book through a closed router, so opening it is the deliberate
# step after ops/setup.sh — see the README.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply — see docs/standards/traefik-security.md.
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — empty by default: no CrowdSec bouncer on this router.
# See core/crowdsec/docs/profiles.md to enable one; keep the trailing comma.
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# Calnode (https://github.com/Calnode/calnode)
APP_TAG=0.9.0


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- Application ----------------------------------------------------- [app] --
# Owner of volumes/data. The image would otherwise run as root.
APP_UID=1000
APP_GID=1000


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates both files:
#
#   ops/init.sh
#
#   .secrets/calnode_encryption_key.txt   derives the key that encrypts stored
#                                         calendar and provider credentials
#   .secrets/calnode_recovery_secret.txt  recovers that key if it is lost
#
# Back both up off this host and never change the encryption key once calendars
# are connected — the stored credentials are unreadable without it.
