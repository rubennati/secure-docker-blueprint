# =============================================================================
# Calnode – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=calnode


# --- Domain & Traefik ------------------------------------------- [traefik] --
# One host serves the booking pages, the admin interface and the REST API.
# The https:// form of this value is what puts the application into production
# mode — secure cookies, and the encryption key becomes mandatory.
APP_TRAEFIK_HOST=booking.example.com


# WHO may reach it.
#   access-public   everyone
#   access-trusted  the ranges TRUSTED_RANGES declares in core/traefik/.env; empty: nobody
#   access-vpn      VPN only
#   access-trusted-vpn  those ranges + VPN
#   access-blocked  nobody — the emergency kill switch
#
# VPN-only by default, deliberately: POST /v1/setup is public and unauthenticated
# until it has run once, and it hands the workspace to whoever calls it first.
# Guests cannot book through a closed router, so opening it is the deliberate
# step after ops/setup.sh — see the README.
APP_TRAEFIK_ACCESS=access-vpn

# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the login method configured after /v1/setup (README)
APP_TRAEFIK_AUTH=auth-none@file


# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge


# --- Images -------------------------------------------------------- [image] --
# Calnode (https://github.com/Calnode/calnode)
APP_TAG=0.9.0


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- Application ----------------------------------------------------- [app] --
# Owner of volumes/data. The image would otherwise run as root.
APP_UID=1000
APP_GID=1000


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates both files:
#
#   ops/init.sh
#
#   .secrets/calnode_encryption_key.txt   derives the key that encrypts stored
#                                         calendar and provider credentials
#   .secrets/calnode_recovery_secret.txt  recovers that key if it is lost
#
# Back both up off this host and never change the encryption key once calendars
# are connected — the stored credentials are unreadable without it.
