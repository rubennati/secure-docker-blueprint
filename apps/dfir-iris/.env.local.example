# DFIR-IRIS — local
#
#   cp .env.local.example .env.local

# --- Images ---
APP_TAG=v2.4.29
RABBITMQ_TAG=3-management-alpine

# --- Database ---
DB_NAME=iris_db
DB_USER=postgres
DB_ADMIN_USER=raptor
# openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__
DB_ADMIN_PASSWORD=__REPLACE_ME__

# --- App Configuration ---
# openssl rand -base64 48 | tr -d '\n'
IRIS_SECRET_KEY=__REPLACE_ME__
# openssl rand -base64 32 | tr -d '\n'
IRIS_SECURITY_PASSWORD_SALT=__REPLACE_ME__
