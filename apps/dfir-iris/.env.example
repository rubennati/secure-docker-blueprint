# =============================================================================
# DFIR-IRIS – Environment
# =============================================================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# SECURITY: this holds real incident data, IOCs, evidence and internal
# notes once in use. Read README.md's Security model before deploying it
# anywhere reachable beyond your own VPN.
# =============================================================================

COMPOSE_PROJECT_NAME=dfir-iris

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=iris.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
APP_TRAEFIK_ACCESS=acc-tailscale
APP_TRAEFIK_SECURITY=sec-3
APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# iris-web (https://github.com/dfir-iris/iris-web/pkgs/container/iriswebapp_app)
APP_TAG=v2.4.29
# rabbitmq (https://hub.docker.com/_/rabbitmq)
RABBITMQ_TAG=3-management-alpine

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_WORKER=${COMPOSE_PROJECT_NAME}-worker
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_RABBITMQ=${COMPOSE_PROJECT_NAME}-rabbitmq

# --- Database ---
DB_NAME=iris_db
DB_USER=postgres
# A second Postgres role IRIS itself uses internally for privileged
# operations (upstream's own convention — the name "raptor" is theirs).
DB_ADMIN_USER=raptor

# --- App Configuration ---
LOG_LEVEL=info
# local | ldap | oidc — see README.md#authentication for ldap/oidc, which
# need additional variables added to docker-compose.yml's environment
# block beyond what this file covers by default.
IRIS_AUTHENTICATION_TYPE=local

# --- Timezone ---
TZ=UTC

# --- Secrets ---
# Create the secrets directory:
#   mkdir -p .secrets volumes/postgres volumes/rabbitmq volumes/downloads volumes/templates volumes/server_data
#
#   openssl rand -hex 32 > .secrets/db_pwd.txt
#   openssl rand -hex 32 > .secrets/db_admin_pwd.txt
#
# IRIS's own session-signing key and password-hashing salt — both required,
# both non-rotatable without invalidating every session and, for the salt,
# potentially affecting stored password hashes. Generate once, keep stable:
#   openssl rand -base64 48 | tr -d '\n' > .secrets/iris_secret_key.txt
#   openssl rand -base64 32 | tr -d '\n' > .secrets/iris_security_password_salt.txt
