# Mailpit — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=v1.31.1

# --- App Configuration ----------------------------------------------- [app] --
# The unprivileged user the binary runs as. Messages stay in memory here, so
# any uid works.
USERMAP_UID=1000
USERMAP_GID=1000

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
