# =============================================
# Mailpit – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=mailpit

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=mailpit.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# Access: access-public, access-trusted, access-vpn, access-trusted-vpn, access-blocked
# The UI shows every message the stacks send — password-reset links included.
# VPN-only, and its own htpasswd (MP_UI_AUTH_FILE, .secrets/) asks who is reading.
APP_TRAEFIK_ACCESS=access-vpn
# limit-standard: the UI's first load is a dozen requests, far below the burst.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — Mailpit's own htpasswd (MP_UI_AUTH_FILE) covers the UI and the API
APP_TRAEFIK_AUTH=auth-none@file
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# axllent/mailpit (https://hub.docker.com/r/axllent/mailpit)
APP_TAG=v1.31.1

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- App Configuration ---
# The unprivileged user the binary runs as. It has to own ./volumes/data —
# the directory a `mkdir` by the operator's own account already does.
USERMAP_UID=1000
USERMAP_GID=1000
# Oldest messages are pruned beyond this count.
MP_MAX_MESSAGES=1000
# Shown in the UI title, so a browser tab says which instance this is.
MP_LABEL=

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# The htpasswd file the UI and the API ask for (MP_UI_AUTH_FILE), mounted as a
# Docker Secret — bcrypt, one user per line:
#   mkdir -p .secrets && htpasswd -nbB ops 'the-password' > .secrets/mailpit_htpasswd.txt
# Create the data directory, owned by USERMAP_UID:
#   mkdir -p volumes/data
