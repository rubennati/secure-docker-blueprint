# =============================================
# Mailpit – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=mailpit

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=mailpit.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# TLS profile: tls-basic (TLS 1.2), tls-aplus (TLS 1.2 strict), tls-modern (TLS 1.3 only)
APP_TRAEFIK_TLS_OPTION=tls-aplus
# Access: acc-public, acc-local, acc-tailscale, acc-private, acc-deny
# The UI shows every message the stacks send — password-reset links included —
# and has no login of its own. VPN-only, and nothing else is defensible.
APP_TRAEFIK_ACCESS=acc-tailscale
# Security: sec-0 (none) to sec-5 (maximum). "e" suffix = iframe-friendly
# sec-3: strict headers with the soft rate limit. The UI's first load is a
# dozen requests, far below the burst of 50.
APP_TRAEFIK_SECURITY=sec-3
# Threat enforcement — the third axis, independent of the two above.
# Empty by default: no CrowdSec bouncer on this router.
#
# To enable, name a profile from core/crowdsec/docs/profiles.md and keep the
# trailing comma — the value is prepended to the middleware list, and it has to
# come first so a banned address is rejected before anything else does work on
# the request:
#   APP_TRAEFIK_THREAT=crowdsec-basic@file,
APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# axllent/mailpit (https://hub.docker.com/r/axllent/mailpit)
APP_TAG=v1.31.1

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- App Configuration ---
# The unprivileged user the binary runs as. It has to own ./volumes/data —
# the directory a `mkdir` by the operator's own account already does.
USERMAP_UID=1000
USERMAP_GID=1000
# Oldest messages are pruned beyond this count.
MP_MAX_MESSAGES=1000
# Shown in the UI title, so a browser tab says which instance this is.
MP_LABEL=

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# None. Create the data directory, owned by USERMAP_UID:
#   mkdir -p volumes/data
