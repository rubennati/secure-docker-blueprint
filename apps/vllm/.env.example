# =============================================================================
# vLLM – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Needs an NVIDIA GPU, a driver of 535 or newer and the NVIDIA Container
# Toolkit on the host. Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=vllm


# --- Domain & Traefik ------------------------------------------- [traefik] --
# Only /v1/ is routed to this host name; every other path returns 404.
APP_TRAEFIK_HOST=vllm.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns


# WHO may reach the API. Requests also need the API key; this narrows who can
# even try. GPU time is expensive — do not leave this open.
#   access-public   everyone
#   access-trusted  the ranges TRUSTED_RANGES declares in core/traefik/.env; empty: nobody
#   access-vpn      VPN only
#   access-trusted-vpn  those ranges + VPN
#   access-blocked  nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=access-trusted-vpn

# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the API key on /v1; the other paths answer whoever the access policy admits (README)
APP_TRAEFIK_AUTH=auth-none@file


# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge


# --- Images -------------------------------------------------------- [image] --
# vllm-openai (https://hub.docker.com/r/vllm/vllm-openai) — CUDA 13 build,
# about 8.7 GB compressed. The image is not multi-purpose: it needs the GPU.
APP_TAG=v0.30.0


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- App Configuration ----------------------------------------------- [app] --
# The image starts as root; this uid/gid is what it runs as here.
# volumes/cache must be owned by it: sudo chown 1000:1000 volumes/cache
VLLM_UID=1000
VLLM_GID=1000

# The model to serve — a Hugging Face repository id. Downloaded on first start
# (gated models need .secrets/hf_token.txt). The weights must fit in VRAM
# together with the KV cache; this default is small.
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# The name clients put in the `model` field of a request.
VLLM_SERVED_MODEL_NAME=default

# Longest prompt plus completion, in tokens. Lower it if the KV cache does not
# fit; raising it costs VRAM.
VLLM_MAX_MODEL_LEN=8192

# Fraction of each GPU's memory vLLM may claim (weights + KV cache).
VLLM_GPU_MEMORY_UTILIZATION=0.90

# GPUs to use. Also sets the tensor-parallel size, so the model is split across
# them; more than 1 needs the GPUs to be linked well enough to make that worth it.
VLLM_GPU_COUNT=1

# Shared memory. The engine will not start with Docker's default 64 MiB.
VLLM_SHM_SIZE=8g

# Host memory ceiling and CPU ceiling for the container.
VLLM_MEMORY=32g
VLLM_CPUS=8.00


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
#
#   mkdir -p .secrets volumes/cache
#   sudo chown 1000:1000 volumes/cache
#   openssl rand -hex 24 > .secrets/vllm_api_key.txt
#
# A Hugging Face access token, only for gated or private models. The file must
# exist; leave it empty for public models:
#   touch .secrets/hf_token.txt
