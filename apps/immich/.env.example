# =============================================
# Immich – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=immich

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=photos.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# Ships closed: until an admin exists, POST /api/auth/admin-sign-up makes the
# first caller the admin. Create it over the VPN, then open the route
# (access-public) for the mobile apps — README, Security Model.
APP_TRAEFIK_ACCESS=access-vpn
# limit-standard: the service worker pre-caches about 100 JS chunks in parallel
# on first install; a 429 among them leaves the app on a black screen. The
# bucket of 500 holds them.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file
# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge

# --- Images ---
# Immich server + machine-learning (https://github.com/immich-app/immich/releases)
APP_TAG=v3.3.6
# Immich-flavoured Postgres with VectorChord
# (https://github.com/immich-app/base-images/pkgs/container/postgres)
DB_TAG=14-vectorchord1.1.1@sha256:b38cad4a8bdb716d19b07e5afb4a6e2ed9e7f8a5a93f428aae35f495c72d3498
# Valkey (Redis-compatible) — https://hub.docker.com/r/valkey/valkey
REDIS_TAG=9.1.3

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_ML=${COMPOSE_PROJECT_NAME}-ml
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis

# --- Storage ---
# Location where uploaded photos/videos are stored.
# Default: bind-mount under the app directory. Change to an external path
# (e.g. /mnt/nas/immich) for network storage — NFS/SMB are supported for
# the media upload volume only, NOT for the database volume.
UPLOAD_LOCATION=./volumes/library

# --- Database ---
DB_NAME=immich
DB_USER=immich
# Immich-server reads DB_PASSWORD from a single env var (no _FILE support).
# Value must match the content of ./.secrets/db_pwd.txt verbatim.
# Postgres container uses POSTGRES_PASSWORD_FILE from the same secret.
DB_PWD_INLINE=

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/London, America/New_York
TZ=UTC
