# =============================================================================
# Hemmelig – Environment
# =============================================================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# LICENSE: Hemmelig is under the "O'Saasy License Agreement", not an
# OSI-approved open-source license. Self-hosting for your own use is
# unrestricted; re-offering this as a hosted service to third parties is not.
# See UPSTREAM.md.
# =============================================================================

COMPOSE_PROJECT_NAME=hemmelig

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=secrets2.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
APP_TRAEFIK_ACCESS=acc-public
APP_TRAEFIK_SECURITY=sec-3
APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# hemmelig (https://hub.docker.com/r/hemmeligapp/hemmelig)
# Pinned to the newest tagged release found on Docker Hub. Note in
# UPSTREAM.md: the moving "v7"/"v7.4" tags have not advanced past this exact
# build despite continued upstream commits — see "Known limitations".
APP_TAG=v7.4.8

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Timezone ---
TZ=UTC

# --- Secrets ---
# Create the secrets directory and files:
#   mkdir -p .secrets volumes/database volumes/uploads
#
# Session/auth signing key — Hemmelig's own minimum is 32 characters:
#   openssl rand -base64 32 | tr -d '\n' > .secrets/better_auth_secret.txt
#
# HMAC secret for analytics visitor IDs. Optional upstream (it falls back to
# a predictable default with a startup warning if unset) but generated here
# by default rather than left with a default the app itself calls insecure:
#   openssl rand -base64 32 | tr -d '\n' > .secrets/analytics_hmac_secret.txt
