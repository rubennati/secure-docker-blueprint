# =============================================================================
# Shlink – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================
#
#   [compose]  Docker Compose itself — project and container names
#   [traefik]  the reverse proxy — hostnames, TLS, access, security chain
#   [image]    which image versions get pulled
#   [app]      the application's own settings
#   [secrets]  documented here, values live in .secrets/ — never in this file
#
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
# Drives container names, the internal network name and Traefik router names.
COMPOSE_PROJECT_NAME=shlink


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The host name short links are issued for — it is part of every link, so it is
# the one value that cannot change afterwards without breaking them. Short is
# the point of the exercise.
APP_TRAEFIK_HOST=s.example.com

# The web client's own host name. It serves static files only and talks to the
# API from the browser.
CLIENT_TRAEFIK_HOST=shlink.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
#   cloudflare-dns  DNS-01 — wildcards, no port 80 needed
#   httpResolver    HTTP-01 — no DNS provider needed
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS: the deployment standard (TLS_DEFAULT_OPTION in core/traefik/.env) serves
# every router that names no option. This stack names one — a documented
# exception, kept from before the model:
# tls-compatible rather than the standard: a short link is followed by whatever
# client someone happens to paste it into, including old ones. Tighten it where
# every consumer is known.
APP_TRAEFIK_TLS_OPTION=tls-compatible

# WHO may follow a short link:
#   access-public   everyone
#   access-trusted  the ranges TRUSTED_RANGES declares in core/traefik/.env; empty: nobody
#   access-vpn      VPN only
#   access-trusted-vpn  those ranges + VPN
#   access-blocked  nobody — the emergency kill switch
#
# **This is the one setting that decides what the stack is for.** Every stack in
# this repository ships restricted, and this one is no exception — but a short
# link nobody outside can follow is a link that does not work. Set access-public
# deliberately, once you have decided that this host answers the internet, and
# read the README's security section first: there are no accounts in front of a
# short link, and a redirect is a request this host serves for whoever holds the
# URL.
APP_TRAEFIK_ACCESS=access-trusted-vpn

# WHO may reach /rest — the API that creates, edits and deletes short URLs and
# reads every visit. VPN-only by default, and it stays that way even when the
# redirects above are opened: the two are separate routers for exactly this
# reason.
APP_TRAEFIK_API_ACCESS=access-vpn

# WHO may reach the web client. It holds an API key in the browser once you add
# a server to it, so it belongs behind the same policy as the API.
CLIENT_TRAEFIK_ACCESS=access-vpn

# limit-standard. A redirect is one request and the client is a small bundle;
# neither has been measured behind Traefik. See README, "Known limits".
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file


# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge


# --- Images -------------------------------------------------------- [image] --
# App images → pin major.minor.patch. Never :latest, never major-only.
# shlink (https://github.com/shlinkio/shlink/pkgs/container/shlink)
APP_TAG=5.1.8
# shlink-web-client (https://github.com/shlinkio/shlink-web-client/pkgs/container/shlink-web-client)
CLIENT_TAG=4.8.1
# postgres (https://hub.docker.com/_/postgres)
DB_TAG=18.6-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_CLIENT=${COMPOSE_PROJECT_NAME}-client


# --- Database -------------------------------------------------------- [app] --
# Non-sensitive database settings only. The password is a Docker Secret.
DB_NAME=shlink
DB_USER=shlink


# --- App Configuration ----------------------------------------------- [app] --
# Addresses Shlink accepts forwarded client addresses from, comma-separated.
# Traefik's address on the proxy network — the default Docker pool for
# user-defined networks is 172.16.0.0/12. Without it every visit is recorded as
# coming from the proxy.
SHLINK_TRUSTED_PROXIES=172.16.0.0/12


# --- Timezone -------------------------------------------------------- [app] --
# Shlink stores visit timestamps in this zone.
# Examples: UTC, Europe/Vienna, Europe/Berlin
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
#
#   mkdir -p .secrets volumes/data volumes/postgres
#
# The database password ends up inside a connection string, so hex — base64
# produces + / = which break URL parsing:
#   openssl rand -hex 32 | tr -d '\n' > .secrets/db_pwd.txt
#
# The first API key. It is created on the first start only, and it has no roles,
# which in Shlink means it may do everything. Treat it as the administrator
# credential, and create narrower keys for anything that only needs to create
# links:
#   openssl rand -hex 32 | tr -d '\n' > .secrets/initial_api_key.txt
#
# ./volumes/data must belong to uid 1001, the user the server image runs as:
#   sudo chown -R 1001:1001 volumes/data
