# =============================================================================
# Gotify – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================
#
#   [compose]  Docker Compose itself — project and container names
#   [traefik]  the reverse proxy — hostname, TLS, access, security chain
#   [image]    which image version gets pulled
#   [app]      the application's own settings
#   [secrets]  documented here, values live in .secrets/ — never in this file
#
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
# Drives container names and Traefik router names.
COMPOSE_PROJECT_NAME=gotify


# --- Domain & Traefik ------------------------------------------- [traefik] --
# Public hostname. Every client is configured with it, so changing it later
# re-points every phone and every publishing script.
APP_TRAEFIK_HOST=gotify.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
#   cloudflare-dns  DNS-01 — wildcards, no port 80 needed
#   httpResolver    HTTP-01 — no DNS provider needed
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS profile:
#   tls-basic   TLS 1.2+ — broad client compatibility
#   tls-aplus   TLS 1.2+ strict cipher set — the default for public apps
#   tls-modern  TLS 1.3 only — modern clients only
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach the server:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# VPN-only, like the rest of monitoring/. A Gotify client holds a connection to
# the server open, so every device that should receive a notification needs a
# path to this host — over the VPN here. Opening it wider is a decision about
# where the receiver lives, not a setting: monitoring/README.md, "Where the
# receiver runs". Whatever the policy, the administrator password has to be set
# before the first start; see the secrets section below.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
#   sec-2           standard default for a new app
#   sec-3           public-facing and hardened
#   *e suffix       iframe-friendly (embedded apps)
#   *-spa suffix    high burst rate limit — documented for VPN-gated apps only
#
# The web interface is one bundle rather than a code-split application, and a
# client's stream is a single long-lived request. Neither has been measured
# against the chain's rate limit; see README, "Known limits".
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — the third axis, independent of the two above.
# Empty by default: no CrowdSec bouncer on this router.
#
# To enable, name a profile from core/crowdsec/docs/profiles.md and keep the
# trailing comma — the value is prepended to the middleware list, and it has to
# come first so a banned address is rejected before anything else does work on
# the request. The @file is part of the value:
#   APP_TRAEFIK_THREAT=crowdsec-basic@file,
APP_TRAEFIK_THREAT=

# Shared proxy network, created by core/traefik. Same value in every app.
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# App image → pin major.minor.patch. Never :latest, never major-only.
# gotify/server (https://github.com/gotify/server/pkgs/container/server)
# 3.1.1 is the minimum: GHSA-phfm-q6fr-wv34 (high) is fixed there.
APP_TAG=3.1.1


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- App Configuration ----------------------------------------------- [app] --
# The user the server runs as: the owner of ./volumes/data. Create that
# directory before the first start — Docker would create it as root, and the
# server runs without the capabilities root would need to write into it.
APP_UID=1000
APP_GID=1000

# The administrator created on the first start. The password is a Docker Secret;
# see the secrets section. A later change happens in the web interface, not here.
GOTIFY_ADMIN_USER=admin

# Addresses Gotify accepts X-Forwarded-For from, comma-separated. Traefik's
# address on the proxy network — the default Docker pool for user-defined
# networks is 172.16.0.0/12. Empty means every request is logged with Traefik's
# address instead of the client's.
GOTIFY_TRUSTED_PROXIES=172.16.0.0/12


# --- Timezone -------------------------------------------------------- [app] --
# Affects log timestamps. Examples: UTC, Europe/Vienna, Europe/Berlin
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
#
#   mkdir -p .secrets volumes/data
#
# The administrator password. It is read on the first start only: once the user
# exists in the database, changing this file changes nothing, and the password
# is changed in the web interface instead. Without the file Gotify creates
# admin/admin, which is its published default.
#
#   openssl rand -base64 24 | tr -d '\n' > .secrets/gotify_admin_pass.txt
#
# ./volumes/data must belong to APP_UID:APP_GID before the first start:
#
#   sudo chown -R 1000:1000 volumes/data
