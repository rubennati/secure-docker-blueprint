# =============================================================================
# Langfuse – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=langfuse


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=langfuse.example.com


# WHO may reach the UI and the ingestion API. SDK clients send their traces to
# the same host, so this must include wherever your applications run.
#   access-public   everyone
#   access-lan      LAN only (RFC1918)
#   access-vpn      VPN only
#   access-lan-vpn  LAN + VPN
#   access-blocked  nobody — the emergency kill switch
APP_TRAEFIK_ACCESS=access-lan-vpn

# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file


TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# Langfuse web and worker (https://github.com/langfuse/langfuse)
APP_TAG=4.50.0
PG_TAG=17.6
CH_TAG=25.12
REDIS_TAG=7.4-alpine
MINIO_TAG=RELEASE.2025-09-07T16-13-09Z


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-web
CONTAINER_NAME_WORKER=${COMPOSE_PROJECT_NAME}-worker
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_CLICKHOUSE=${COMPOSE_PROJECT_NAME}-clickhouse
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis
CONTAINER_NAME_MINIO=${COMPOSE_PROJECT_NAME}-minio


# --- Data stores ------------------------------------------------------ [db] --
DB_NAME=langfuse
DB_USER=langfuse
CH_USER=langfuse
MINIO_USER=langfuse


# --- First-start provisioning --------------------------------------- [app] --
# Created once, on first start of an empty database. Changing these later does
# not change the existing organisation, project or account.
INIT_ORG_ID=main
INIT_ORG_NAME=Main
INIT_PROJECT_ID=default
INIT_PROJECT_NAME=Default
INIT_USER_EMAIL=admin@example.com

TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the files:
#
#   ops/init.sh [admin-email]
#
#   .secrets/admin_password.txt      first administrator's password
#   .secrets/project_public_key.txt  public half of the project's API key pair
#   .secrets/project_secret_key.txt  secret half of the project's API key pair
#   .secrets/salt.txt                hashes API keys — do not change afterwards
#   .secrets/encryption_key.txt      encrypts stored LLM credentials — do not change
#   .secrets/nextauth_secret.txt     signs sessions
#   .secrets/{pg,ch,redis,minio}_*   the four data stores' passwords
