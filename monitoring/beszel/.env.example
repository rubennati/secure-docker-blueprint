# =============================================
# Beszel – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=beszel

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=beszel.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# Host metrics expose system details — VPN-only default.
APP_TRAEFIK_ACCESS=access-vpn
# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# henrygd/beszel (https://github.com/henrygd/beszel/pkgs/container/beszel)
# TODO: Beszel is pre-1.0 — pin to a specific release tag for stability.
APP_TAG=0.19.0
# tecnativa/docker-socket-proxy (https://hub.docker.com/r/tecnativa/docker-socket-proxy)
SOCKET_PROXY_TAG=v0.5.0

# --- Containers ---
CONTAINER_NAME_HUB=${COMPOSE_PROJECT_NAME}-hub
CONTAINER_NAME_AGENT=${COMPOSE_PROJECT_NAME}-agent
CONTAINER_NAME_SOCKET_PROXY=${COMPOSE_PROJECT_NAME}-socket-proxy

# --- App Configuration ---
# The local agent connects OUT to the hub over the private application
# network. It opens no port and nothing is published for it.
#
# Leave AGENT_TOKEN and AGENT_KEY empty on first start. After the hub is up:
#   1. Open the UI, create the owner account
#   2. Settings → Tokens & Fingerprints → enable and copy the token
#      → AGENT_TOKEN=
#   3. "+ Add System" (top right) → copy the SSH public key shown, and paste
#      the FULL value including the "ssh-ed25519" type prefix:
#      AGENT_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA...
#      (not just the base64 part — the type prefix is required)
#   4. Run: docker compose up -d agent
AGENT_TOKEN=
AGENT_KEY=
# Name this system registers under. Set it: without it the agent registers
# under its container ID, which changes every time the container is recreated.
AGENT_SYSTEM_NAME=
# Which host network interfaces the agent reports on.
# Default (unset) is `-*` — none, because a container cannot see the host's
# network namespace and would otherwise report its OWN interface counters as
# the system's bandwidth. Host NIC statistics are therefore unavailable in
# this deployment mode, and Beszel's system Bandwidth alert cannot be used.
# Per-container network statistics are unaffected. See README.
AGENT_NICS=
# Optional: comma-separated mount points the agent should report on
# beyond the root FS. Example: /mnt/nas,/var/lib/docker
EXTRA_FILESYSTEMS=

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC
