# Beszel — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=0.18.7

# --- Hub / Agent pairing --------------------------------------------- [app] --
# Empty for the first start. Then:
#   1. http://localhost:8090 — create the owner account
#   2. "+ Add System" (top right) → name = local, host = agent, port = 45876
#   3. Copy the SSH public key shown, including the "ssh-ed25519" prefix:
#        AGENT_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA...
#   4. docker compose -f docker-compose.local.yml --env-file .env.local up -d agent
AGENT_KEY=

# Comma-separated mount points to report on beyond the root FS.
EXTRA_FILESYSTEMS=

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
