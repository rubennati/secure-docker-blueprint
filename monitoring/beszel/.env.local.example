# Beszel — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=0.19.0
SOCKET_PROXY_TAG=v0.5.0

# --- Hub / Agent pairing --------------------------------------------- [app] --
# The agent connects OUT to the hub — there is no host or port to register.
# Empty for the first start. Then:
#   1. http://localhost:8090 — create the owner account
#   2. Settings → Tokens & Fingerprints → enable it, copy the value
#   3. "+ Add System" (top right) → copy the SSH public key shown, including
#      the "ssh-ed25519" prefix
#   4. docker compose -f docker-compose.local.yml --env-file .env.local up -d
AGENT_TOKEN=
AGENT_KEY=
# Name this system registers under.
AGENT_SYSTEM_NAME=beszel-local

# Host network interfaces the agent reports on. Default (unset) is `-*` —
# none, because a container cannot see the host's network namespace and would
# otherwise report its OWN interface counters as the system's bandwidth.
AGENT_NICS=

# Comma-separated mount points to report on beyond the root FS.
EXTRA_FILESYSTEMS=

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
