# =============================================================================
# Scrutiny – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=scrutiny


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=scrutiny.example.com

APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# Scrutiny has no authentication of its own, and two of its open endpoints are
# destructive: POST /api/settings changes the instance's configuration and
# DELETE /api/device/:uuid removes a disk with its history. Two gates, then —
# this one, and the password below.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
APP_TRAEFIK_SECURITY=sec-2

APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# scrutiny (https://github.com/AnalogJ/scrutiny)
# Upstream's own examples use `nightly-*`; its README says to pin a version.
APP_TAG=v0.9.4-web
COLLECTOR_TAG=v0.9.4-collector

# InfluxDB 2.x. Pinned by digest as well as by tag: the `influxdb` tags are
# rebuilt in place, so a tag alone does not identify an image.
#
# To move it:  docker pull influxdb:<tag> && docker inspect influxdb:<tag> \
#                --format '{{index .RepoDigests 0}}'
INFLUXDB_TAG=2.8
INFLUXDB_DIGEST=sha256:af89d51080c9b4cf92b85e3899503089bc1f24c186e2a72a06dd8203a80ea33d


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-web
CONTAINER_NAME_INFLUXDB=${COMPOSE_PROJECT_NAME}-influxdb
CONTAINER_NAME_COLLECTOR=${COMPOSE_PROJECT_NAME}-collector


# --- InfluxDB ------------------------------------------------------- [app] --
# Created on the first start. The token is what Scrutiny authenticates with.
INFLUXDB_USER=scrutiny
INFLUXDB_ORG=scrutiny
INFLUXDB_BUCKET=metrics
INFLUXDB_UID=1000
INFLUXDB_GID=1000


# --- App Configuration ----------------------------------------------- [app] --
# The uid the web interface runs as. The image declares root and does not need
# it; ./volumes/scrutiny-config has to belong to this uid.
APP_UID=1000
APP_GID=1000

# When the collector reads the disks. Only used with collector.yml.
COLLECTOR_CRON_SCHEDULE=0 0 * * *


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
#
#   ops/init.sh
#
# or by hand:
#
#   mkdir -p .secrets
#   openssl rand -base64 24 | tr -d '\n' > .secrets/influxdb_password.txt
#   openssl rand -hex 32   | tr -d '\n' > .secrets/influxdb_token.txt
#   chmod 644 .secrets/*.txt && chmod 700 .secrets
#
# The InfluxDB token is a bearer credential: whoever holds it can read and
# write the bucket.


# --- The password in front of the interface -------------------------- [app] --
# Scrutiny has no login. This is a Traefik basic-auth middleware, so the value
# is an htpasswd line and it lives HERE rather than in .secrets/ — a middleware
# reads its users from the label, not from a file (secrets.md, Pattern 3).
#
# Generate it with bcrypt and DOUBLE EVERY `$`, or Compose eats them as
# variable references and the hash reaching the label is not the one you made:
#
#   htpasswd -nbB ops 'the-password' | sed -e 's/\$/\$\$/g'
#
# Check what actually arrived with `docker inspect`, not `docker compose
# config` — the latter re-escapes its own output.
APP_BASIC_AUTH_USERS=__REPLACE_ME__
