# =============================================
# Beszel Agent – Environment
# =============================================
# Standalone agent for remote hosts monitored by a central Beszel hub.
# Deploy on each additional host; the hub runs on monitoring/beszel/.
# The agent connects OUT to the hub — this host opens no inbound port.
#
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=beszel-agent

# --- Images ---
# henrygd/beszel-agent (https://github.com/henrygd/beszel/pkgs/container/beszel-agent)
# TODO: Beszel is pre-1.0 — pin to a specific release tag for stability.
# Keep in sync with the hub's APP_TAG.
APP_TAG=0.19.0
# tecnativa/docker-socket-proxy (https://hub.docker.com/r/tecnativa/docker-socket-proxy)
SOCKET_PROXY_TAG=v0.5.0

# --- Containers ---
CONTAINER_NAME_AGENT=${COMPOSE_PROJECT_NAME}
CONTAINER_NAME_SOCKET_PROXY=${COMPOSE_PROJECT_NAME}-socket-proxy

# --- App Configuration ---
# REQUIRED. The hub's address, exactly as you publish it. The agent opens an
# outbound WSS/HTTPS connection to it and registers itself; the hub never
# connects back, so this host needs no inbound port and no firewall rule.
# How that address is reachable — VPN, private network or otherwise — is your
# deployment decision; the agent only has to be able to reach it.
HUB_URL=https://beszel.example.com
# Registration token from the hub UI (Settings → Tokens & Fingerprints).
AGENT_TOKEN=
# Hub's SSH public key — from the hub UI ("+ Add System", top right).
# Paste the FULL key including the "ssh-ed25519" type prefix:
#   AGENT_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA...
# Not just the base64 portion — the type prefix is required.
# One hub key works for all agents.
AGENT_KEY=
# Name this system registers under. Set it: without it the agent registers
# under its container ID, which changes every time the container is recreated.
AGENT_SYSTEM_NAME=
# Which host network interfaces the agent reports on.
# Default (unset) is `-*` — none, because a container cannot see the host's
# network namespace and would otherwise report its OWN interface counters as
# the system's bandwidth. Host NIC statistics are therefore unavailable in
# this deployment mode, and Beszel's system Bandwidth alert cannot be used.
# Per-container network statistics are unaffected. See README.
AGENT_NICS=
# Optional: comma-separated mount points the agent should report on
# beyond the root FS. Example: /mnt/nas,/var/lib/docker
EXTRA_FILESYSTEMS=

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC
