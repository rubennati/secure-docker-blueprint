# =============================================================================
# Checkmate – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================
#
#   [compose]  Docker Compose itself — project and container names
#   [traefik]  the reverse proxy — hostname, TLS, access, security chain
#   [image]    which image version gets pulled
#   [app]      the application's own settings
#   [secrets]  documented here, values live in .secrets/ — never in this file
#
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
# Drives the container names and the Traefik router name.
COMPOSE_PROJECT_NAME=checkmate


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The host name the dashboard is reached at. It also becomes CLIENT_HOST, which
# the application requires, and which the status-page code compares a request's
# host against to decide whether it arrived on a custom domain.
APP_TRAEFIK_HOST=checkmate.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
#   cloudflare-dns  DNS-01 — wildcards, no port 80 needed
#   httpResolver    HTTP-01 — no DNS provider needed
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns


# WHO may reach it:
#   access-public   everyone
#   access-lan      LAN only (RFC1918)
#   access-vpn      VPN only
#   access-lan-vpn  LAN + VPN
#   access-blocked  nobody — the emergency kill switch
#
# A fresh instance hands ownership to whoever registers first, and the
# dashboard lists every host this installation watches — which is a map of the
# estate. VPN-only.
#
# The public status page is the one part with a different audience. It is a
# second router rather than a change of this value — see README, "Publishing a
# status page".
APP_TRAEFIK_ACCESS=access-vpn

# limit-standard. Not measured against this dashboard, which is a React
# application that loads its assets in one burst — see README, "Known limits".
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file


# Shared proxy network, created by core/traefik. Same value in every app.
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# App image → pin major.minor.patch. Never :latest, never major-only.
# checkmate (https://github.com/bluewave-labs/Checkmate)
# Upstream's own compose uses `:latest` with `pull_policy: always`.
APP_TAG=v3.12.0

# MongoDB. Upstream pins the 8.0 line.
DB_TAG=8.0.32


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db


# --- Database --------------------------------------------------------- [db] --
# These two also appear inside .secrets/db_connection_string.txt, which is what
# the application reads. ops/init.sh writes both from one password.
DB_ROOT_USER=checkmate
DB_NAME=uptime_db


# --- App Configuration ----------------------------------------------- [app] --
# error, warn, info, debug. Upstream's schema defaults to `debug`.
APP_LOG_LEVEL=info

# How long a session token stays valid, as a duration string (`7d`, `24h`).
#
# Upstream's default is `99d` and there is no refresh flow, so a stolen token
# is usable for three months. A week means signing in weekly and losing a
# stolen token in seven days. Raise it if that trade lands the other way for
# you — it is this one line.
APP_TOKEN_TTL=7d


# --- Timezone -------------------------------------------------------- [app] --
# Examples: UTC, Europe/Vienna, Europe/Berlin
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
#
# Checkmate reads every setting from the environment and has no _FILE variant,
# so config/entrypoint.sh exports these three before the image's own entrypoint
# runs.
#
# `ops/init.sh` creates all four and the data directory, and refuses to
# overwrite anything that exists. By hand:
#
#   mkdir -p .secrets
#   PW="$(openssl rand -hex 24)"
#   printf '%s' "$PW" > .secrets/db_root_pwd.txt
#   printf 'mongodb://checkmate:%s@checkmate-db:27017/uptime_db?authSource=admin' \
#       "$PW" > .secrets/db_connection_string.txt
#   openssl rand -hex 32 | tr -d '\n' > .secrets/jwt_secret.txt
#   openssl rand -base64 32 | tr -d '\n' > .secrets/encryption_key.txt
#   chmod 644 .secrets/*.txt && chmod 700 .secrets
#
# `authSource=admin` because MONGO_INITDB_ROOT_* creates the user in the admin
# database, not in the application one.
#
# ENCRYPTION_KEY must be exactly 32 bytes as padded standard base64; the
# application validates the shape and refuses to start on anything else. It
# encrypts stored Docker TLS client keys, so only Docker monitors that speak
# TLS to a daemon need it — but rotating it after those exist is a two-step
# procedure, documented in the image's own `.env.example`.
#
# JWT_SECRET signs every session token. Changing it signs everyone out.
