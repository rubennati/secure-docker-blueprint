# =============================================================================
# Zabbix – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=zabbix


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The web interface. The server itself is not routed.
APP_TRAEFIK_HOST=zabbix.example.com

APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# Zabbix' first sign-in is the built-in Admin / zabbix, which is the same on
# every installation until someone changes it — and the interface describes
# every host, service and credential the installation monitors. VPN-only.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
APP_TRAEFIK_SECURITY=sec-2

APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# zabbix (https://www.zabbix.com/documentation/7.0/)
#
# 7.0 is the long-term-support line: full support to 2027-06-30, limited
# support to 2029-06-30. 8.0 is where the features are; this is where the
# stability is.
APP_TAG=alpine-7.0.31

# PostgreSQL. Pinned to 17 because that is the client the server image ships.
DB_TAG=17.11-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-web
CONTAINER_NAME_SERVER=${COMPOSE_PROJECT_NAME}-server
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db


# --- Database --------------------------------------------------------- [db] --
DB_NAME=zabbix
DB_USER=zabbix


# --- Trapper port ----------------------------------------------------- [app] --
# Only used with trapper.yml. Where 10051/tcp is published so active agents and
# zabbix_sender can report in — see README, "Monitoring anything but this host".
#
# Bind it to one address rather than all of them where you can:
#   APP_TRAPPER_BIND=10.0.0.5:10051
APP_TRAPPER_BIND=0.0.0.0:10051


# --- Timezone -------------------------------------------------------- [app] --
# Used by the containers and as the time zone the interface renders in.
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
#
#   ops/init.sh
#
# or by hand:
#
#   mkdir -p .secrets
#   openssl rand -hex 24 | tr -d '\n' > .secrets/db_pwd.txt
#   chmod 644 .secrets/*.txt && chmod 700 .secrets
#
# All three services read POSTGRES_PASSWORD_FILE natively; no wrapper is
# needed. The server does write that password into its own configuration file
# inside the container on every start — see README, "Known limits".
#
# There is no secret for the interface: Zabbix ships the account Admin with the
# password `zabbix` and expects you to change it at the first sign-in.
