# =============================================================================
# ntfy – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Server settings are NOT here — they live in config/server.yml, so there is one
# place per setting rather than two. This file covers only what Compose and
# Traefik need.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================
#
#   [compose]  Docker Compose itself — project and container names
#   [traefik]  the reverse proxy — hostname, TLS, access, security chain
#   [image]    which image version gets pulled
#   [app]      the application's own settings
#
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
# Drives container names and Traefik router names.
COMPOSE_PROJECT_NAME=ntfy


# --- Domain & Traefik ------------------------------------------- [traefik] --
# Public hostname. Must match base-url in config/server.yml — subscribed devices
# are pinned to it, so changing it later re-points every client.
APP_TRAEFIK_HOST=ntfy.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
#   cloudflare-dns  DNS-01 — wildcards, no port 80 needed
#   httpResolver    HTTP-01 — no DNS provider needed
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS: the deployment standard (tls-standard, core/traefik/.env) serves this host —
# not tls-strict: publishers include shell scripts, routers and appliances whose
# TLS stack is older than the phone app's. tls-strict was verified with the iOS app
# (2026-09-08); choose it in core/traefik where every publisher is known.

# WHO may reach the server:
#   access-public   everyone
#   access-trusted  the ranges TRUSTED_RANGES declares in core/traefik/.env; empty: nobody
#   access-vpn      VPN only
#   access-trusted-vpn  those ranges + VPN
#   access-blocked  nobody — the emergency kill switch
#
# This policy guards the PUBLIC router only: GET on the topics named in
# NTFY_PUBLIC_TOPICS and on /v1/account — subscribing, polling, the WebSocket,
# the apps' auth check. access-public is deliberate there and deviates from the
# VPN-only default the rest of monitoring/ uses: a notification receiver has to
# be reachable from the devices that carry it, including over mobile data. A
# receiver behind the VPN only delivers while the VPN is up — the same coupling
# this stack exists to avoid. What makes it defensible is auth-default-access:
# deny-all in config/server.yml: nothing on that router answers without
# credentials. Public exposure WITHOUT that setting makes every topic
# world-readable and world-writable to anyone who guesses its name.
#
# Where every receiving device is on the tailnet anyway, access-vpn is the
# tighter choice and costs nothing.
APP_TRAEFIK_ACCESS=access-public

# The operator's side — everything the public router does not carry: the web
# app, login, account management, publishing. Traefik takes the longer rule
# first, so a POST or any other path from the internet lands here and is refused.
APP_TRAEFIK_UI_ACCESS=access-vpn

# Topics the devices may subscribe to through the public router. A regex
# alternation: alerts|backup opens a second one.
NTFY_PUBLIC_TOPICS=alerts

# limit-strict (20/s, burst 40, per client). A subscription is one long-lived
# request and an alert is one request, so the phone side has headroom; verified
# with the iOS app on 2026-09-08. A publisher bursting during an incident is
# exactly when a counter bites, so this is the first thing to check if
# notifications go missing under load — measure before switching to
# limit-standard.
APP_TRAEFIK_LIMIT=limit-strict
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file


# Shared proxy network, created by core/traefik. Same value in every app.
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# App image → pin major.minor.patch. Never :latest, never major-only.
# binwiederhier/ntfy (https://hub.docker.com/r/binwiederhier/ntfy)
APP_TAG=v2.28.0


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- App Configuration ----------------------------------------------- [app] --
# Nothing here by design. ntfy reads NTFY_* environment variables that would
# silently override config/server.yml, which is the kind of split that costs an
# hour during an incident. Every server setting stays in that file.
#
# The user the server runs as: the owner of ./config, ./volumes/cache and
# ./volumes/lib. Create those directories before the first start — as root with
# every capability dropped, the server cannot write into directories it does
# not own, and Docker would create missing ones as root.
APP_UID=1000
APP_GID=1000


# --- Timezone -------------------------------------------------------- [app] --
# Affects log timestamps only; message timestamps are stored as UTC epoch.
# Examples: UTC, Europe/Vienna, Europe/Berlin, America/New_York
TZ=UTC
