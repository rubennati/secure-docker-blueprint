# =============================================================================
# ntfy – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Server settings are NOT here — they live in config/server.yml, so there is one
# place per setting rather than two. This file covers only what Compose and
# Traefik need.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================
#
#   [compose]  Docker Compose itself — project and container names
#   [traefik]  the reverse proxy — hostname, TLS, access, security chain
#   [image]    which image version gets pulled
#   [app]      the application's own settings
#
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
# Drives container names and Traefik router names.
COMPOSE_PROJECT_NAME=ntfy


# --- Domain & Traefik ------------------------------------------- [traefik] --
# Public hostname. Must match base-url in config/server.yml — subscribed devices
# are pinned to it, so changing it later re-points every client.
APP_TRAEFIK_HOST=ntfy.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
#   cloudflare-dns  DNS-01 — wildcards, no port 80 needed
#   httpResolver    HTTP-01 — no DNS provider needed
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS profile:
#   tls-basic   TLS 1.2+ — broad client compatibility
#   tls-aplus   TLS 1.2+ strict cipher set — the default for public apps
#   tls-modern  TLS 1.3 only — modern clients only
# tls-aplus rather than tls-modern: publishers include shell scripts, routers and
# appliances whose TLS stack is older than the phone app's.
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach the server:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# acc-public is deliberate here and deviates from the VPN-only default the rest
# of monitoring/ uses: a notification receiver has to be reachable from the
# devices that carry it, including over mobile data. A receiver behind the VPN
# only delivers while the VPN is up — the same coupling this stack exists to
# avoid. What makes it defensible is auth-default-access: deny-all in
# config/server.yml. Public exposure WITHOUT that setting makes every topic
# world-readable and world-writable to anyone who guesses its name.
#
# Where every receiving device is on the tailnet anyway, acc-tailscale is the
# tighter choice and costs nothing.
APP_TRAEFIK_ACCESS=acc-public

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
#   sec-2           standard default for a new app
#   sec-3           public-facing and hardened
#   *e suffix       iframe-friendly (embedded apps)
#   *-spa suffix    high burst rate limit — documented for VPN-gated apps only
#
# sec-3 carries rl-soft. A publisher bursting during an incident is exactly when
# a rate limit bites, so this is the first thing to check if notifications go
# missing under load — measure before switching, see README "Known Issues".
APP_TRAEFIK_SECURITY=sec-3

# Shared proxy network, created by core/traefik. Same value in every app.
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# App image → pin major.minor.patch. Never :latest, never major-only.
# binwiederhier/ntfy (https://hub.docker.com/r/binwiederhier/ntfy)
APP_TAG=v2.26.3


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- App Configuration ----------------------------------------------- [app] --
# Nothing here by design. ntfy reads NTFY_* environment variables that would
# silently override config/server.yml, which is the kind of split that costs an
# hour during an incident. Every server setting stays in that file.
#
# Optional UID/GID for the commented `user:` line in docker-compose.yml. Enabling
# it requires chown'ing ./config, ./volumes/cache and ./volumes/lib to the same
# IDs first — otherwise the server starts and cannot write its databases.
#APP_UID=1000
#APP_GID=1000


# --- Timezone -------------------------------------------------------- [app] --
# Affects log timestamps only; message timestamps are stored as UTC epoch.
# Examples: UTC, Europe/Vienna, Europe/Berlin, America/New_York
TZ=UTC
