# =============================================================================
# Grafana + Prometheus – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=grafana


# --- Domain & Traefik ------------------------------------------- [traefik] --
# Grafana's address. Prometheus has no router and no host port — see README.
APP_TRAEFIK_HOST=grafana.example.com

APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# A metrics dashboard describes the installation it watches: which hosts exist,
# what runs on them, when they are busy and when they fail. VPN-only.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
#
# Grafana loads its interface in one burst and then polls. Not measured — see
# README, "Known limits".
APP_TRAEFIK_SECURITY=sec-2

APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# grafana (https://github.com/grafana/grafana)
APP_TAG=13.2.2

# prometheus (https://github.com/prometheus/prometheus)
PROMETHEUS_TAG=v3.14.0

# Only used by the overlays — see README, "Collecting from the host".
# node_exporter (https://github.com/prometheus/node_exporter)
NODE_EXPORTER_TAG=v1.12.1
# cAdvisor (https://github.com/google/cadvisor)
CADVISOR_TAG=v0.60.6


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-grafana
CONTAINER_NAME_PROMETHEUS=${COMPOSE_PROJECT_NAME}-prometheus
CONTAINER_NAME_NODE_EXPORTER=${COMPOSE_PROJECT_NAME}-node-exporter
CONTAINER_NAME_CADVISOR=${COMPOSE_PROJECT_NAME}-cadvisor


# --- App Configuration ----------------------------------------------- [app] --
# Grafana's administrator. The password is a Docker Secret.
APP_ADMIN_USER=ops

# The uids the images already run as. ./volumes/grafana must belong to the
# first, ./volumes/prometheus to the second.
APP_UID=472
APP_GID=472
PROMETHEUS_UID=65534
PROMETHEUS_GID=65534

# How long samples are kept. Prometheus deletes older blocks itself; this is
# the only thing standing between a long uptime and a full disk.
PROMETHEUS_RETENTION=30d


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
#
#   ops/init.sh
#
# or by hand:
#
#   mkdir -p .secrets
#   openssl rand -base64 24 | tr -d '\n' > .secrets/grafana_admin_password.txt
#   chmod 644 .secrets/*.txt && chmod 700 .secrets
#
# Grafana reads any GF_* variable ending in __FILE from the file it names, so
# the password needs no wrapper. Without it Grafana creates admin/admin.
#
# Prometheus has no credential: it has no authentication at all, which is why
# nothing routes to it.
