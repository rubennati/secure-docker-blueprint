# =============================================
# Secure Docker Blueprint – .gitignore
# =============================================

# -----------------------------------------
# Local working areas (never committed)
# -----------------------------------------
inbox/
archive/

# -----------------------------------------
# Host stack selection (scripts/stacks.sh; stacks.example is the template)
# -----------------------------------------
/stacks

# -----------------------------------------
# Own stacks on a host — each a checkout of its own repository
# (docs/standards/deployment-lifecycle.md, section 11)
# -----------------------------------------
/custom/

# -----------------------------------------
# Environment files (contain secrets)
# -----------------------------------------
.env
**/.env
!**/.env.example
**/.env.local
!**/.env.local.example

# -----------------------------------------
# Docker runtime data
# -----------------------------------------
**/volumes/
**/logs/
**/acme.json

# -----------------------------------------
# Secrets (passwords, tokens, keys)
# -----------------------------------------
**/secrets/
# Dot-prefixed variant — the convention every app actually uses. `**/secrets/`
# does NOT match `.secrets/`, so this line is what protects them repo-wide.
**/.secrets/

# -----------------------------------------
# OS and editor files
# -----------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# -----------------------------------------
# Tool state (Claude Code, AI assistants)
# -----------------------------------------
.claude/

# Python
__pycache__/
*.pyc
