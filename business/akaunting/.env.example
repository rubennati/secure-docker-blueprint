# =============================================================================
# Akaunting – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=akaunting


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=accounting.example.com

# TLS profile — see docs/standards/traefik-security.md.
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it.
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# VPN-only by default, deliberately: until ops/install.sh has run, the web
# installer is reachable and takes whatever database it is given.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply — see docs/standards/traefik-security.md.
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — empty by default: no CrowdSec bouncer on this router.
# See core/crowdsec/docs/profiles.md to enable one; keep the trailing comma.
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# Akaunting (https://hub.docker.com/r/akaunting/akaunting)
APP_TAG=3.1.21
# MariaDB LTS
DB_TAG=11.4


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db


# --- Database -------------------------------------------------------- [db] --
DB_NAME=akaunting
DB_USER=akaunting
# Table prefix the installer applies.
DB_PREFIX=ak_


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the files:
#
#   ops/init.sh
#
#   .secrets/db_pwd.txt        MariaDB application user
#   .secrets/db_root_pwd.txt   MariaDB root
#   .secrets/admin_pwd.txt     first administrator, read once by ops/install.sh
#
# The application key the installer generates lives in volumes/app.env. Back it
# up with the database: stored data encrypted with it is unreadable without it.
