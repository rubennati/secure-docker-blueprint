# Kimai — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=apache-2.61.0
DB_TAG=11.4

# --- Database -------------------------------------------------------- [app] --
DB_NAME=kimai
DB_USER=kimai
# openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__
# openssl rand -hex 32
DB_ROOT_PASSWORD=__REPLACE_ME__

# --- App secret ------------------------------------------------------ [app] --
# openssl rand -hex 32
APP_SECRET=__REPLACE_ME__

# --- First-boot admin ------------------------------------------------ [app] --
ADMIN_EMAIL=admin@example.com
# openssl rand -base64 16 | tr -d '\n'
ADMIN_PASSWORD=__REPLACE_ME__

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
