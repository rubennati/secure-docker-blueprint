# Kimai — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=2.71.0
DB_TAG=11.4.13

# --- Database -------------------------------------------------------- [app] --
DB_NAME=kimai
DB_USER=kimai
# openssl rand -hex 32
DB_PASSWORD=
# openssl rand -hex 32
DB_ROOT_PASSWORD=

# --- App secret ------------------------------------------------------ [app] --
# openssl rand -hex 32
APP_SECRET=

# --- First-boot admin ------------------------------------------------ [app] --
ADMIN_EMAIL=admin@example.com
# openssl rand -base64 16 | tr -d '\n'
ADMIN_PASSWORD=

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
