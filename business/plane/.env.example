# =============================================================================
# Plane Community Edition – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=plane


# --- Domain & Traefik ------------------------------------------- [traefik] --
# One host name for all six interfaces: Plane's own proxy routes /, /spaces,
# /god-mode, /api and the uploads behind it. It also becomes WEB_URL and the
# CORS origin, so it has to be the address browsers actually use.
APP_TRAEFIK_HOST=plane.example.com

APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# WHO may reach it:
#   access-public   everyone
#   access-lan      LAN only (RFC1918)
#   access-vpn      VPN only
#   access-lan-vpn  LAN + VPN
#   access-blocked  nobody — the emergency kill switch
#
# **The first visitor to /god-mode becomes the instance administrator**, and
# sign-up is open until that administrator closes it. VPN-only, and claim it
# immediately — see README.
APP_TRAEFIK_ACCESS=access-vpn

# Plane is a code-split single-page application: its first load is hundreds of
# requests. limit-standard (burst 500) has not been measured against it; the two
# stacks that were measured — Twenty and Windmill — both needed
# limit-extra-large. Start here and read README, "Known limits", before opening
# the router.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# plane (https://github.com/makeplane/plane)
# Six application images share this tag. 1.4.0 fixed six critical advisories
# published on 2026-08-03; do not run older.
APP_TAG=v1.4.2

# PostgreSQL — the 15 line upstream tests against, at its newest patch rather
# than the 2024 build upstream's compose names.
DB_TAG=15.19-alpine

# Valkey and RabbitMQ, likewise newest patch of upstream's line.
REDIS_TAG=7.2.14-alpine
MQ_TAG=3.13.7-management-alpine

# MinIO. Upstream's compose names `minio/minio:latest` — that Docker Hub
# repository **no longer exists**, so the stack would not start as published.
# This is the same image `monitoring/langfuse` pins, from quay.io.
MINIO_TAG=RELEASE.2025-09-07T16-13-09Z


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_PROXY=${COMPOSE_PROJECT_NAME}-proxy
CONTAINER_NAME_WEB=${COMPOSE_PROJECT_NAME}-web
CONTAINER_NAME_SPACE=${COMPOSE_PROJECT_NAME}-space
CONTAINER_NAME_ADMIN=${COMPOSE_PROJECT_NAME}-admin
CONTAINER_NAME_LIVE=${COMPOSE_PROJECT_NAME}-live
CONTAINER_NAME_API=${COMPOSE_PROJECT_NAME}-api
CONTAINER_NAME_WORKER=${COMPOSE_PROJECT_NAME}-worker
CONTAINER_NAME_BEAT=${COMPOSE_PROJECT_NAME}-beat-worker
CONTAINER_NAME_MIGRATOR=${COMPOSE_PROJECT_NAME}-migrator
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis
CONTAINER_NAME_MQ=${COMPOSE_PROJECT_NAME}-mq
CONTAINER_NAME_MINIO=${COMPOSE_PROJECT_NAME}-minio


# --- Database and queue ----------------------------------------------- [db] --
# These also appear inside the connection URLs in .secrets/, which ops/init.sh
# assembles from them.
DB_NAME=plane
DB_USER=plane
MQ_USER=plane
MQ_VHOST=plane


# --- Object storage --------------------------------------------------- [app] --
S3_BUCKET=uploads
MINIO_UID=1000
MINIO_GID=1000

# The uid the backend and live services run as. Every Plane image declares
# root; the backend does not need it, because the image makes /code
# world-writable. ./volumes/logs has to belong to this uid.
APP_UID=1000
APP_GID=1000
REDIS_UID=1000
REDIS_GID=1000


# --- App Configuration ----------------------------------------------- [app] --
# gunicorn workers for the API. Upstream ships 1.
APP_GUNICORN_WORKERS=1

# Rate limit for API-key requests, upstream's own format.
APP_API_KEY_RATE_LIMIT=60/minute

# Largest upload, in bytes. Upstream ships 5 MiB.
APP_FILE_SIZE_LIMIT=5242880

# Where webhooks may be sent. **Empty means anywhere** — a webhook is an
# outbound request the application makes on a user's behalf, so a list of the
# hosts you actually integrate with is worth writing:
#   APP_WEBHOOK_ALLOWED_HOSTS=hooks.example.com,ci.example.com
APP_WEBHOOK_ALLOWED_IPS=
APP_WEBHOOK_ALLOWED_HOSTS=


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
#
#   ops/init.sh
#
# writes all eight and assembles the two connection URLs from the names above.
#
# Plane reads every setting from the environment and has **no `_FILE` variant
# for any of them**, so config/entrypoint.sh exports them — the same wrapper is
# mounted into the four backend services and the live server.
#
# What upstream ships as defaults, and what these replace:
#
#   POSTGRES_PASSWORD        `plane`
#   RABBITMQ_DEFAULT_PASS    `plane`
#   AWS_ACCESS_KEY_ID        `access-key`
#   AWS_SECRET_ACCESS_KEY    `secret-key`
#   SECRET_KEY               unset, and Django refuses to start without it
#
# SECRET_KEY signs sessions and password-reset links: changing it signs
# everyone out. LIVE_SERVER_SECRET_KEY is how the API and the live server
# authenticate to each other.
