# =============================================================================
# Plausible Community Edition – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================
#
#   [compose]  Docker Compose itself — project and container names
#   [traefik]  the reverse proxy — hostname, TLS, access, security chain
#   [image]    which image version gets pulled
#   [app]      the application's own settings
#   [secrets]  documented here, values live in .secrets/ — never in this file
#
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
# Drives the container names and the Traefik router name.
COMPOSE_PROJECT_NAME=plausible


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The host name the dashboard and the tracking script are served from. It also
# becomes BASE_URL, which Plausible puts into the snippet it hands you and into
# every link in its mails — so it has to be the address browsers actually use.
APP_TRAEFIK_HOST=plausible.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
#   cloudflare-dns  DNS-01 — wildcards, no port 80 needed
#   httpResolver    HTTP-01 — no DNS provider needed
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS profile:
#   tls-basic   TLS 1.2+ — broad client compatibility
#   tls-aplus   TLS 1.2+ strict cipher set — the default for public apps
#   tls-modern  TLS 1.3 only — modern clients only
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# **Read this before changing it.** Plausible serves two different things on
# one host name: the dashboard, which is yours, and `/js/script.js` plus
# `/api/event`, which every visitor's browser has to reach. VPN-only means no
# measurement from anywhere else — which is the right setting while the first
# account is created and for an intranet site, and the wrong one for a public
# website. Opening it up is a two-router change, not a change of this value —
# see README, "Splitting the dashboard from the tracker".
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
#   sec-2           standard default for a new app
#   sec-3           public-facing and hardened
#   *e suffix       iframe-friendly (embedded apps)
#   *-spa suffix    high burst rate limit — documented for VPN-gated apps only
#
# Not measured against this application's dashboard — see README, "Known
# limits". A rate limit on the tracker endpoint is a different question again,
# because there one request per visitor is the normal case.
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — the third axis, independent of the two above.
# Empty by default: no CrowdSec bouncer on this router.
#
# To enable, name a profile from core/crowdsec/docs/profiles.md and keep the
# trailing comma — the value is prepended to the middleware list, and it has to
# come first so a banned address is rejected before anything else does work on
# the request. The @file is part of the value:
#   APP_TRAEFIK_THREAT=crowdsec-basic@file,
APP_TRAEFIK_THREAT=

# Shared proxy network, created by core/traefik. Same value in every app.
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# App image → pin major.minor.patch. Never :latest, never major-only.
# plausible community edition (https://github.com/plausible/community-edition)
APP_TAG=v3.2.1

# PostgreSQL — accounts, sites and settings.
DB_TAG=18.6-alpine

# ClickHouse — the event store.
#
# Upstream's compose pins 24.12, a release from December 2024 that is out of
# support. Upstream's own CI runs 25.11, so the 24.12 pin is stale rather than
# a requirement. This is a current release, verified against the migrations and
# an ingested event — see UPSTREAM.md.
CLICKHOUSE_TAG=26.8.10.6-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_EVENTS_DB=${COMPOSE_PROJECT_NAME}-events-db


# --- Database --------------------------------------------------------- [db] --
# These two also appear inside .secrets/database_url.txt, which is the value
# Plausible reads. ops/init.sh writes both from one password.
DB_NAME=plausible
DB_USER=plausible


# --- App Configuration ----------------------------------------------- [app] --
# notice (upstream's default for CE), info, warning, error.
APP_LOG_LEVEL=notice


# --- Timezone -------------------------------------------------------- [app] --
# Examples: UTC, Europe/Vienna, Europe/Berlin
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
#
# Plausible reads each setting from /run/secrets/<NAME> before it looks at the
# environment — `CONFIG_DIR`, whose default is `/run/secrets`. So a Docker
# Secret named after the variable is read natively: no _FILE suffix, no
# entrypoint wrapper. The secret NAMES in docker-compose.yml are therefore the
# variable names, and changing one breaks the setting.
#
# `ops/init.sh` creates all five and the volume directories, and refuses to
# overwrite anything that exists. By hand:
#
#   mkdir -p .secrets
#   PW="$(openssl rand -hex 24)"
#   printf '%s' "$PW" > .secrets/db_pwd.txt
#   printf 'postgres://plausible:%s@plausible-db:5432/plausible' "$PW" \
#       > .secrets/database_url.txt
#   printf 'http://plausible-events-db:8123/plausible_events_db' \
#       > .secrets/clickhouse_database_url.txt
#   openssl rand -base64 48 | tr -d '\n' > .secrets/secret_key_base.txt
#   openssl rand -base64 32 | tr -d '\n' > .secrets/totp_vault_key.txt
#   chmod 644 .secrets/*.txt && chmod 700 .secrets
#
# SECRET_KEY_BASE must be at least 64 bytes and TOTP_VAULT_KEY exactly 32
# bytes base64-encoded; the application refuses to start otherwise.
#
# **TOTP_VAULT_KEY encrypts the two-factor secrets.** Lose it and every account
# with 2FA enabled is locked out. Keep a copy off this host.
#
# The ClickHouse URL carries no password: that server has no user set up, is on
# an internal network and publishes no port. See README, "Security model".
#
# The volume directories must belong to the uids the images run as:
#   sudo chown -R 999:999 volumes/plausible
