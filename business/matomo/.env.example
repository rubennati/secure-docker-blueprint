# =============================================
# Matomo – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=matomo

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=analytics.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_ACCESS=access-public
# limit-standard. Headers, measured 2026-10-18: Matomo sends a CSP,
# X-Frame-Options per endpoint — deny on the
# reporting UI, absent on the Widgetize endpoints that exist to be embedded —
# and a same-origin referrer policy. The proxy adds the HSTS base, nosniff and
# the Permissions-Policy (header-nosniff and header-permissions in
# docker-compose.yml) and no frame header, so Matomo's own decides.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-application-owned
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# matomo (https://hub.docker.com/_/matomo)
APP_TAG=5.13.0-apache
# mariadb (https://hub.docker.com/_/mariadb)
DB_TAG=11.4

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db

# --- Database ---
DB_NAME=matomo
DB_USER=matomo
# Table prefix — NEVER leave as "matomo_" in a shared DB. Keep "mtm_"
# or any other short prefix. Changing after first setup requires an
# in-place table rename.
DB_TABLES_PREFIX=mtm_

# --- PHP ---
# Matomo's tracking endpoint can spike memory on large batch imports.
# 256 MB is a safe default; raise to 512 MB for heavy traffic sites.
PHP_MEMORY_LIMIT=256M

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/London, America/New_York
TZ=UTC
