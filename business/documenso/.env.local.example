# =============================================
# Documenso – LOCAL test env  (docker-compose.local.yml)
# =============================================
# Copy to .env.local and fill in. LOCAL ONLY.
#   cp .env.local.example .env.local
# =============================================

APP_TAG=v2.15.0
DB_TAG=16-alpine

# --- Database (HEX password — URL-safe) ---
DB_NAME=documenso
DB_USER=documenso
# openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__

# --- App secrets (plain env for local) ---
# openssl rand -base64 32 | tr -d '\n'
NEXTAUTH_SECRET=__REPLACE_ME__
ENCRYPTION_KEY=__REPLACE_ME__
ENCRYPTION_SECONDARY_KEY=__REPLACE_ME__

# --- Signing certificate ---
# Generate .secrets/cert.p12 with a passphrase (see .env.example), then set the same here:
SIGNING_PASSPHRASE=__REPLACE_ME__

# --- Timezone ---
TZ=Europe/Vienna
