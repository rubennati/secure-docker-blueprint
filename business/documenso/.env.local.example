# Documenso — local
#
#   cp .env.local.example .env.local

APP_TAG=v2.15.0
DB_TAG=16-alpine

# --- Database ---
DB_NAME=documenso
DB_USER=documenso
# openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__

# --- App secrets ---
# openssl rand -base64 32 | tr -d '\n'
NEXTAUTH_SECRET=__REPLACE_ME__
ENCRYPTION_KEY=__REPLACE_ME__
ENCRYPTION_SECONDARY_KEY=__REPLACE_ME__

# --- Signing certificate ---
# openssl rand -hex 16
SIGNING_PASSPHRASE=__REPLACE_ME__

# --- Timezone ---
TZ=Europe/Vienna
