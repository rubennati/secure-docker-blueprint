# Documenso — local
#
#   cp .env.local.example .env.local

APP_TAG=v2.21.1
DB_TAG=16.15-alpine

# --- Database ---
DB_NAME=documenso
DB_USER=documenso
# openssl rand -hex 32
DB_PASSWORD=

# --- App secrets ---
# openssl rand -base64 32 | tr -d '\n'
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
ENCRYPTION_SECONDARY_KEY=

# --- Signing certificate ---
# openssl rand -hex 16
SIGNING_PASSPHRASE=

# --- Timezone ---
TZ=Europe/Vienna
