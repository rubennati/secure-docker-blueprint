# =============================================
# Documenso – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# Documenso is an open-source document-signing platform (DocuSign alternative).
# =============================================

COMPOSE_PROJECT_NAME=documenso

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=sign.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
APP_TRAEFIK_ACCESS=acc-public
APP_TRAEFIK_SECURITY=sec-3
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# documenso/documenso (https://hub.docker.com/r/documenso/documenso)
# Pin a specific release, never :latest. Digest-pin for immutability (see apps/caldiy).
APP_TAG=v2.15.0
# postgres (https://hub.docker.com/_/postgres)
DB_TAG=16-alpine

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db

# --- Database ---
DB_NAME=documenso
DB_USER=documenso

# --- SMTP ---
SMTP_FROM_NAME=Documenso
SMTP_FROM_ADDRESS=documenso@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna
TZ=UTC

# --- Secrets ---
# Create the secrets directory and generate all required files:
#   mkdir -p .secrets volumes/postgres
#   openssl rand -hex 32 > .secrets/db_pwd.txt                          # hex = URL-safe for the DB URL
#   openssl rand -base64 32 | tr -d '\n' > .secrets/nextauth_secret.txt
#   openssl rand -base64 32 | tr -d '\n' > .secrets/encryption_key.txt           # min 32 chars
#   openssl rand -base64 32 | tr -d '\n' > .secrets/encryption_secondary_key.txt # min 32 chars
#   touch .secrets/smtp_password.txt                                    # write SMTP password (optional)
#
# Signing certificate — Documenso ships none; generate a self-signed .p12:
#   openssl req -x509 -newkey rsa:4096 -keyout /tmp/k.pem -out /tmp/c.pem -days 3650 -nodes -subj "/CN=Documenso"
#   PASS="$(openssl rand -hex 16)"; printf '%s' "$PASS" > .secrets/signing_passphrase.txt
#   openssl pkcs12 -export -out .secrets/cert.p12 -inkey /tmp/k.pem -in /tmp/c.pem -passout pass:"$PASS"
#   rm /tmp/k.pem /tmp/c.pem
