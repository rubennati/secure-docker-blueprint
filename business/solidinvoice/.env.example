# =============================================================================
# SolidInvoice – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=solidinvoice


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=invoices.example.com

# TLS profile — see docs/standards/traefik-security.md.
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it.
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# VPN-only by default, deliberately: until the web installer has run, whoever
# reaches /install sets up the instance and its administrator.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply — see docs/standards/traefik-security.md.
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — empty by default: no CrowdSec bouncer on this router.
# See core/crowdsec/docs/profiles.md to enable one; keep the trailing comma.
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# SolidInvoice (https://hub.docker.com/r/solidinvoice/solidinvoice)
APP_TAG=3.0.1


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- Application ----------------------------------------------------- [app] --
# Owner of volumes/config. The image would otherwise run as root.
APP_UID=1000
APP_GID=1000


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION, and no files either: the installer generates the
# application's secret and stores it, encrypted, in volumes/config with the
# database. Back up that directory as a whole.
