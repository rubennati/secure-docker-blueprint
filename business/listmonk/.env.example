# =============================================
# Listmonk – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=listmonk

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=newsletter.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# Closed until the owner exists: the first visit to /admin creates the super
# admin, whoever makes it (final audit FA-01). Create the account and set the
# SMTP server over the VPN, then open the subscriber paths — /subscription/*,
# /link/*, /campaign/* — with access-public, ideally with the admin UI kept
# VPN-only by a second router (README, "Access split").
APP_TRAEFIK_ACCESS=access-vpn
# limit-standard. Headers: headers-standard with frame-self before it in
# docker-compose.yml — the campaign/template preview renders in an iframe
# inside the admin UI.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file
# The network Traefik reaches this stack on: <project>-edge is the stack's own
# edge network — list it in core/traefik/.env EDGE_NETWORKS; proxy-public is the
# shared network, where every member reaches every other (docs/standards/networking.md).
TRAEFIK_NETWORK=${COMPOSE_PROJECT_NAME}-edge

# --- Images ---
APP_TAG=v6.2.0
DB_TAG=18-alpine

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
# The user listmonk runs as (no root); owns volumes/uploads.
APP_UID=1000
APP_GID=1000

# --- Database ---
DB_NAME=listmonk
DB_USER=listmonk
# Listmonk reads LISTMONK_db__password from env only (no _FILE support).
DB_PWD_INLINE=__REPLACE_ME__

# --- Admin ---
# In v6+, the super admin is created via the web UI on first visit.
# No ADMIN_USER / ADMIN_PASSWORD env vars needed.

# --- Timezone ---
TZ=UTC
