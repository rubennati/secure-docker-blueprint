# =============================================
# Zammad – Environment
# =============================================
COMPOSE_PROJECT_NAME=zammad

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=support.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
APP_TRAEFIK_ACCESS=acc-public
APP_TRAEFIK_SECURITY=sec-3
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# 7.2 rather than 7.1: the 7.1 image carried nine CRITICAL findings and this one
# carries one, CVE-2026-82717 (`libunbound8`, remote code execution) among those
# that went. It crosses a minor version, so read upstream's release notes before
# moving an existing installation — Zammad runs its migrations at start.
APP_TAG=7.2.0-0004
DB_TAG=16-alpine
REDIS_TAG=7.4-alpine
MEMCACHED_TAG=1.6.41
# Zammad 7.x requires Elasticsearch 8.x.
# Official Elastic registry image — Bitnami is no longer freely available.
# Verify latest 8.x: https://www.elastic.co/downloads/past-releases#elasticsearch
ES_TAG=8.17.4

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-nginx
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis
CONTAINER_NAME_MEMCACHED=${COMPOSE_PROJECT_NAME}-memcached
CONTAINER_NAME_ES=${COMPOSE_PROJECT_NAME}-elasticsearch

# --- Database ---
DB_NAME=zammad_production
DB_USER=zammad
# Zammad Rails reads POSTGRESQL_PASS from env only (no _FILE support).
DB_PWD_INLINE=__REPLACE_ME__

# --- Timezone ---
TZ=UTC
