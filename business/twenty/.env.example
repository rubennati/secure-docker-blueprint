# =============================================================================
# Twenty – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=twenty


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=crm.example.com


# WHO may reach it.
#   access-public   everyone
#   access-lan      LAN only (RFC1918)
#   access-vpn      VPN only
#   access-lan-vpn  LAN + VPN
#   access-blocked  nobody — the emergency kill switch
#
# VPN-only by default, deliberately: until the first account exists, whoever
# reaches the sign-up page creates the workspace — see README.
APP_TRAEFIK_ACCESS=access-vpn

# limit-extra-large: the interface's first load issues over 500 requests, and
# its assets carry max-age=0, so every later load repeats them; the bucket of
# 1000 holds all of them — measured. CI accepts it only behind a closed access
# policy.
APP_TRAEFIK_LIMIT=limit-extra-large
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file


TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# Twenty (https://hub.docker.com/r/twentycrm/twenty)
APP_TAG=v2.41.0
# PostgreSQL — upstream's compose runs the 16 line
DB_TAG=16.14
REDIS_TAG=7.4-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-server
CONTAINER_NAME_WORKER=${COMPOSE_PROJECT_NAME}-worker
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis


# --- Database -------------------------------------------------------- [db] --
DB_NAME=twenty
DB_USER=twenty


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the files:
#
#   ops/init.sh
#
#   .secrets/db_pwd.txt           PostgreSQL
#   .secrets/redis_pwd.txt        Redis
#   .secrets/encryption_key.txt   encrypts connection credentials stored in the
#                                 database — keep it, and never change it without
#                                 upstream's rotation procedure
