# Invoice Ninja — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=5.13.26
MYSQL_TAG=8.4
REDIS_TAG=8.6-alpine
NGINX_TAG=1.29-alpine

# --- Application ----------------------------------------------------- [app] --
APP_DEBUG=false
#   docker run --rm invoiceninja/invoiceninja-debian:5.13.26 \
#     php artisan key:generate --show | tr -d '\n'
APP_KEY=__REPLACE_ME__

# --- Database -------------------------------------------------------- [app] --
DB_DATABASE=ninja
DB_USERNAME=ninja
# openssl rand -base64 32 | tr -d '\n'
DB_PASSWORD=__REPLACE_ME__
# openssl rand -base64 32 | tr -d '\n'
DB_ROOT_PASSWORD=__REPLACE_ME__

# --- Cache / queue / sessions ---------------------------------------- [app] --
# openssl rand -hex 32
REDIS_PASSWORD=__REPLACE_ME__

# --- First-start admin account --------------------------------------- [app] --
IN_USER_EMAIL=admin@example.com
# openssl rand -base64 24 | tr -d '\n'
IN_PASSWORD=__REPLACE_ME__

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
