# Invoice Ninja — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=5.13.53
MYSQL_TAG=8.4.13
REDIS_TAG=8.10.3-alpine
NGINX_TAG=1.31.8-alpine-slim

# --- Application ----------------------------------------------------- [app] --
APP_DEBUG=false
#   docker run --rm invoiceninja/invoiceninja-debian:5.13.53 \
#     php artisan key:generate --show | tr -d '\n'
APP_KEY=

# --- Database -------------------------------------------------------- [app] --
DB_DATABASE=ninja
DB_USERNAME=ninja
# openssl rand -base64 32 | tr -d '\n'
DB_PASSWORD=
# openssl rand -base64 32 | tr -d '\n'
DB_ROOT_PASSWORD=

# --- Cache / queue / sessions ---------------------------------------- [app] --
# openssl rand -hex 32
REDIS_PASSWORD=

# --- First-start admin account --------------------------------------- [app] --
IN_USER_EMAIL=admin@example.com
# openssl rand -base64 24 | tr -d '\n'
IN_PASSWORD=

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
