# =============================================
# Invoice Ninja – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# SECURITY: .env holds plaintext secrets.
# Invoice Ninja / Laravel has no _FILE support for most variables.
# See UPSTREAM.md for the accepted deviation and future plan.
# =============================================

COMPOSE_PROJECT_NAME=invoiceninja

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=invoice.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# TLS profile: tls-basic (TLS 1.2+), tls-aplus (TLS 1.2 strict), tls-modern (TLS 1.3 only)
APP_TRAEFIK_TLS_OPTION=tls-aplus
# Access: acc-public, acc-local, acc-tailscale, acc-private, acc-deny
APP_TRAEFIK_ACCESS=acc-tailscale
# Security: sec-0 (none) to sec-5 (maximum)
APP_TRAEFIK_SECURITY=sec-3
TRAEFIK_NETWORK=proxy-public

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_NGINX=${COMPOSE_PROJECT_NAME}-nginx
CONTAINER_NAME_MYSQL=${COMPOSE_PROJECT_NAME}-mysql
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis

# --- Images ---
# invoiceninja-debian (https://hub.docker.com/r/invoiceninja/invoiceninja-debian)
APP_TAG=5.13.24
# mysql (https://hub.docker.com/_/mysql)
MYSQL_TAG=8.4
# redis (https://hub.docker.com/_/redis)
REDIS_TAG=8.6-alpine
# nginx (https://hub.docker.com/_/nginx)
NGINX_TAG=1.29-alpine

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Invoice Ninja (App) ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://${APP_TRAEFIK_HOST}
REQUIRE_HTTPS=true

# TRUSTED_PROXIES: set to the Traefik container IP or internal network CIDR
# for strictest security. Wildcard (*) is accepted for single-host deployments
# where Traefik is the only path to the app, but is a known deviation.
TRUSTED_PROXIES=*

# Generate before first boot (no container required):
#   APP_KEY="base64:$(openssl rand -base64 32)"
#   sed -i "s|^APP_KEY=.*|APP_KEY=${APP_KEY}|" .env
# CRITICAL: Set before docker compose up. Never change after data exists — it encrypts
# stored payment tokens and gateway credentials.
APP_KEY=__REPLACE_ME__

PHANTOMJS_PDF_GENERATION=false
PDF_GENERATOR=snappdf

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
# Empty = no Redis password. Redis is on the internal-only network and not externally exposed.
# To enable auth: set a password here and add --requirepass to the redis service command.
REDIS_PASSWORD=
REDIS_PORT=6379

FILESYSTEM_DISK=debian_docker
IS_DOCKER=true
SCOUT_DRIVER=null
NINJA_ENVIRONMENT=selfhost

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ninja
DB_USERNAME=ninja

# --- First-boot Admin Account ---
# Used only on first startup to create the initial user.
# Remove or blank these after first boot (the account is already created in the DB).
IN_USER_EMAIL=admin@example.com

# --- Mail ---
# Leave MAIL_HOST empty or set MAIL_MAILER=log to disable outgoing email.
# Used for: invoices, quotes, reminders, payment receipts.
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=invoices@example.com
MAIL_FROM_NAME=Invoice Ninja

# --- Passwords & Keys ---
# DEVIATION: Passwords are in .env because Laravel has no _FILE support.
# The .env file is gitignored and must never be committed.
#
# Generate DB passwords:
#   openssl rand -base64 32 | tr -d '\n'
DB_PASSWORD=__REPLACE_ME__
DB_ROOT_PASSWORD=__REPLACE_ME__

# Initial admin password — used only on first boot.
IN_PASSWORD=__REPLACE_ME__
