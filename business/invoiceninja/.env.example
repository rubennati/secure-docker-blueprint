# =============================================
# Invoice Ninja – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# No passwords in this file. Every credential is a Docker Secret; see the
# Secrets section at the bottom.
# =============================================

COMPOSE_PROJECT_NAME=invoiceninja

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=invoice.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# TLS profile: tls-basic (TLS 1.2+), tls-aplus (TLS 1.2 strict), tls-modern (TLS 1.3 only)
APP_TRAEFIK_TLS_OPTION=tls-aplus
# Access: acc-public, acc-local, acc-tailscale, acc-private, acc-deny
APP_TRAEFIK_ACCESS=acc-tailscale
# Security: sec-0 (none) to sec-5 (maximum)
APP_TRAEFIK_SECURITY=sec-3
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# invoiceninja-debian (https://hub.docker.com/r/invoiceninja/invoiceninja-debian)
APP_TAG=5.13.26
# mysql (https://hub.docker.com/_/mysql)
MYSQL_TAG=8.4
# redis (https://hub.docker.com/_/redis)
REDIS_TAG=8.6-alpine
# nginx (https://hub.docker.com/_/nginx)
NGINX_TAG=1.29-alpine

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_NGINX=${COMPOSE_PROJECT_NAME}-nginx
CONTAINER_NAME_MYSQL=${COMPOSE_PROJECT_NAME}-mysql
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis

# --- Invoice Ninja (App) ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://${APP_TRAEFIK_HOST}
REQUIRE_HTTPS=true

# TRUSTED_PROXIES: set to the Traefik container IP or internal network CIDR
# for strictest security. Wildcard (*) is accepted for single-host deployments
# where Traefik is the only path to the app, but is a known deviation.
TRUSTED_PROXIES=*

PDF_GENERATOR=snappdf

# --- Database ---
DB_DATABASE=ninja
DB_USERNAME=ninja

# --- First-boot Admin Account ---
# Used only on first startup to create the initial user.
# Remove or blank these after first boot (the account is already created in the DB).
IN_USER_EMAIL=admin@example.com

# --- Mail ---
# Not optional here: invoices, quotes, reminders and payment receipts all leave
# the system by mail, and so does the password reset. Configure it during setup.
#
# MAIL_FROM_ADDRESS is the full address — Laravel differs from Nextcloud, which
# takes only the part before the @. It must be a sender your provider has
# verified, with SPF, DKIM and DMARC in place.
#
# Transport: `ssl` on port 465 is encrypted from the first byte. `tls` on 587
# starts in the clear and upgrades, which an attacker on the path can strip.
# Prefer 465, but many hosting companies block it outbound — check first:
#
#   openssl s_client -connect smtp.example.com:465 -brief </dev/null
#
# CONNECTION ESTABLISHED means it is open. If it hangs or is refused, use
# MAIL_PORT=587 with MAIL_ENCRYPTION=tls instead.
#
# MAIL_MAILER=log writes mail to the application log instead of sending it.
# Useful while testing so nothing reaches a real client; it is not a setting to
# leave in place.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=your-smtp-login
MAIL_FROM_ADDRESS=invoices@example.com
MAIL_FROM_NAME=Invoice Ninja

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# Create all six files before the first start.
#
#   mkdir -p .secrets
#   openssl rand -base64 32 | tr -d '\n' > .secrets/db_pwd.txt
#   openssl rand -base64 32 | tr -d '\n' > .secrets/db_root_pwd.txt
#   openssl rand -hex 32    | tr -d '\n' > .secrets/redis_pwd.txt
#   openssl rand -base64 24 | tr -d '\n' > .secrets/in_pwd.txt
#   printf 'your-smtp-password'          > .secrets/mail_pwd.txt
#   chmod 600 .secrets/*.txt
#
# The application key comes from the application, not from openssl — Laravel
# expects the `base64:` prefix its own generator produces:
#
#   docker run --rm invoiceninja/invoiceninja-debian:${APP_TAG} \
#     php artisan key:generate --show | tr -d '\n' > .secrets/app_key.txt
#
# NEVER change it once data exists. It encrypts stored payment tokens and
# gateway credentials, and they become unreadable.
#
# in_pwd.txt is the first administrator's password, used on the first start
# only. Read it once, store it, then change it in the interface.
#
# Keep `tr -d '\n'` throughout — a trailing newline breaks authentication.
#
# Rotating one: editors save by replacing the file, and the container's mount
# still points at the one that was replaced. Recreate rather than restart:
#   docker compose up -d --force-recreate app
