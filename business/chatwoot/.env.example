# =============================================================================
# Chatwoot – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=chatwoot


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The dashboard, the API and the website widget are all served from this host.
APP_TRAEFIK_HOST=support.example.com


# WHO may reach it.
#   access-public   everyone
#   access-trusted  the ranges TRUSTED_RANGES declares in core/traefik/.env; empty: nobody
#   access-vpn      VPN only
#   access-trusted-vpn  those ranges + VPN
#   access-blocked  nobody — the emergency kill switch
#
# VPN-only by default, deliberately: until the first visit has created the
# administrator, whoever reaches the site does it. A website live-chat widget
# eventually needs a wider policy — see the README.
APP_TRAEFIK_ACCESS=access-vpn

# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file


TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# Chatwoot (https://hub.docker.com/r/chatwoot/chatwoot)
APP_TAG=v4.18.0
# PostgreSQL 16 with pgvector, as upstream's production compose
DB_TAG=0.8.1-pg16
REDIS_TAG=7.4-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-rails
CONTAINER_NAME_WORKER=${COMPOSE_PROJECT_NAME}-sidekiq
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis


# --- Database -------------------------------------------------------- [db] --
DB_NAME=chatwoot
DB_USER=chatwoot


# --- Application ----------------------------------------------------- [app] --
# Owner of volumes/storage. The image would otherwise run as root.
APP_UID=1000
APP_GID=1000


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the files:
#
#   ops/init.sh
#
#   .secrets/db_pwd.txt            PostgreSQL
#   .secrets/redis_pwd.txt         Redis
#   .secrets/secret_key_base.txt   Rails: signs sessions, derives encryption keys
#
# secret_key_base.txt must not change once the instance is in use.
