# =============================================================================
# FacturaScripts – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=facturascripts


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=erp.example.com


# WHO may reach it.
#   access-public   everyone
#   access-lan      LAN only (RFC1918)
#   access-vpn      VPN only
#   access-lan-vpn  LAN + VPN
#   access-blocked  nobody — the emergency kill switch
#
# VPN-only by default, deliberately: until ops/install.sh has run, the web
# installer is reachable and takes whatever database it is given.
APP_TRAEFIK_ACCESS=access-vpn

# HOW FAST one address may ask — limit-standard (125/s, burst 500) unless the
# README says otherwise: docs/standards/traefik-security.md.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file


TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# FacturaScripts (https://hub.docker.com/r/facturascripts/facturascripts)
# Seeds the webroot on the first start only; after that the in-app updater
# decides which version runs. See README.md.
APP_TAG=2026.5
# MariaDB LTS
DB_TAG=11.4


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_CRON=${COMPOSE_PROJECT_NAME}-cron
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db


# --- Database -------------------------------------------------------- [db] --
DB_NAME=facturascripts
DB_USER=facturascripts


# --- Application ---------------------------------------------------- [app] --
# Interface language written by ops/install.sh: en_EN, de_DE, es_ES, fr_FR,
# it_IT, pt_PT and more — Core/Translation/ in the image lists them all.
APP_LANG=en_EN
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the files:
#
#   ops/init.sh
#
#   .secrets/db_pwd.txt        MariaDB application user, also read by config.php
#   .secrets/db_root_pwd.txt   MariaDB root
#   .secrets/admin_pwd.txt     first administrator, read once by ops/install.sh
