# =============================================================================
# Leantime – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================
#
#   [compose]  Docker Compose itself — project and container names
#   [traefik]  the reverse proxy — hostname, TLS, access, security chain
#   [image]    which image version gets pulled
#   [app]      the application's own settings
#   [secrets]  documented here, values live in .secrets/ — never in this file
#
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
# Drives the container names and the Traefik router name.
COMPOSE_PROJECT_NAME=leantime


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The host name Leantime is reached at. It also goes into LEAN_APP_URL: the
# application builds the links in its notification mails from it.
APP_TRAEFIK_HOST=leantime.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
#   cloudflare-dns  DNS-01 — wildcards, no port 80 needed
#   httpResolver    HTTP-01 — no DNS provider needed
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS profile:
#   tls-basic   TLS 1.2+ — broad client compatibility
#   tls-aplus   TLS 1.2+ strict cipher set — the default for public apps
#   tls-modern  TLS 1.3 only — modern clients only
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# A fresh instance answers the web installer to whoever asks first, and the
# installer creates the administrator. `ops/init.sh` closes that window from
# the command line before the container is ever reachable — but the policy
# still starts VPN-only, because a project management instance holds the
# customer names, rates and deadlines of everything the company runs.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
#   sec-2           standard default for a new app
#   sec-3           public-facing and hardened
#   *e suffix       iframe-friendly (embedded apps)
#   *-spa suffix    high burst rate limit — documented for VPN-gated apps only
#
# sec-2 has not been measured against this application's pages — see README,
# "Known limits".
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — the third axis, independent of the two above.
# Empty by default: no CrowdSec bouncer on this router.
#
# To enable, name a profile from core/crowdsec/docs/profiles.md and keep the
# trailing comma — the value is prepended to the middleware list, and it has to
# come first so a banned address is rejected before anything else does work on
# the request. The @file is part of the value:
#   APP_TRAEFIK_THREAT=crowdsec-basic@file,
APP_TRAEFIK_THREAT=

# Shared proxy network, created by core/traefik. Same value in every app.
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# App image → pin major.minor.patch. Never :latest, never major-only.
# leantime (https://hub.docker.com/r/leantime/leantime)
APP_TAG=3.9.8

# MySQL. Upstream's own compose example uses 8.4 and the migrations are written
# against it — this is not a place to substitute MariaDB without testing.
DB_TAG=8.4.11


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db


# --- Database --------------------------------------------------------- [db] --
DB_NAME=leantime
DB_USER=leantime


# --- App Configuration ----------------------------------------------- [app] --
# Shown in the interface and in notification mails. Changeable later in the
# company settings.
APP_SITENAME=Leantime

# Default language for new users, e.g. en-US, de-DE, fr-FR, es-ES.
APP_LANGUAGE=en-US

# Session idle timeout in MINUTES (Leantime forwards it to Laravel's
# session.lifetime, which is in minutes). 480 = 8 hours.
APP_SESSION_EXPIRATION=480


# --- Timezone -------------------------------------------------------- [app] --
# Examples: UTC, Europe/Vienna, Europe/Berlin
# Used by both containers and as Leantime's default time zone for new users.
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
#
# `ops/init.sh` creates all three and the volume directories, and refuses to
# overwrite anything that exists. The schema comes afterwards, from
# `ops/install.sh`. By hand the secrets are:
#
#   mkdir -p .secrets
#   openssl rand -base64 24 | tr -d '\n' > .secrets/db_pwd.txt
#   openssl rand -base64 24 | tr -d '\n' > .secrets/db_root_pwd.txt
#   openssl rand -base64 32 | tr -d '\n' > .secrets/session_password.txt
#   chmod 644 .secrets/*.txt && chmod 700 .secrets
#
# The session password salts the session cookies: changing it signs everyone
# out, which is the point of keeping it out of the image and out of git.
# Leantime's own sample configuration ships a fixed one — never use it.
#
# The volume directories must belong to uid/gid 1000, which is what the image
# runs as:
#   sudo chown -R 1000:1000 volumes/userfiles volumes/public-userfiles \
#       volumes/storage volumes/plugins
#
# The administrator's password is NOT stored here. `ops/install.sh` prompts for
# it and `bin/leantime db:migrate` writes only the hash to the database.
