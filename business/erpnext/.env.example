# =============================================================================
# ERPNext – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=erpnext


# --- Domain & Traefik ------------------------------------------- [traefik] --
APP_TRAEFIK_HOST=erp.example.com

# TLS profile — see docs/standards/traefik-security.md.
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it.
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# A company's books, customers, suppliers and stock in one place. VPN-only by
# default.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply — see docs/standards/traefik-security.md.
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — empty by default: no CrowdSec bouncer on this router.
# See core/crowdsec/docs/profiles.md to enable one; keep the trailing comma.
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# ERPNext (https://hub.docker.com/r/frappe/erpnext)
APP_TAG=v16.35.0
# MariaDB — the version upstream's compose pins
DB_TAG=11.8
# Redis — the version upstream's compose pins
REDIS_TAG=8.6-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-frontend
CONTAINER_NAME_BACKEND=${COMPOSE_PROJECT_NAME}-backend
CONTAINER_NAME_WEBSOCKET=${COMPOSE_PROJECT_NAME}-websocket
CONTAINER_NAME_QUEUE_SHORT=${COMPOSE_PROJECT_NAME}-queue-short
CONTAINER_NAME_QUEUE_LONG=${COMPOSE_PROJECT_NAME}-queue-long
CONTAINER_NAME_SCHEDULER=${COMPOSE_PROJECT_NAME}-scheduler
CONTAINER_NAME_CONFIGURATOR=${COMPOSE_PROJECT_NAME}-configurator
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS_CACHE=${COMPOSE_PROJECT_NAME}-redis-cache
CONTAINER_NAME_REDIS_QUEUE=${COMPOSE_PROJECT_NAME}-redis-queue


# --- Database -------------------------------------------------------- [db] --
DB_NAME=erpnext
DB_USER=erpnext


# --- Application ---------------------------------------------------- [app] --
# The Frappe site: its name, and the address it writes into links and email.
SITE_NAME=${APP_TRAEFIK_HOST}
APP_URL=https://${APP_TRAEFIK_HOST}
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates the files:
#
#   ops/init.sh
#
#   .secrets/db_pwd.txt        MariaDB user of the site
#   .secrets/db_root_pwd.txt   MariaDB root, used by MariaDB alone
#   .secrets/redis_pwd.txt     both Redis instances
#   .secrets/admin_pwd.txt     the Administrator account, read by ops/create-site.sh
#
# Frappe adds an encryption key to volumes/sites/<site>/site_config.json the
# first time it encrypts a value. Back it up with the database: stored
# passwords are unreadable without it.
