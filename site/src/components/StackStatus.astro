---
/**
 * One compact line: how far along this stack is, which version it sets up, and
 * when that was last checked.
 *
 * The facts come from `src/data/lifecycle.json`, generated from the repository,
 * and CI fails if it drifts. Nothing here is retyped, and nothing about how that
 * works belongs on the page — a reader who cares follows the link.
 *
 * `note` is the only authored part: one sentence naming what specifically has
 * not been exercised. A generic disclaimer is noise; a named gap is useful.
 *
 * Usage:  <StackStatus stack="apps/nextcloud" note="Client sync is untested." />
 */
import lifecycle from '../data/lifecycle.json';

interface Props {
	stack: string;
	note?: string;
}

const { stack, note } = Astro.props;
const entry = (lifecycle as Record<string, any>)[stack];

if (!entry) {
	throw new Error(
		`StackStatus: "${stack}" is not in lifecycle.json. Use a path as it ` +
			`appears in LIFECYCLE.md, for example "apps/nextcloud".`,
	);
}

const LABEL: Record<string, string> = {
	planned: 'Planned',
	preview: 'Preview',
	ready: 'Ready',
	'ops-ready': 'Ops-ready',
};

// `APP_TAG=34.0.2-fpm-alpine` is how the repository names it. A reader wants the
// version.
const version = String(entry.pinned).split('=').pop();

const checked =
	entry.verified === '—'
		? null
		: new Date(entry.verified).toLocaleDateString('en-GB', {
				day: 'numeric',
				month: 'short',
				year: 'numeric',
			});
---

<div class={`stack-status stack-status--${entry.public}`}>
	<p class="stack-status__line">
		<span class="stack-status__label">
			<span aria-hidden="true">{entry.symbol}</span>
			<a href="/faq/#what-do-the-status-labels-mean">{LABEL[entry.public]}</a>
		</span>
		{version !== 'host-installed' && <code>{version}</code>}
		{checked && <span class="stack-status__checked">checked {checked}</span>}
	</p>
	{note && <p class="stack-status__note">{note}</p>}
</div>

<style>
	.stack-status {
		border-left: 3px solid var(--sl-color-gray-4);
		padding: 0.35rem 0 0.35rem 0.75rem;
		margin-block: 1.25rem;
	}
	.stack-status--ready,
	.stack-status--ops-ready {
		border-left-color: var(--sl-color-green);
	}
	.stack-status--preview {
		border-left-color: var(--sl-color-orange);
	}
	.stack-status__line {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem 0.9rem;
		font-size: 0.85rem;
	}
	.stack-status__label {
		display: inline-flex;
		align-items: baseline;
		gap: 0.3rem;
		font-weight: 600;
	}
	.stack-status__label a {
		color: inherit;
		text-decoration-style: dotted;
		text-underline-offset: 0.2em;
	}
	.stack-status__line code {
		font-size: 0.8rem;
	}
	.stack-status__checked {
		color: var(--sl-color-gray-3);
	}
	.stack-status__note {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
	}
</style>
