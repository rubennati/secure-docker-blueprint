---
/**
 * What has been established about this stack, and what has not.
 *
 * A stack carries no state (DEC-080). This shows the facts — when the stack last
 * ran on a host and which version ran, whether its data came back from a backup,
 * the pin and what upstream has released since, what the pinned images carry —
 * and leaves the weighing to the reader.
 *
 * Facts come from `src/data/lifecycle.json`, generated from the repository and
 * checked in CI. Nothing here is retyped.
 *
 * `gap` is the authored part: one sentence naming what specifically has not
 * been exercised. A generic disclaimer is noise; a named gap is usable — so a
 * stack with no test date must supply one, or the build fails.
 *
 * Usage:  <StackEvidence stack="apps/nextcloud" gap="Client sync is untested." />
 */
import lifecycle from '../data/lifecycle.json';

interface Props {
	stack: string;
	gap?: string;
}

const { stack, gap } = Astro.props;
const entry = (lifecycle as Record<string, any>)[stack];

if (!entry) {
	throw new Error(
		`StackEvidence: "${stack}" is not in lifecycle.json. Use a path as it ` +
			`appears in LIFECYCLE.md, for example "apps/nextcloud".`,
	);
}

const version = String(entry.pinned).split('=').pop()?.split('@')[0];
const hostInstalled = version === 'host-installed';

const day = (d: string) =>
	new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// A host run tests the setup. Its date stays when the pin moves; the version
// that ran is named beside it, so the pin is never credited with a run it did
// not have.
const tested = entry.tested_anchored && entry.tested ? day(entry.tested) : null;
const testedVersion = entry.tested_differs ? entry.tested_version : '';

const upstream =
	entry.upstream === 'current'
		? 'the newest upstream release'
		: entry.upstream === 'behind'
			? `upstream has released ${entry.newest}${entry.newest_date ? ` on ${day(entry.newest_date)}` : ''}`
			: entry.upstream === 'undetermined'
				? 'a newer upstream release is not determinable'
				: 'upstream not checked at this pin';
const upstreamNote = entry.archived
	? 'the upstream repository is archived'
	: entry.quiet
		? `no upstream release since ${entry.last_release ? day(entry.last_release) : 'over a year'}`
		: '';

// Findings with a published fix in the images as upstream publishes them. The
// README splits them per image and says why any is left in place.
const critical = entry.critical;
const high = entry.high;
const readme = `https://github.com/rubennati/secure-docker-blueprint/blob/main/${stack}/README.md#open-findings`;

// Where nothing has run, the version alone is not enough to leave a reader
// with — but a generic hedge is worse than nothing. So the gap becomes
// mandatory here, and the build stops rather than ship a page that gestures at
// doubt.
if (!tested && !gap) {
	throw new Error(
		`StackEvidence: "${stack}" has no test date, so it needs a gap="…" naming ` +
			`what specifically has not been established. A page without one would ` +
			`carry a warning the reader cannot act on.`,
	);
}
---

<div class={`evidence evidence--${tested ? 'checked' : 'untested'}`}>
	{
		tested ? (
			<p class="evidence__line">
				<strong>Last run on a host {tested}</strong>
				{testedVersion && (
					<>
						{' '}
						with <code>{testedVersion}</code>
					</>
				)}
				{entry.restored && <> · data restored from a backup</>}
			</p>
		) : (
			<p class="evidence__line">
				<strong>Not run on a host yet</strong>
			</p>
		)
	}
	{
		!hostInstalled && (
			<p class="evidence__line">
				Pinned at <code>{version}</code>
				{entry.pinned_date && <> (released {day(entry.pinned_date)})</>} · {upstream}
				{upstreamNote && <> · {upstreamNote}</>}
			</p>
		)
	}
	{gap && <p class="evidence__gap">Not exercised: {gap}</p>}
	{
		critical !== null && high !== null && (critical > 0 || high > 0) && (
			<p class="evidence__findings">
				In the upstream images: {critical} CRITICAL · {high} HIGH with a published fix —{' '}
				<a href={readme}>per image</a>
			</p>
		)
	}
</div>

<style>
	.evidence {
		border-left: 3px solid var(--sl-color-gray-4);
		padding: 0.35rem 0 0.35rem 0.75rem;
		margin-block: 1.25rem;
	}
	.evidence--checked {
		border-left-color: var(--sl-color-blue);
	}
	/* Grey, not orange: an absent test date is a missing fact, not a hazard.
	   The named gap underneath is what the reader acts on. */
	.evidence--untested {
		border-left-color: var(--sl-color-gray-4);
	}
	.evidence__line {
		margin: 0 0 0.15rem;
		font-size: 0.85rem;
	}
	.evidence__line code {
		font-size: 0.8rem;
	}
	/* Plain text colour: the findings come with the upstream images, they are
	   information about them, not an alarm about this stack. */
	.evidence__findings {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
	}
	.evidence__gap {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
	}
</style>
