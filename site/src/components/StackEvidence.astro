---
/**
 * What has been established about this stack, and what has not.
 *
 * The repository's lifecycle state is a maintainer's answer to "what should I
 * work on". It is not rendered here. A visitor asks something else — what was
 * actually exercised, against which version, and what is still untested — so
 * this shows the evidence and leaves the weighing to them.
 *
 * Facts come from `src/data/lifecycle.json`, generated from the repository and
 * checked in CI. Nothing here is retyped.
 *
 * `gap` is the authored part: one sentence naming what specifically has not
 * been exercised. A generic disclaimer is noise; a named gap is usable — so a
 * stack with no verification date must supply one, or the build fails.
 *
 * Usage:  <StackEvidence stack="apps/nextcloud" gap="Client sync is untested." />
 */
import lifecycle from '../data/lifecycle.json';

interface Props {
	stack: string;
	gap?: string;
}

const { stack, gap } = Astro.props;
const entry = (lifecycle as Record<string, any>)[stack];

if (!entry) {
	throw new Error(
		`StackEvidence: "${stack}" is not in lifecycle.json. Use a path as it ` +
			`appears in LIFECYCLE.md, for example "apps/nextcloud".`,
	);
}

const version = String(entry.pinned).split('=').pop();
const hostInstalled = version === 'host-installed';

// The date refers to the version that was exercised, which is not always the one
// pinned today — a later bump moves the pin without re-running anything. Naming
// the pin next to the date would credit it with a check it never had.
const verifiedVersion = entry.verified_version || '';

// Compare what the two actually name, not how they are written: UPSTREAM.md
// tends to carry a leading `v`, a pin may repeat the image name or append a
// digest, and none of that makes it a different version.
const sameVersion = (a, b) => {
	const norm = (s) =>
		String(s)
			.split('@')[0]
			.replace(/^[a-z0-9._/-]+:(?=[\dv])/i, '')
			.replace(/^v/i, '');
	return norm(a) === norm(b);
};
const pinMoved =
	Boolean(verifiedVersion) && !hostInstalled && !sameVersion(verifiedVersion, version);

const checked =
	entry.verified_anchored && entry.verified !== '—'
		? new Date(entry.verified).toLocaleDateString('en-GB', {
				day: 'numeric',
				month: 'short',
				year: 'numeric',
			})
		: null;

// `ops-proven` means this stack's data was restored from a backup on a live
// host. That is evidence a reader can weigh, so it is stated as the fact it is
// rather than as the tier's name.
const restored = entry.state === 'ops-proven';

// Where nothing has been verified, the version alone is not enough to leave a
// reader with — but a generic hedge ("may well work") is worse than nothing: it
// warns without saying what to check. So the gap becomes mandatory here, and
// the build stops rather than shipping a page that gestures at doubt.
if (!checked && !gap) {
	throw new Error(
		`StackEvidence: "${stack}" has no anchored verification date, so it needs ` +
			`a gap="…" naming what specifically has not been established. A page ` +
			`without one would carry a warning the reader cannot act on.`,
	);
}
---

<div class={`evidence evidence--${checked ? (restored ? 'proven' : 'checked') : 'unverified'}`}>
	{
		checked ? (
			<p class="evidence__line">
				<strong>Verified {checked}</strong>
				{!hostInstalled && (
					<>
						{' '}
						against <code>{verifiedVersion || version}</code>
					</>
				)}
				{restored && <> · data restored from a backup on a live host</>}
				{pinMoved && (
					<>
						{' '}
						· pinned at <code>{version}</code> since, which has not been run here
					</>
				)}
			</p>
		) : (
			<p class="evidence__line">
				<strong>Written against <code>{version}</code></strong> · no verification
				recorded against that version
			</p>
		)
	}
	{gap && <p class="evidence__gap">Not exercised: {gap}</p>}
</div>

<style>
	.evidence {
		border-left: 3px solid var(--sl-color-gray-4);
		padding: 0.35rem 0 0.35rem 0.75rem;
		margin-block: 1.25rem;
	}
	.evidence--proven {
		border-left-color: var(--sl-color-green);
	}
	.evidence--checked {
		border-left-color: var(--sl-color-blue);
	}
	/* Grey, not orange: an absent verification is a missing fact, not a hazard.
	   The named gap underneath is what the reader acts on. */
	.evidence--unverified {
		border-left-color: var(--sl-color-gray-4);
	}
	.evidence__line {
		margin: 0;
		font-size: 0.85rem;
	}
	.evidence__line code {
		font-size: 0.8rem;
	}
	.evidence__gap {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
	}
</style>
