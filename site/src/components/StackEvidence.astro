---
/**
 * What has been established about this stack, and what has not.
 *
 * The repository's lifecycle state is a maintainer's answer to "what should I
 * work on". It is not rendered here. A visitor asks something else — what was
 * actually exercised, against which version, and what is still untested — so
 * this shows the evidence and leaves the weighing to them.
 *
 * Facts come from `src/data/lifecycle.json`, generated from the repository and
 * checked in CI. Nothing here is retyped.
 *
 * `gap` is the authored part: one sentence naming what specifically has not
 * been exercised. A generic disclaimer is noise; a named gap is usable.
 *
 * Usage:  <StackEvidence stack="apps/nextcloud" gap="Client sync is untested." />
 */
import lifecycle from '../data/lifecycle.json';

interface Props {
	stack: string;
	gap?: string;
}

const { stack, gap } = Astro.props;
const entry = (lifecycle as Record<string, any>)[stack];

if (!entry) {
	throw new Error(
		`StackEvidence: "${stack}" is not in lifecycle.json. Use a path as it ` +
			`appears in LIFECYCLE.md, for example "apps/nextcloud".`,
	);
}

const version = String(entry.pinned).split('=').pop();
const hostInstalled = version === 'host-installed';

const checked =
	entry.verified_anchored && entry.verified !== '—'
		? new Date(entry.verified).toLocaleDateString('en-GB', {
				day: 'numeric',
				month: 'short',
				year: 'numeric',
			})
		: null;

// `ops-proven` means this stack's data was restored from a backup on a live
// host. That is evidence a reader can weigh, so it is stated as the fact it is
// rather than as the tier's name.
const restored = entry.state === 'ops-proven';
const tone = checked ? (restored ? 'proven' : 'checked') : 'untested';
---

<div class={`evidence evidence--${tone}`}>
	{
		checked ? (
			<p class="evidence__line">
				<strong>Verified {checked}</strong>
				{!hostInstalled && <> against <code>{version}</code></>}
				{restored && <> · data restored from a backup on a live host</>}
			</p>
		) : (
			<p class="evidence__line">
				<strong>No verification against a named version is recorded.</strong>
				{' '}The configuration is here and may well work; nothing has been
				established about it.
			</p>
		)
	}
	{gap && <p class="evidence__gap">Not exercised: {gap}</p>}
</div>

<style>
	.evidence {
		border-left: 3px solid var(--sl-color-gray-4);
		padding: 0.35rem 0 0.35rem 0.75rem;
		margin-block: 1.25rem;
	}
	.evidence--proven {
		border-left-color: var(--sl-color-green);
	}
	.evidence--checked {
		border-left-color: var(--sl-color-blue);
	}
	.evidence--untested {
		border-left-color: var(--sl-color-orange);
	}
	.evidence__line {
		margin: 0;
		font-size: 0.85rem;
	}
	.evidence__line code {
		font-size: 0.8rem;
	}
	.evidence__gap {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
	}
</style>
