# =============================================
# Borgmatic – systemd service
# =============================================
# The unit borgmatic.timer starts. A timer alone does nothing: it activates a
# service of the same name, and without this file that service does not exist.
#
# Check whether your package already ships both before installing either:
#
#   systemctl list-unit-files | grep borgmatic
#
# A pipx installation ships neither.
#
# Install to /etc/systemd/system/borgmatic.service, then:
#   sudo systemctl daemon-reload
#   sudo systemd-analyze verify /etc/systemd/system/borgmatic.service
#   sudo systemctl start borgmatic.service     # prove it before trusting the timer
#   journalctl -u borgmatic.service -n 30
#
# Adapted from upstream's sample, which is the source for the hardening block:
# https://projects.torsion.org/borgmatic-collective/borgmatic/src/branch/main/sample/systemd
#
# Two deliberate differences from that sample:
#
#   * ExecStart points at /usr/local/bin, where the documented pipx install
#     puts it. Upstream assumes ~/.local/bin, which root's PATH does not have.
#   * LoadCredentialEncrypted is not used. This setup reads the passphrase with
#     `{credential file /root/.borg-passphrase}` from config.yaml instead, so
#     one mechanism covers the passphrase and the database passwords alike.
#
# The hardening below has been verified not to break command hooks that call
# `docker exec` — the Docker socket is reached over AF_UNIX, which stays
# permitted. If you add a hook that needs more, relax the specific directive
# rather than dropping the block.
# =============================================

[Unit]
Description=borgmatic backup
Documentation=https://torsion.org/borgmatic/
Wants=network-online.target
After=network-online.target
# Skip the run on battery. Remove on a machine that is never on battery.
ConditionACPower=true

[Service]
Type=oneshot
RuntimeDirectory=borgmatic
StateDirectory=borgmatic

# --- Hardening ---
LockPersonality=true
MemoryDenyWriteExecute=no
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
ProtectSystem=full

# Reading every file to back it up needs DAC_READ_SEARCH; the rest is what Borg
# uses. Everything else is dropped.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_FOWNER CAP_NET_RAW

# --- Priority ---
# A backup must not compete with the services it exists to protect.
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=best-effort
IOSchedulingPriority=7
IOWeight=100

Restart=no
LogRateLimitIntervalSec=0

# Let the network settle after a boot-triggered catch-up run.
ExecStartPre=sleep 1m

# systemd-inhibit stops a suspend or shutdown landing mid-archive.
ExecStart=systemd-inhibit --who="borgmatic" --what="sleep:shutdown" --why="Prevent interrupting scheduled backup" /usr/local/bin/borgmatic --verbosity -2 --syslog-verbosity 1
