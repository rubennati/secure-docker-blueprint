# =============================================================================
# Rclone Web – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=rclone-web


# --- Domain & Traefik ------------------------------------------- [traefik] --
# One host: the interface at /, the remote control API at /api/.
APP_TRAEFIK_HOST=rclone.example.com

# TLS profile — see docs/standards/traefik-security.md.
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it.
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# The API reads and changes every configured remote, credentials included.
# VPN-only by default.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply — see docs/standards/traefik-security.md.
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — empty by default: no CrowdSec bouncer on this router.
# See core/crowdsec/docs/profiles.md to enable one; keep the trailing comma.
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# rclone (https://hub.docker.com/r/rclone/rclone) — `rclone gui` serves the
# Rclone Web release embedded at build time
APP_TAG=1.75.1


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- Application ----------------------------------------------------- [app] --
# Owner of volumes/config and volumes/data. The image would otherwise run as root.
APP_UID=1000
APP_GID=1000


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. One command creates both files:
#
#   ops/init.sh [user]
#
#   .secrets/gui_pwd.txt     the password you log in with
#   .secrets/gui_htpasswd    the user and its hash, which rclone checks
#
# The remotes' own credentials live in volumes/config/rclone.conf.
