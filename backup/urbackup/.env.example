# =============================================
# UrBackup Server – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# Backs up client machines (laptops, desktops, servers) to storage you own.
# For backing up the Docker host itself, see ../borgmatic/.
# =============================================

COMPOSE_PROJECT_NAME=urbackup

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=backup.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
# The web interface lists every backed-up file on every client and can trigger
# restores. Keep it off the public internet — acc-tailscale (VPN-only) is the
# recommended default. Change this only with a deliberate reason.
APP_TRAEFIK_ACCESS=acc-tailscale
APP_TRAEFIK_SECURITY=sec-3
APP_INTERNAL_PORT=55414
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# uroni/urbackup-server (https://hub.docker.com/r/uroni/urbackup-server)
# Upstream publishes only rolling series tags (2.5.x), which move — so the tag
# is digest-pinned for reproducibility. Re-pin on every upgrade.
# `2.5.x` and `2.5.x-btrfs` are byte-identical; use `2.5.x-zfs` only for ZFS.
APP_TAG=2.5.x@sha256:e2fdc0d59071b0e9438ebb05fe163a839f767c4477851e87dcc3efa8df7ab299

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- App Configuration ---
# Where client backups are stored. This grows without bound — point it at the
# volume that has the room. An absolute path on a large disk is normal here;
# ./volumes/backups only makes sense for a small test.
#
# ⚠ Keep this path OUT of borgmatic's source_directories, or the host backup
# will try to back up every client backup as well.
BACKUP_STORAGE_PATH=./volumes/backups

# Resource caps. A backup server is I/O-heavy and memory scales with client
# count and file count. These are a starting point — measure with `docker
# stats` during a full backup and retune to roughly 2x peak.
APP_MEM_LIMIT=4g
APP_CPU_LIMIT="2.00"

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# UrBackup has no secrets in its environment — the administrator account is
# created through the web interface on first start. Do that IMMEDIATELY: until
# an admin exists, the interface is open to whoever reaches it first.
