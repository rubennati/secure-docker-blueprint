# =============================================================================
# Kopia – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================
#
#   [compose]  Docker Compose itself — project and container names
#   [traefik]  the reverse proxy — hostname, TLS, access, security chain
#   [image]    which image version gets pulled
#   [app]      the application's own settings
#   [secrets]  documented here, values live in .secrets/ — never in this file
#
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
# Drives the container name and the Traefik router name.
COMPOSE_PROJECT_NAME=kopia


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The host name clients connect to. It also goes into the certificate the
# server presents to Traefik, which nothing verifies — see ops/init.sh.
APP_TRAEFIK_HOST=kopia.example.com

# Certificate resolver. Only used when the certresolver label is uncommented in
# docker-compose.yml (per-domain certs). With a wildcard cert, leave it alone.
#   cloudflare-dns  DNS-01 — wildcards, no port 80 needed
#   httpResolver    HTTP-01 — no DNS provider needed
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS profile:
#   tls-basic   TLS 1.2+ — broad client compatibility
#   tls-aplus   TLS 1.2+ strict cipher set — the default for public apps
#   tls-modern  TLS 1.3 only — modern clients only
#
# Kopia's clients are current Go binaries, so tls-modern is within reach. It
# stays at tls-aplus here because a browser on an older machine also opens the
# interface.
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach the server:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# Every machine that backs up to this repository has to reach this host, so the
# policy follows where those machines are. VPN-only by default. Kopia's own
# login sits behind it, and a client account is a second credential again.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
#   sec-2           standard default for a new app
#   sec-3           public-facing and hardened
#   *e suffix       iframe-friendly (embedded apps)
#   *-spa suffix    high burst rate limit — documented for VPN-gated apps only
#
# A client's traffic is a handful of long-lived gRPC requests rather than many
# short ones, so a rate limit is unlikely to bite — but no backup window has
# been measured through this chain. See README, "Known limits".
APP_TRAEFIK_SECURITY=sec-2

# Threat enforcement — the third axis, independent of the two above.
# Empty by default: no CrowdSec bouncer on this router.
#
# To enable, name a profile from core/crowdsec/docs/profiles.md and keep the
# trailing comma — the value is prepended to the middleware list, and it has to
# come first so a banned address is rejected before anything else does work on
# the request. The @file is part of the value:
#   APP_TRAEFIK_THREAT=crowdsec-basic@file,
APP_TRAEFIK_THREAT=

# Shared proxy network, created by core/traefik. Same value in every app.
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# App image → pin major.minor.patch. Never :latest, never major-only.
# kopia (https://hub.docker.com/r/kopia/kopia)
APP_TAG=0.23.1


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-server


# --- App Configuration ----------------------------------------------- [app] --
# The user the server runs as: the owner of ./volumes/repository, config, cache
# and logs. ops/init.sh creates those; if you create them by hand, chown them
# to this uid first — Docker would make them root-owned and the server runs
# without the capabilities root would need.
APP_UID=1000
APP_GID=1000

# The login for the web interface. Its password is a Docker Secret.
KOPIA_SERVER_USER=ops

# The control API's own account, which `kopia server refresh` and the status
# commands use. Password likewise a Docker Secret.
KOPIA_SERVER_CONTROL_USER=control


# --- Timezone -------------------------------------------------------- [app] --
# Examples: UTC, Europe/Vienna, Europe/Berlin
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
# Values live in .secrets/*.txt (gitignored) and are mounted as Docker Secrets.
#
# `ops/init.sh` creates all three, the server's certificate and the repository,
# and refuses to overwrite anything that exists. By hand it is:
#
#   mkdir -p .secrets volumes/repository volumes/config volumes/cache volumes/logs
#   openssl rand -base64 24 | tr -d '\n' > .secrets/kopia_repository_password.txt
#   openssl rand -base64 24 | tr -d '\n' > .secrets/kopia_server_password.txt
#   openssl rand -base64 24 | tr -d '\n' > .secrets/kopia_server_control_password.txt
#   chmod 644 .secrets/*.txt && chmod 700 .secrets
#
# **The repository password is the key to the data.** Kopia derives the
# encryption key from it and stores nothing that can recover it: lose the file
# and every snapshot in the repository is unreadable. Keep a copy somewhere
# this host cannot reach — the same rule `backup/README.md` states for Borg's
# key.
#
# The four volume directories must belong to APP_UID:APP_GID:
#   sudo chown -R 1000:1000 volumes/repository volumes/config volumes/cache volumes/logs
