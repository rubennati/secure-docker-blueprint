# =============================================================================
# zot – Environment
# =============================================================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================================================

COMPOSE_PROJECT_NAME=zot

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=registry.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
# VPN-only by default — a registry that can hold internally-built images is
# not public-default material. Change deliberately if you need CI runners
# outside the tailnet to push/pull.
APP_TRAEFIK_ACCESS=acc-tailscale
APP_TRAEFIK_SECURITY=sec-2
APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# zot (https://github.com/project-zot/zot/pkgs/container/zot)
# This is the "full" image (search, ui, mgmt, imagetrust, sync, events,
# etc. all built in) rather than "zot-minimal" — the UI and embedded CVE
# scanning this stack uses need it. See UPSTREAM.md.
APP_TAG=v2.1.21

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- App Configuration ---
# The image has no privilege-drop entrypoint of its own — this UID/GID is
# set explicitly via `user:` in docker-compose.yml, and volumes/registry
# must be owned by it before first start (see README.md#setup).
USERMAP_UID=1000
USERMAP_GID=1000

# --- Secrets ---
# Create the secrets directory:
#   mkdir -p .secrets volumes/registry
#   sudo chown 1000:1000 volumes/registry
#
# Registry admin credential — a single bcrypt htpasswd entry. config.json's
# adminPolicy grants this user full read/write/delete; everyone else gets
# nothing (see config/config.json). Generate a real one (this repository's
# host has no htpasswd binary by default — the httpd image provides it):
#   docker run --rm httpd:2.4-alpine htpasswd -Bbn admin "$(openssl rand -base64 24)" \
#     > .secrets/htpasswd
# Note the generated password from your shell history before it scrolls
# away, or generate it in two steps and keep the plaintext value somewhere
# safe (a password manager) — the file only ever holds the bcrypt hash.
