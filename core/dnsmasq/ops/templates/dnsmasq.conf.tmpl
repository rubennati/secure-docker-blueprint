# =========================================================
# dnsmasq – rendered from ops/templates/dnsmasq.conf.tmpl
# Do NOT edit directly – run ops/scripts/render.sh
# =========================================================

# =========================================================
# BASICS / SECURITY
# =========================================================
domain-needed
bogus-priv
no-hosts
no-resolv

# Localhost resolution (no-hosts disables /etc/hosts, so define explicitly)
address=/localhost/127.0.0.1
address=/localhost/::1

# =========================================================
# UPSTREAM DNS
# =========================================================
server=${DNS_UPSTREAM_1}
server=${DNS_UPSTREAM_2}

# =========================================================
# CACHE
# =========================================================
cache-size=${DNS_CACHE_SIZE}
neg-ttl=${DNS_NEG_TTL}

# =========================================================
# LISTEN INTERFACES
# =========================================================
interface=${DNS_INTERFACE_1}
interface=${DNS_INTERFACE_2}
# interface=${DNS_INTERFACE_3}
# bind-dynamic avoids DNS amplification attacks (recommended over bind-interfaces)
bind-dynamic

# =========================================================
# STATIC HOST FILE
# =========================================================
addn-hosts=/etc/dnsmasq.d/records.hosts

# =========================================================
# LOCAL DOMAIN
# =========================================================
local=/${DNS_LOCAL_DOMAIN}/
domain=${DNS_LOCAL_DOMAIN}
expand-hosts

# =========================================================
# WILDCARD ZONES
# =========================================================
# Every name below a domain answers with the host's addresses, one line per
# family — rendered from DNS_WILDCARD_<n>_{DOMAIN,IP,IP6}; empty slots render
# nothing.
${DNS_WILDCARD_LINES}

# =========================================================
# LOGGING
# =========================================================
log-queries
log-facility=-
