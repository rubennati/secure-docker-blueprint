# Keycloak — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=26.7.3
DB_TAG=17.11-alpine

# --- Database -------------------------------------------------------- [app] --
DB_NAME=keycloak
DB_USER=keycloak
# openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__

# --- App Configuration ----------------------------------------------- [app] --
# Temporary administrator, created with the master realm on the first start.
BOOTSTRAP_ADMIN_USERNAME=temp-admin
# openssl rand -base64 24 | tr -d '\n'
BOOTSTRAP_ADMIN_PASSWORD=__REPLACE_ME__

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
