# =============================================
# Keycloak – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# Keycloak is Apache-2.0, a CNCF project stewarded by Red Hat. The first
# start creates a temporary administrator from the two BOOTSTRAP_ADMIN values;
# create a permanent one in the master realm and delete the temporary account.
# =============================================

COMPOSE_PROJECT_NAME=keycloak

# --- Domain & Traefik ---
# The issuer. Every token, redirect and discovery document names it, and a
# request for any other host is refused.
APP_TRAEFIK_HOST=sso.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
# An identity provider is reachable by whatever it protects. If those
# applications are public, so is this — the same decision as for a booking page.
APP_TRAEFIK_ACCESS=acc-tailscale
# The admin console is a large single-page application; measure the first
# load before moving to sec-3-spa.
APP_TRAEFIK_SECURITY=sec-2-spa
APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# quay.io/keycloak/keycloak (https://quay.io/repository/keycloak/keycloak?tab=tags)
# Minor releases about monthly, patches in between; each may migrate the schema.
APP_TAG=26.7.3
# postgres (https://hub.docker.com/_/postgres)
DB_TAG=17.11-alpine

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db

# --- Database ---
DB_NAME=keycloak
DB_USER=keycloak

# --- App Configuration ---
# Temporary administrator for the first start only; the password is a secret.
BOOTSTRAP_ADMIN_USERNAME=temp-admin

# --- Timezone ---
TZ=UTC

# --- Secrets ---
#   mkdir -p .secrets volumes/postgres volumes/data
#   openssl rand -hex 32    | tr -d '\n' > .secrets/db_pwd.txt
#   openssl rand -base64 24 | tr -d '\n' > .secrets/bootstrap_admin_pwd.txt
#   chmod 700 .secrets && chmod 600 .secrets/*.txt
#   # the server runs as uid 1000 and writes to volumes/data
#   sudo chown 1000:0 volumes/data
