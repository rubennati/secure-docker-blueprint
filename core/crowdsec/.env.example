# =============================================
# CrowdSec – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=crowdsec

# --- Images ---
# crowdsec (https://hub.docker.com/r/crowdsecurity/crowdsec)
APP_TAG=v1.7.8

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}

# --- Network ---
# Created by core/traefik; must match CROWDSEC_SECURITY_NETWORK there.
CROWDSEC_SECURITY_NETWORK=crowdsec-security

# --- CrowdSec Configuration ---
# GID that owns the Traefik log files
# Find with: stat -c '%g' /path/to/secure-docker-blueprint/core/traefik/volumes/logs/access.log
CROWDSEC_LOG_GID=0

# Collections to install on first start (space-separated)
# Browse: https://hub.crowdsec.net/
CROWDSEC_COLLECTIONS=crowdsecurity/traefik crowdsecurity/http-cve crowdsecurity/appsec-generic-rules crowdsecurity/appsec-virtual-patching
# For SSH brute-force detection (host-firewall remediation), also add: crowdsecurity/sshd
# Requires: auth.log volume mount in docker-compose.yml + acquis.yaml SSH block
# See docs/firewall-bouncer.md → "SSH detection"

# LAPI port exposed on localhost (for firewall bouncer on host)
CROWDSEC_LAPI_PORT=8080

# --- Administrative exemption (optional) ---
# Addresses the engine must never serve a decision against — the
# administrator's own devices, each by its VPN address, IPv4 and IPv6 where
# both exist; comma-separated. Empty: no exemption, by decision. Nothing is
# applied on `up`: run ops/allowlist.sh apply after setting it.
# A whole VPN range (100.64.0.0/10, fd7a:115c:a1e0::/48) is accepted and named
# for what it is: every device on it is exempt, a compromised one included. An
# exemption is not evidence that a device is trustworthy — README.md, step 5.
CROWDSEC_ALLOWLIST_ADMIN=

# --- Traefik Logs ---
# Default: relative path (traefik and crowdsec in same core/ directory)
# Override with absolute path if traefik is elsewhere
# Example absolute: /path/to/secure-docker-blueprint/core/traefik/volumes/logs
TRAEFIK_LOG_PATH=../traefik/volumes/logs

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC
