# =============================================================================
# step-ca – Environment
# =============================================================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# Read README.md#root-ca-vs-intermediate-ca before your first `docker
# compose up` — the choice you make there is not easily undone.
# =============================================================================

COMPOSE_PROJECT_NAME=step-ca

# --- Images ---
# step-ca (https://hub.docker.com/r/smallstep/step-ca)
APP_TAG=0.30.2

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Network ---
# No Traefik — see README.md#traefik-networking for why. This publishes on
# every host interface by default; this stack has no Traefik-style access
# policy to narrow it for you, so restrict it at the host firewall or bind
# it to one interface (e.g. STEPCA_PORT=100.64.0.1:9000 for a Tailscale-only
# interface) if it must not be reachable from your whole LAN.
STEPCA_PORT=9000

# --- App Configuration ---
# The CA's own name and the hostnames/IPs it will be reachable at — both
# baked into the root/intermediate certificates at init time and NOT
# changeable afterward without re-initializing the whole CA.
STEPCA_NAME=Example Internal CA
STEPCA_DNS_NAMES=ca.example.com

# ACME — lets other stacks in this installation request certificates the
# same way Traefik does with a public CA, but against this internal one.
STEPCA_ENABLE_ACME=true

# SSH CA — issues short-lived SSH host/user certificates in addition to
# X.509. Leave false unless you have an actual SSH-certificate workflow to
# use it with; enabling it only at init time is the supported path — see
# UPSTREAM.md.
STEPCA_ENABLE_SSH=false

# --- Timezone ---
TZ=UTC

# --- Secrets ---
# Create the secrets directory:
#   mkdir -p .secrets volumes/data
#
# Protects the intermediate (and, in the simple path below, root) CA
# private key. Needed on every restart — losing it means losing the CA:
#   openssl rand -base64 32 | tr -d '\n' > .secrets/ca_password.txt
#
# --- Root CA: two paths, pick one ---
#
# Simple path (default): leave the three ca_root_* files absent. On first
# start, `step ca init` generates BOTH the root and the intermediate CA
# inside this container, and the root private key stays in
# ./volumes/data/secrets/root_ca_key from then on. Acceptable for a small
# internal PKI where "the CA host and the root-key host are the same
# machine" is an accepted risk — not acceptable if you want the root key to
# never touch a network-connected host. See README.md#root-ca-vs-intermediate-ca.
#
# Hardened path: generate the root CA on a separate, offline machine —
#   step certificate create "Example Root CA" root_ca.crt root_ca_key \
#     --profile root-ca --not-after 87600h
# — copy root_ca.crt, root_ca_key and a password for it into .secrets/ as
# root_ca.crt / root_ca_key / root_ca_key_password.txt, uncomment the three
# ca_root_* secrets in docker-compose.yml and the matching
# DOCKER_STEPCA_INIT_ROOT_FILE / _KEY_FILE / _KEY_PASSWORD_FILE env vars,
# start the container once, then delete root_ca_key and
# root_ca_key_password.txt from THIS host — keep them only on the offline
# machine (or destroy them if the root itself is meant to be single-use).
# The running server only ever needs the intermediate key after that point.
