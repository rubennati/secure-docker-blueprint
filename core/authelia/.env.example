# =============================================================================
# Authelia – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#   ops/init.sh               # secrets, directories and the first user
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=authelia


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The login portal. Every app protected by Authelia sends its visitors here.
APP_TRAEFIK_HOST=auth.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus
# The portal has to be reachable by everyone who logs in to a protected app:
# public when those apps are public, acc-tailscale when they are VPN-only.
APP_TRAEFIK_ACCESS=acc-public
APP_TRAEFIK_SECURITY=sec-3
# Threat enforcement — empty, or a CrowdSec profile with its trailing comma:
#   APP_TRAEFIK_THREAT=crowdsec-basic@file,
APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# authelia (https://hub.docker.com/r/authelia/authelia)
APP_TAG=4.39.28
# postgres (https://hub.docker.com/_/postgres)
DB_TAG=17.11-alpine
# redis (https://hub.docker.com/_/redis)
REDIS_TAG=7.4-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis


# --- Database -------------------------------------------------------- [app] --
DB_NAME=authelia
DB_USER=authelia


# --- Authelia -------------------------------------------------------- [app] --
# Not prefixed AUTHELIA_: Authelia reads every AUTHELIA_* variable as a setting
# and refuses to start on one it does not know.

# The domain the login cookie is set for — the parent of the portal and of
# every protected app. Needs a dot; localhost is refused.
SESSION_COOKIE_DOMAIN=example.com

# info · debug · trace (trace logs request details, not for production)
LOG_LEVEL=info


# --- SMTP ------------------------------------------------------------ [app] --
# Empty SMTP_ADDRESS: one-time codes and reset links are written to
# volumes/data/notification.txt instead of being mailed.
#   submission://smtp.example.com:587    STARTTLS
#   submissions://smtp.example.com:465   TLS from the first byte
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_FROM_ADDRESS=authelia@example.com
SMTP_FROM_NAME=Authelia


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. ops/init.sh creates every file below; by hand:
#
#   mkdir -p .secrets && chmod 700 .secrets
#   openssl rand -hex 32 > .secrets/db_pwd.txt
#   openssl rand -hex 64 > .secrets/jwt_secret.txt
#   openssl rand -hex 64 > .secrets/session_secret.txt
#   openssl rand -hex 64 > .secrets/storage_encryption_key.txt
#   touch .secrets/smtp_password.txt
#
# Authelia runs as 1000:1000 and reads its secrets itself, so they need that
# group (docs/standards/secrets.md):
#   sudo chown "$USER":1000 .secrets/*.txt && chmod 640 .secrets/*.txt
#
# storage_encryption_key.txt encrypts the database's secret columns. Lose it and
# every second factor has to be registered again.
