# traefik-watchdog configuration.
# Copy to /etc/traefik-watchdog.env — do not commit a real copy anywhere.

# Required. The Traefik container's name — matches ${TRAEFIK_CONTAINER_NAME}
# in this stack's own .env.
CONTAINER_NAME=

# Required. A Healthchecks ping URL created specifically for this watchdog —
# https://<your-healthchecks-host>/ping/<uuid>, or the SaaS equivalent. Do not
# reuse a check another job already pings.
HEALTHCHECKS_PING_URL=

# Consecutive unhealthy checks required before the watchdog acts. Traefik's
# own container healthcheck already retries 3 times before reporting
# unhealthy at all (see docker-compose.yml), so this adds a further margin on
# top of that rather than reacting to Traefik's very first internal retry.
CONFIRM_AFTER=3

# Seconds to wait after `docker restart` before re-checking whether it
# worked.
SETTLE_SECONDS=15

# Rarely needs changing.
# STATE_FILE=/var/lib/traefik-watchdog/state
