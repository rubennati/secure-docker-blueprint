# ==========================================================
# CROWDSEC — reverse-proxy remediation middlewares
# ==========================================================
# Rendered to config/dynamic/crowdsec.yml only when CROWDSEC_BOUNCER_ENABLED=true
# in .env; with the switch off, render.sh removes the rendered file. The plugin
# these middlewares use is declared in traefik.yml by the same switch — that
# half is static configuration and needs a recreate of the container, this
# half is hot-reloaded.
#
# Threat enforcement is a deployment decision (D1, 2026-10-18): render.sh
# places one of the two middlewares below on entryPoints.websecure.http
# .middlewares — threat-crowdsec, or threat-crowdsec-appsec when
# CROWDSEC_APPSEC_ENABLED=true — in front of every router's own list, so a
# banned address is refused before any work is done on its request. No router
# names them. Exemptions are CrowdSec AllowLists (core/crowdsec), never a
# label. The entrypoint list is static: after a render that switches the
# bouncer off, recreate the traefik container at once — until then the running
# list names a middleware this file no longer defines, and every router on
# websecure is disabled.
# ==========================================================

http:
  middlewares:

    # ------------------------------------------------------
    # CrowdSec Bouncer Plugin
    # ------------------------------------------------------
    # Prerequisites:
    #   1. core/crowdsec running + on crowdsec-security (created by core/traefik)
    #   2. CROWDSEC_BOUNCER_ENABLED=true in .env — renders the plugin block in
    #      traefik.yml as well as this file
    #   3. Bouncer key: docker exec crowdsec cscli bouncers add traefik-bouncer
    #   4. CROWDSEC_BOUNCER_KEY=<key> in .env
    #
    # Mode: stream (polls LAPI every 60s, caches decisions). The polling loop
    # starts once the entrypoint names the middleware — on the recreate.
    #
    # Which address the bouncer compares with the decisions follows
    # TRAEFIK_FORWARDED_PROXY in .env. The plugin reads X-Forwarded-For, takes
    # the last entry outside forwardedHeadersTrustedIPs, and falls back to the
    # connection only when nothing is left. It never checks who sent the
    # header — the entrypoint does: Traefik deletes X-Forwarded-For from every
    # sender outside forwardedHeaders.trustedIPs. So with `none` the header
    # never arrives and the connecting address is compared; with `cloudflare`
    # render.sh adds forwardedHeadersTrustedIPs (the ranges of
    # ops/cloudflare-ips.txt), a direct client is still compared by its
    # connection, and a request from Cloudflare by the client Cloudflare
    # appended last. forwardedHeadersCustomName is never set: Traefik deletes
    # only X-Forwarded-* and X-Real-Ip, so CF-Connecting-IP or any other header
    # would be read from any sender. A sender whose own address lies inside
    # the trusted ranges — Cloudflare's egress space 172.64.0.0/13 is in the
    # list; whether a WARP client arrives from inside it Cloudflare does not
    # document — is compared as the edge and can place an entry before it
    # (core/traefik/README.md, "Behind Cloudflare").
    #
    # AppSec/WAF is disabled here by default. The AppSec process does
    # not auto-start with CrowdSec — it needs its own config in
    # core/crowdsec/config/appsec.yaml and the port 7422 to be reachable
    # from Traefik. With crowdsecAppsecEnabled=true + unreachable AppSec,
    # crowdsecAppsecUnreachableBlock=true makes the bouncer fail-closed
    # on EVERY request (HTTP 403), which is almost always not what you
    # want for first setup. Enable AppSec only after its server side is
    # verified reachable (`curl crowdsec:7422` from the Traefik container).
    #
    # Geo-blocking works through CrowdSec LAPI decisions (global to all
    # bouncers — not per-app middleware). See core/crowdsec/docs/profiles.md
    # "The profile family" for the geo-* deferred mechanism and its trade-offs.
    # ------------------------------------------------------
    threat-crowdsec:
      plugin:
        bouncer:
          enabled: true
          crowdsecMode: stream
          updateIntervalSeconds: 60
          crowdsecLapiScheme: http
          crowdsecLapiHost: crowdsec:8080
          crowdsecLapiKey: "${CROWDSEC_BOUNCER_KEY}"
          crowdsecAppsecEnabled: false
          crowdsecAppsecHost: crowdsec:7422
          crowdsecAppsecFailureBlock: false
          crowdsecAppsecUnreachableBlock: false
${CROWDSEC_BOUNCER_FORWARDED_YAML}

    # ------------------------------------------------------
    # CrowdSec Bouncer + AppSec (WAF)
    # ------------------------------------------------------
    # Same decisions as threat-crowdsec, plus synchronous inspection of each
    # request against the WAF rule sets. Blocks the individual request; it does
    # not create an IP ban, so a false positive affects one call rather than
    # locking someone out. CROWDSEC_APPSEC_ENABLED=true places this one at the
    # entrypoint instead of threat-crowdsec — for every router at once.
    #
    # Prerequisite: the AppSec engine must answer on 7422. Confirm before
    # switching it on — from the Traefik container:
    #   wget -S -O /dev/null http://crowdsec:7422
    # A 401 is the correct answer (no bouncer key). "Connection refused" means
    # the engine is not listening and this profile will do nothing, or worse if
    # you also set the *Block options below to true.
    #
    # Both failure modes stay fail-open here on purpose: an AppSec outage must
    # not take every application down with it. Setting either to true is a
    # deployment decision for a host whose traffic has been tested against
    # the rules — see core/crowdsec/docs/appsec.md for the
    # per-application false positives already known.
    # ------------------------------------------------------
    threat-crowdsec-appsec:
      plugin:
        bouncer:
          enabled: true
          crowdsecMode: stream
          updateIntervalSeconds: 60
          crowdsecLapiScheme: http
          crowdsecLapiHost: crowdsec:8080
          crowdsecLapiKey: "${CROWDSEC_BOUNCER_KEY}"
          crowdsecAppsecEnabled: true
          crowdsecAppsecHost: crowdsec:7422
          crowdsecAppsecFailureBlock: false
          crowdsecAppsecUnreachableBlock: false
${CROWDSEC_BOUNCER_FORWARDED_YAML}
