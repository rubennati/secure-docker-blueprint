# ==========================================================
# INTEGRATIONS — Authentik
# ==========================================================
# External services that plug into Traefik as middleware.
# Add "middleware-name@file" to a router's middleware list.
#
# This file is empty by default (fully commented out).
#
# The CrowdSec middlewares (crowdsec-basic, crowdsec-appsec) are not here:
# they live in crowdsec.yml.tmpl and are rendered by render.sh only when
# CROWDSEC_BOUNCER_ENABLED=true in .env, together with the plugin block in
# traefik.yml.tmpl. Nothing in this repository is enabled by editing a
# template.
#
# To enable Authentik forward-auth:
#   1. Uncomment the `http:` + `middlewares:` header below
#   2. Uncomment the sec-authentik block
#   3. Add "sec-authentik@file" to the router middleware list of each
#      router that should use it
#
# This file is dynamic configuration: Traefik hot-reloads it, so the
# steps above need no restart.
# ==========================================================

# http:
#   middlewares:

    # ------------------------------------------------------
    # Authentik (SSO / Forward Auth)
    # ------------------------------------------------------
    # Requires: core/authentik running + outpost configured.
    # See core/authentik/README.md — "Integrating other apps via Forward-Auth"
    #
    # address points to the Authentik outpost endpoint. Traefik calls this URL
    # for every request before forwarding it to the target app.
    # The address can point to any reachable host — it does NOT have to be on
    # the same Docker host as Traefik. Examples:
    #   Same host (default): http://authentik-server:9000/...
    #   Other machine in LAN: http://192.168.1.50:9000/...
    #   Central auth server:  https://auth.example.com/...
    # ------------------------------------------------------
#
    # trustForwardHeader is NOT set here. Traefik deprecated it in v3.6.14 in
    # favour of forwardedHeaders.trustedIPs at entrypoint level, which
    # traefik.yml.tmpl already sets for both entrypoints. Setting it to true
    # makes ForwardAuth trust X-Forwarded-* from any source, which is the
    # CVE-2026-35051 and CVE-2026-54764 class: a client spoofs
    # X-Forwarded-Prefix or X-Forwarded-Port and the auth decision follows it.
    # ------------------------------------------------------
#     sec-authentik:
#       forwardAuth:
#         address: "http://authentik-server:9000/outpost.goauthentik.io/auth/traefik"
#         authResponseHeaders:
#           - X-authentik-username
#           - X-authentik-groups
#           - X-authentik-email
#           - X-authentik-name
#           - X-authentik-uid
#           - X-authentik-jwt
#           - X-authentik-meta-jwks
#           - X-authentik-meta-outpost
#           - X-authentik-meta-provider
#           - X-authentik-meta-app
#           - X-authentik-meta-version
