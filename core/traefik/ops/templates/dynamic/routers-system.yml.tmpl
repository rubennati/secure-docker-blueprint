http:
  routers:
    traefik-dashboard:
      rule: "Host(`${TRAEFIK_DASHBOARD_HOST}`)"
      entryPoints:
        - websecure
      service: api@internal
      tls:
        certResolver: ${TRAEFIK_DASHBOARD_CERT_RESOLVER}
        options: ${TRAEFIK_DASHBOARD_TLS_OPTION}
      # The four positions of the model (dynamic/model.yml): the standard
      # headers (first, so a refusal carries them too), VPN only, the strict
      # counter of an administration surface, no gate — the dashboard has
      # Traefik's own API behind it and nothing that logs in. The TLS option
      # is named here on purpose: a system route may be stricter than the
      # deployment standard.
      middlewares:
        - headers-standard@file
        - access-vpn@file
        - limit-strict@file
        - auth-none@file
