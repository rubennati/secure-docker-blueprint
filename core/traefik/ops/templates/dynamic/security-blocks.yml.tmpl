http:
  middlewares:

    # ==========================================================
    # SECURITY BUILDING BLOCKS
    # ==========================================================
    # Modular middleware components. Used by sec-* chains
    # (security-chains.yml), or individually for custom setups.
    #
    # Pro mode: combine blocks directly in router middlewares:
    #   middlewares:
    #     - hdr-strict-embed@file
    #     - rl-hard@file
    #     - compress@file
    # ==========================================================

    # -------- Headers --------

    # Basic security headers (HSTS, nosniff, frame deny)
    hdr-basic:
      headers:
        contentTypeNosniff: true
        frameDeny: true
        forceSTSHeader: true
        stsSeconds: 63072000

    # Basic headers, iframe-friendly (SAMEORIGIN instead of DENY)
    hdr-basic-embed:
      headers:
        contentTypeNosniff: true
        customFrameOptionsValue: "SAMEORIGIN"
        forceSTSHeader: true
        stsSeconds: 63072000

    # Strict headers (preload, referrer policy, CSP report-only)
    hdr-strict:
      headers:
        contentTypeNosniff: true
        frameDeny: true
        forceSTSHeader: true
        stsSeconds: 63072000
        stsIncludeSubdomains: true
        stsPreload: true
        referrerPolicy: "strict-origin-when-cross-origin"
        contentSecurityPolicyReportOnly: "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:;"
        addVaryHeader: true

    # Strict headers, iframe-friendly (SAMEORIGIN, same-origin referrer)
    hdr-strict-embed:
      headers:
        contentTypeNosniff: true
        customFrameOptionsValue: "SAMEORIGIN"
        forceSTSHeader: true
        stsSeconds: 63072000
        stsIncludeSubdomains: true
        stsPreload: true
        referrerPolicy: "same-origin"
        contentSecurityPolicyReportOnly: "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:;"
        addVaryHeader: true

    # -------- Rate Limiting --------

    rl-soft:
      rateLimit:
        average: 100
        burst: 50

    # SPA burst — for apps that load 100+ JS chunks simultaneously on first
    # visit (Nextcloud, NocoDB, n8n, Authentik login, …).
    #
    # Same sustained rate as rl-soft; only the bucket is larger, so the initial
    # chunk requests pass without 429. Sustained abuse is bounded by `average`,
    # which is identical — this is not a weaker limit, and it is appropriate for
    # public apps whose first load needs it.
    rl-spa:
      rateLimit:
        average: 100
        burst: 200

    # First load of a code-split interface that does not fit rl-spa's bucket.
    #
    # Measured 2026-09-22 behind this proxy: Windmill's first load issues about
    # 850 requests and Twenty's 412. With a burst of 200, 412 of Windmill's and
    # 130 of Twenty's came back 429 and neither interface rendered. This bucket
    # holds one full first load of the heavier of the two; the sustained rate —
    # the one that bounds abuse — is identical to rl-soft and rl-spa.
    #
    # A bucket this wide belongs behind a VPN-only access policy: with
    # acc-public one address could issue a thousand requests before the
    # sustained rate applies. scripts/ci/check-structure.py enforces that.
    rl-spa-xl:
      rateLimit:
        average: 100
        burst: 1000

    rl-hard:
      rateLimit:
        average: 20
        burst: 40

    # -------- Extras --------

    compress:
      compress: {}

    permissions-policy:
      headers:
        customResponseHeaders:
          Permissions-Policy: "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

    csp-enforce:
      headers:
        contentSecurityPolicy: "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:;"
