tls:
  options:

    # ==========================================================
    # TLS PROFILES
    # ==========================================================
    # Three profiles:
    #
    # Profile          Min TLS   Use case
    # ---------------  --------  ------------------------------------------
    # tls-compatible   1.2       older clients must connect
    # tls-standard     1.2       strict ciphers + curves — the standard
    # tls-strict       1.3       current clients only
    #
    # `default` is Traefik's reserved name: it is the option every router
    # takes that carries `tls=true` (or a certResolver) without naming an
    # option of its own — measured 2026-10-18, the entrypoint-level option
    # does not reach such routers. TLS_DEFAULT_OPTION in .env names the
    # profile `default` is built from; a change needs a Traefik restart
    # (the file provider's watch does not apply it). A router overrides
    # with tls.options=<profile>@file only with a documented reason, and
    # every router on one host name must name the same option — a conflict
    # falls back to `default` (Traefik logs an error).
    # ==========================================================

    tls-compatible: &tls_compatible
      minVersion: VersionTLS12
      sniStrict: true

    tls-standard: &tls_standard
      minVersion: VersionTLS12
      sniStrict: true
      curvePreferences:
        - X25519
        - CurveP256
        - CurveP384
      cipherSuites:
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305

    tls-strict: &tls_strict
      minVersion: VersionTLS13
      sniStrict: true

    # The deployment standard, from TLS_DEFAULT_OPTION.
    default: *${TLS_DEFAULT_ANCHOR}
