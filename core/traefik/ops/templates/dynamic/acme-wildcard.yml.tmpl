http:
  routers:
    ${ACME_WILDCARD_ROUTER}:
      rule: "Host(`acme-bootstrap.${ACME_WILDCARD_ZONE}`)"
      entryPoints:
        - websecure
      service: noop@internal
      tls:
        certResolver: ${ACME_RESOLVER_DNS}
        domains:
          - main: "${ACME_WILDCARD_ZONE}"
            sans:
              - "*.${ACME_WILDCARD_ZONE}"
