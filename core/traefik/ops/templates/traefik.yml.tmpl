global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: ${TRAEFIK_LOG_LEVEL}
  format: ${TRAEFIK_LOG_FORMAT}
  filePath: "${TRAEFIK_LOG_FILE}"

accessLog:
  filePath: "${TRAEFIK_ACCESSLOG_FILE}"
  format: ${TRAEFIK_ACCESSLOG_FORMAT}
  bufferingSize: ${TRAEFIK_ACCESSLOG_BUFFER}
  filters:
    statusCodes:
      - "200-599"
    retryAttempts: true

api:
  dashboard: true
  insecure: false

ping:
  entryPoint: ping

entryPoints:
  web:
    address: ":80"
    # Trust X-Forwarded-* headers only from Cloudflare's edge IPs — this
    # is what lets Traefik see the real client IP (ClientHost in access
    # logs, ipAllowList evaluation) for traffic that arrives via
    # Cloudflare instead of Cloudflare's own edge address. Never set
    # forwardedHeaders.insecure=true — that trusts forwarded headers
    # from ANY source, letting a client spoof its own IP and bypass
    # ipAllowList entirely. Tailscale traffic does NOT need this — it
    # connects directly, so its source IP is already the real one (see
    # docs/ipv6-dual-stack.md "Cloudflare vs Tailscale").
    # Source: https://www.cloudflare.com/ips/ — re-verify periodically;
    # Cloudflare rarely changes these but does add ranges occasionally.
    forwardedHeaders:
      trustedIPs: &cloudflareTrustedIPs
        # Cloudflare IPv4
        - "173.245.48.0/20"
        - "103.21.244.0/22"
        - "103.22.200.0/22"
        - "103.31.4.0/22"
        - "141.101.64.0/18"
        - "108.162.192.0/18"
        - "190.93.240.0/20"
        - "188.114.96.0/20"
        - "197.234.240.0/22"
        - "198.41.128.0/17"
        - "162.158.0.0/15"
        - "104.16.0.0/13"
        - "104.24.0.0/14"
        - "172.64.0.0/13"
        - "131.0.72.0/22"
        # Cloudflare IPv6
        - "2400:cb00::/32"
        - "2606:4700::/32"
        - "2803:f800::/32"
        - "2405:b500::/32"
        - "2405:8100::/32"
        - "2a06:98c0::/29"
        - "2c0f:f248::/32"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https

  websecure:
    address: ":443"
    # Same Cloudflare allowlist as the "web" entrypoint above.
    forwardedHeaders:
      trustedIPs: *cloudflareTrustedIPs
    # http.aliasHeadersStrategy (Traefik v3.7.12+, replaces
    # underscoreHeadersStrategy) decides what happens to a header whose name
    # aliases another one — X_Forwarded_For against X-Forwarded-For, and every
    # other aliasing character, not only the underscore. Upstream default is
    # "keep", which forwards both and lets the backend pick. "delete" drops the
    # aliased form; "reject" answers 400. A backend that reads the aliased form
    # while a middleware reads the canonical one is the CVE-2026-88011 shape.
    # Left at the upstream default — set it per deployment once the backends
    # behind this proxy are known:
    #   http:
    #     aliasHeadersStrategy: delete
    http3:
      advertisedPort: 443
    http:
      tls:
        options: ${TLS_DEFAULT_OPTION}

  ping:
    address: "127.0.0.1:8082"

providers:
  docker:
    endpoint: "${DOCKER_SOCKET_PROXY_ENDPOINT}"
    exposedByDefault: false
    network: "${PUBLIC_NETWORK}"

  file:
    directory: "/etc/traefik/dynamic"
    watch: true

providersThrottleDuration: 30s

# ---------------------------------------------------------
# PLUGINS — CrowdSec reverse-proxy remediation
# ---------------------------------------------------------
# The block between the two crowdsec-bouncer markers is rendered only when
# CROWDSEC_BOUNCER_ENABLED=true in .env; render.sh removes it otherwise. It is
# static configuration: Traefik reads it at startup, so a change here takes
# effect on `docker compose up -d --force-recreate traefik`, not on a reload.
# The middlewares that use the plugin are in dynamic/crowdsec.yml.tmpl and
# follow the same switch. Do not edit this file to enable the integration —
# set the switch in .env; the template stays as shipped.
# >>> crowdsec-bouncer
experimental:
  plugins:
    bouncer:
      moduleName: "github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin"
      version: "${CROWDSEC_BOUNCER_PLUGIN_VERSION}"
# <<< crowdsec-bouncer

certificatesResolvers:
  ${ACME_RESOLVER_DNS}:
    acme:
      email: "${ACME_EMAIL}"
      storage: "${ACME_STORAGE}"
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "${ACME_DNS_RESOLVER_1}"
          - "${ACME_DNS_RESOLVER_2}"

  ${ACME_RESOLVER_HTTP}:
    acme:
      email: "${ACME_EMAIL}"
      storage: "${ACME_STORAGE}"
      httpChallenge:
        entryPoint: web
