global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: ${TRAEFIK_LOG_LEVEL}
  format: ${TRAEFIK_LOG_FORMAT}
  filePath: "${TRAEFIK_LOG_FILE}"

accessLog:
  filePath: "${TRAEFIK_ACCESSLOG_FILE}"
  format: ${TRAEFIK_ACCESSLOG_FORMAT}
  bufferingSize: ${TRAEFIK_ACCESSLOG_BUFFER}
  filters:
    statusCodes:
      - "200-599"
    retryAttempts: true

api:
  dashboard: true
  insecure: false

ping:
  entryPoint: ping

entryPoints:
  web:
    address: ":80"
    # How long one request may take to arrive, how long one response may take
    # to be written, how long an idle keep-alive connection is kept. The values
    # come from .env; their defaults are Traefik's own (60s / 0 = none / 180s).
    transport:
      respondingTimeouts:
        readTimeout: ${TRAEFIK_READ_TIMEOUT}
        writeTimeout: ${TRAEFIK_WRITE_TIMEOUT}
        idleTimeout: ${TRAEFIK_IDLE_TIMEOUT}
    # forwardedHeaders.trustedIPs decides whose X-Forwarded-* headers survive
    # the entrypoint: kept from these senders, deleted from any other, with
    # X-Real-Ip then set from the connecting address. It does not change what
    # the middlewares evaluate — ipAllowList and rateLimit compare the
    # connecting address unless an ipStrategy / sourceCriterion is set, and
    # the dynamic templates set none. Behind Cloudflare's proxy the access
    # policies and rate limits therefore see the edge address, while
    # ClientHost in the access log and the application see the client
    # (docs/standards/traefik-security.md, "Trusted Proxy Headers").
    # Never set forwardedHeaders.insecure=true: the headers are then kept
    # from every sender, and a client chooses what the application reads as
    # its address. Tailscale and LAN clients connect directly, so their
    # connecting address is the client (docs/ipv6-dual-stack.md, "The three
    # traffic paths").
    # Which senders are trusted is TRAEFIK_FORWARDED_PROXY in .env:
    #   none        — nobody; the list below renders empty. Every client's
    #                 forwarded headers are deleted at the entrypoint.
    #   cloudflare  — Cloudflare's published ranges from ops/cloudflare-ips.txt,
    #                 one range per line, compared with cloudflare.com weekly.
    # render.sh fills the list; edit the file or the switch, never this block.
    forwardedHeaders:
      trustedIPs: &cloudflareTrustedIPs
${CLOUDFLARE_TRUSTED_IPS_YAML}
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https

  websecure:
    address: ":443"
    # Same timeouts as the "web" entrypoint above.
    transport:
      respondingTimeouts:
        readTimeout: ${TRAEFIK_READ_TIMEOUT}
        writeTimeout: ${TRAEFIK_WRITE_TIMEOUT}
        idleTimeout: ${TRAEFIK_IDLE_TIMEOUT}
    # Same Cloudflare allowlist as the "web" entrypoint above.
    forwardedHeaders:
      trustedIPs: *cloudflareTrustedIPs
    # http.aliasHeadersStrategy (Traefik v3.7.12+, replaces
    # underscoreHeadersStrategy) decides what happens to a header whose name
    # aliases another one — X_Forwarded_For against X-Forwarded-For, and every
    # other aliasing character, not only the underscore. Upstream default is
    # "keep", which forwards both and lets the backend pick. "delete" drops the
    # aliased form; "reject" answers 400. A backend that reads the aliased form
    # while a middleware reads the canonical one is the CVE-2026-88011 shape.
    # Left at the upstream default — set it per deployment once the backends
    # behind this proxy are known:
    #   http:
    #     aliasHeadersStrategy: delete
    http3:
      advertisedPort: 443
    http:
      tls:
        options: ${TLS_DEFAULT_OPTION}

  ping:
    address: "127.0.0.1:8082"

providers:
  docker:
    endpoint: "${DOCKER_SOCKET_PROXY_ENDPOINT}"
    exposedByDefault: false
    network: "${PUBLIC_NETWORK}"

  file:
    directory: "/etc/traefik/dynamic"
    watch: true

providersThrottleDuration: 30s

# ---------------------------------------------------------
# PLUGINS — CrowdSec reverse-proxy remediation
# ---------------------------------------------------------
# The block between the two crowdsec-bouncer markers is rendered only when
# CROWDSEC_BOUNCER_ENABLED=true in .env; render.sh removes it otherwise. It is
# static configuration: Traefik reads it at startup, so a change here takes
# effect on `docker compose up -d --force-recreate traefik`, not on a reload.
# The middlewares that use the plugin are in dynamic/crowdsec.yml.tmpl and
# follow the same switch. Do not edit this file to enable the integration —
# set the switch in .env; the template stays as shipped.
# >>> crowdsec-bouncer
experimental:
  plugins:
    bouncer:
      moduleName: "github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin"
      version: "${CROWDSEC_BOUNCER_PLUGIN_VERSION}"
# <<< crowdsec-bouncer

certificatesResolvers:
  ${ACME_RESOLVER_DNS}:
    acme:
      email: "${ACME_EMAIL}"
      storage: "${ACME_STORAGE}"
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "${ACME_DNS_RESOLVER_1}"
          - "${ACME_DNS_RESOLVER_2}"

  ${ACME_RESOLVER_HTTP}:
    acme:
      email: "${ACME_EMAIL}"
      storage: "${ACME_STORAGE}"
      httpChallenge:
        entryPoint: web

  # TLS-ALPN-01. Let's Encrypt opens a TLS connection to port 443 and asks for
  # the ALPN protocol "acme-tls/1"; Traefik answers it and serves the challenge
  # certificate. No entryPoint is configured because the challenge is bound to
  # 443 itself, and no DNS credentials are involved.
  #
  # Three conditions, all outside this file:
  #   - TCP 443 reachable from the internet. UDP 443 (HTTP/3) is irrelevant here.
  #   - NOTHING may terminate TLS in front of Traefik. A CDN or load balancer in
  #     front answers the handshake itself and never forwards the ALPN protocol,
  #     and issuance fails with: cannot negotiate ALPN protocol "acme-tls/1".
  #     Behind Cloudflare's proxy (orange cloud) this resolver cannot work — use
  #     DNS-01 there, or set the record to DNS-only.
  #   - No wildcards. Let's Encrypt issues those over DNS-01 alone, whatever the
  #     proxy is configured to do.
  ${ACME_RESOLVER_TLS}:
    acme:
      email: "${ACME_EMAIL}"
      storage: "${ACME_STORAGE}"
      tlsChallenge: {}
