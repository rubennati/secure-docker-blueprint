# =============================================
# Traefik Reverse Proxy – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

# Compose project name — groups the stack in `docker compose ls`. Container and
# network names are set explicitly below, so changing this does not rename
# anything on an existing install.
COMPOSE_PROJECT_NAME=traefik

# ------------------------------------------------------------
# Core
# ------------------------------------------------------------
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# Images
TRAEFIK_IMAGE=traefik:v3.7
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.5.0

# Container names
TRAEFIK_CONTAINER_NAME=traefik-core
SOCKET_PROXY_CONTAINER_NAME=traefik-socket-proxy

# Memory ceiling for Traefik. Measured over 22 hours with about forty routers:
# 45-60 MiB idle, settling at a plateau of about 124 MiB of application memory
# after a day of browser loads, with no growth beyond it; up to 285 MiB while
# browsers loaded code-split interfaces through it. The former 128M was too
# small — the kernel ended the container with about 400 TLS connections open,
# and every route went with it.
#
# Raise it to 512m from the start where this proxy carries many stacks or more
# than a handful of people. It is a ceiling against runaway growth, so a larger
# value costs nothing while nothing runs away.
TRAEFIK_MEMORY=256m

# Networks
PUBLIC_NETWORK=proxy-public
SOCKET_PROXY_NETWORK=socket_proxy_net

# Carries Traefik-to-CrowdSec LAPI/AppSec traffic only. Created by this stack;
# core/crowdsec joins it as an external network.
CROWDSEC_SECURITY_NETWORK=crowdsec-security

# ------------------------------------------------------------
# Dual-stack IPv6 (optional) — see network-dual-stack.yml
# ------------------------------------------------------------
# Only read when network-dual-stack.yml is applied (-f flag or
# COMPOSE_FILE). Leave commented out for IPv4-only (default, unchanged
# behavior — Docker auto-assigns the IPv4 subnet as today).
#
# Recommended for new deployments: Tailscale always hands out an IPv6
# address, and without IPv6 on this network, Tailscale IPv6 clients
# lose their real source IP (see core/traefik/docs/ipv6-dual-stack.md).
#
# Pick your own IPv6 ULA prefix for production — fd00:dead:beef:30::/64
# below is an example only, not a value to copy as-is. Generate one at
# https://www.unique-local-ipv6.com/ or with `openssl rand -hex 5`
# formatted into fd00:XXXX:XXXX:XXXX::/64. See
# core/traefik/docs/ipv6-dual-stack.md "Choosing a ULA prefix".
# PUBLIC_NETWORK_SUBNET_V4=172.30.0.0/16
# PUBLIC_NETWORK_SUBNET_V6=fd00:dead:beef:30::/64

# ------------------------------------------------------------
# Ports (host)
# ------------------------------------------------------------
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# ------------------------------------------------------------
# Docker Socket Proxy endpoint used by Traefik
# Must match the docker-compose service name + port.
# ------------------------------------------------------------
DOCKER_SOCKET_PROXY_ENDPOINT=tcp://docker-socket-proxy:2375

# ------------------------------------------------------------
# Tailscale / VPN
# ------------------------------------------------------------
TAILSCALE_CIDR_V4=100.64.0.0/10
TAILSCALE_CIDR_V6=fd7a:115c:a1e0::/48


# ------------------------------------------------------------
# ACME / Let's Encrypt — certificate strategy
# ------------------------------------------------------------
# Two working modes. Pick one — this file ships with neither preselected, so
# validate.sh stops until the choice is made. Both are fully supported; the
# Blueprint does not prescribe one.
#
# Path A — Wildcard (*.example.com):
#   - Set ACME_WILDCARD_DOMAIN below
#   - Set CF_DNS_API_TOKEN below
#   - In every app's docker-compose.yml, leave the
#     "tls.certresolver=..." label COMMENTED OUT
#   - Leave TRAEFIK_DASHBOARD_CERT_RESOLVER EMPTY — the dashboard is served
#     the wildcard through SNI, like every application router
#
# Path B — Per-domain (one cert per subdomain):
#   - Leave ACME_WILDCARD_DOMAIN EMPTY (or commented out)
#   - In every app's docker-compose.yml, UNCOMMENT the
#     "tls.certresolver=..." label
#   - Set TRAEFIK_DASHBOARD_CERT_RESOLVER
#   - Works with either Cloudflare DNS-01 or HTTP-01
#
# Each certificate issued for a single hostname publishes that hostname in
# public Certificate Transparency logs. A wildcard publishes only
# "*.example.com", so covered service names are not listed one by one — the
# base domain is public either way, and this reduces service enumeration
# rather than providing access control.
#
# validate.sh refuses to pass while neither is configured for the dashboard host,
# because that combination produces no certificate at all: Traefik answers HTTPS
# with its self-signed default and logs nothing. The same applies to application
# routers, where the per-app label carries the choice.
#
# Full reference: README.md → "Certificate strategy"
# ------------------------------------------------------------

ACME_EMAIL=letsencrypt@example.com
ACME_STORAGE=/etc/traefik/acme/acme.json

# Resolver names (must match config/traefik.yml). All three are defined; a
# resolver that no router names issues nothing, so defining one costs nothing.
#   cloudflare-dns  DNS-01       wildcards, and any host without a public port
#   httpResolver    HTTP-01      needs public TCP 80
#   tlsResolver     TLS-ALPN-01  needs public TCP 443 and no TLS terminator in
#                                front — see README, "Certificate strategy"
ACME_RESOLVER_DNS=cloudflare-dns
ACME_RESOLVER_HTTP=httpResolver
ACME_RESOLVER_TLS=tlsResolver

# Cloudflare DNS-01 — required for wildcard. Also usable per-domain.
# Token scope: Zone:Read + DNS:Edit on the relevant zone.
CF_DNS_API_TOKEN=__REPLACE_ME__

# DNS resolvers used for ACME DNS-01 propagation checks
ACME_DNS_RESOLVER_1=1.1.1.1:53
ACME_DNS_RESOLVER_2=1.0.0.1:53

# Path A only — set to your apex domain to enable wildcard.
# Leave empty / commented for Path B (per-domain certs).
# ACME_WILDCARD_DOMAIN=example.com

# ------------------------------------------------------------
# System Routes
# ------------------------------------------------------------
TRAEFIK_DASHBOARD_HOST=traefik.example.com

# TLS options
TLS_DEFAULT_OPTION=tls-basic
TRAEFIK_DASHBOARD_TLS_OPTION=tls-modern

# Dashboard certificate. Empty on Path A when the wildcard covers this host
# — *.example.com matches exactly one label, so traefik.example.com is covered
# and traefik.admin.example.com is not. Required on Path B.
TRAEFIK_DASHBOARD_CERT_RESOLVER=

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_LOG_FORMAT=json
TRAEFIK_LOG_FILE=/var/log/traefik/traefik.log

TRAEFIK_ACCESSLOG_FORMAT=json
TRAEFIK_ACCESSLOG_FILE=/var/log/traefik/access.log
TRAEFIK_ACCESSLOG_BUFFER=100

# ------------------------------------------------------------
# CrowdSec reverse-proxy remediation (optional)
# ------------------------------------------------------------
# One switch renders both halves of the integration: the bouncer plugin in
# config/traefik.yml (static — takes effect on a Traefik restart) and the
# crowdsec-basic / crowdsec-appsec middlewares in config/dynamic/crowdsec.yml
# (hot-reloaded). false renders neither and removes the middleware file.
# Prerequisites: core/crowdsec running and reachable as crowdsec:8080 on the
# crowdsec-security network, and a bouncer key from the engine:
#   docker exec crowdsec cscli bouncers add traefik-bouncer
# A rendered middleware protects nothing until a router carries it —
# APP_TRAEFIK_THREAT in the application's .env (docs/standards/traefik-labels.md).
CROWDSEC_BOUNCER_ENABLED=false
# Plugin release. Traefik fetches and compiles it at startup, so a bump takes
# effect on restart. Check it against the running Traefik version first:
#   https://github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin/releases
CROWDSEC_BOUNCER_PLUGIN_VERSION=v1.7.1
# Required when the switch is on. validate.sh refuses an empty key.
CROWDSEC_BOUNCER_KEY=

# ------------------------------------------------------------
# Docker Socket Proxy (HAProxy template variables)
# ------------------------------------------------------------
DSP_LOG_LEVEL=info
DSP_SOCKET_PATH=/var/run/docker.sock
DSP_BIND_CONFIG=0.0.0.0:2375
DSP_POST=0
