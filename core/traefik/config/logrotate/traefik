# Logrotate config for Traefik (Docker-based)
#
# Traefik writes access.log and traefik.log to a bind-mounted volume.
# Docker's json-file log driver does NOT manage these — logrotate must.
#
# Install on the HOST (not inside the container):
#   sudo cp /path/to/secure-docker-blueprint/core/traefik/config/logrotate/traefik /etc/logrotate.d/traefik
#
# The path must match the HOST-side volume mount in docker-compose.yml:
#   ./volumes/logs:/var/log/traefik
#
# Both logs are truncated in place (copytruncate), and no signal is sent.
#
# No `docker kill --signal=USR1`: Docker treats any `docker kill`, whatever the
# signal, as a stop by hand and cancels the container's restart policy until
# the next start. Measured on 2026-09-22 (Docker 29.8.1): after the nightly
# rotation had sent USR1, Traefik was killed for memory and stayed down, and
# every route with it; a throwaway container was restarted after an OOM kill
# without the signal and not restarted with it.
#
# Renaming traefik.log never worked anyway: Traefik 3 reopens only the access
# log on USR1 — measured on 2026-09-14 (v3.7.13). The main log's descriptor
# stayed on traefik.log.1, the visible file at zero bytes, and the next
# rotation compressed the file Traefik was writing to.
#
# copytruncate copies the content out and truncates the file in place. Traefik
# opens both logs O_APPEND, so it keeps its descriptors and continues at the
# new end. Lines written between the copy and the truncate are lost — the
# requests of that instant.
#
# "systemctl reload traefik" does NOT work because Traefik runs in Docker.

/path/to/secure-docker-blueprint/core/traefik/volumes/logs/access.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    # Rotate on size as well as on the day, so a request flood does not fill the
    # disk waiting for tomorrow. Access logs are one line per request: a burst
    # reaches this in minutes, and the fastest route to a full disk is the log
    # written about it.
    #
    # This only bites when logrotate runs. Debian runs it daily, which bounds
    # the file at one day's traffic rather than at maxsize. If that matters,
    # run it hourly:
    #
    #   sudo systemctl edit logrotate.timer
    #   [Timer]
    #   OnCalendar=
    #   OnCalendar=hourly
    maxsize 100M
    # No signal, no create: the file is truncated in place. See the note at the top.
    copytruncate
}

/path/to/secure-docker-blueprint/core/traefik/volumes/logs/traefik.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    maxsize 100M
    # No signal, no create: the file is truncated in place and Traefik keeps
    # writing to it. See the note at the top.
    copytruncate
}
