# Logrotate config for Traefik (Docker-based)
#
# Traefik writes access.log and traefik.log to a bind-mounted volume.
# Docker's json-file log driver does NOT manage these — logrotate must.
#
# Install on the HOST (not inside the container):
#   sudo cp /path/to/secure-docker-blueprint/core/traefik/config/logrotate/traefik /etc/logrotate.d/traefik
#
# The path must match the HOST-side volume mount in docker-compose.yml:
#   ./volumes/logs:/var/log/traefik
#
# postrotate sends USR1 to the Traefik container, which tells Traefik
# to close and reopen its log files (like nginx's USR1 signal).
# "systemctl reload traefik" does NOT work because Traefik runs in Docker.

/path/to/secure-docker-blueprint/core/traefik/volumes/logs/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root adm

    # Rotate on size as well as on the day, so a request flood does not fill the
    # disk waiting for tomorrow. Access logs are one line per request: a burst
    # reaches this in minutes, and the fastest route to a full disk is the log
    # written about it.
    #
    # This only bites when logrotate runs. Debian runs it daily, which bounds
    # the file at one day's traffic rather than at maxsize. If that matters,
    # run it hourly:
    #
    #   sudo systemctl edit logrotate.timer
    #   [Timer]
    #   OnCalendar=
    #   OnCalendar=hourly
    maxsize 100M

    postrotate
        docker kill --signal=USR1 traefik-core >/dev/null 2>&1 || true
    endscript
}
