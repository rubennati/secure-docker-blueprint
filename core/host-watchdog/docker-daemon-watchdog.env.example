# docker-daemon-watchdog configuration.
# Copy to /etc/docker-daemon-watchdog.env — do not commit a real copy anywhere.

# Required. A Healthchecks ping URL created specifically for this watchdog —
# https://<your-healthchecks-host>/ping/<uuid>, or the SaaS equivalent.
# A monitoring/healthchecks on this same host: http://127.0.0.1:8001/ping/<uuid>
# (its loopback port, HC_LOCAL_PORT) — not the public name, which a closed
# access policy refuses for the host.
# Do not reuse a check another job already pings: this watchdog needs its own
# start/finish/fail history to mean anything.
HEALTHCHECKS_PING_URL=

# Consecutive failed checks required before the watchdog acts. At the default
# 2-minute timer interval, 3 means roughly 4-6 minutes of sustained failure
# before anything is restarted — long enough that a single missed check does
# not trigger a restart.
CONFIRM_AFTER=3

# Seconds to wait after `systemctl restart docker` before re-checking whether
# it worked.
SETTLE_SECONDS=10

# Longest wait for `systemctl restart docker` itself. Docker's unit has no start
# timeout, so a daemon that hangs while starting would otherwise hold the
# watchdog for good; after this the check runs and reports the failure.
RESTART_TIMEOUT=180

# Rarely needs changing.
# DOCKER_SOCKET=/var/run/docker.sock
# STATE_FILE=/var/lib/docker-daemon-watchdog/state
