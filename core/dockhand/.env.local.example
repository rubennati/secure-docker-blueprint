# Dockhand — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=v1.0.39
DB_TAG=16-alpine
SOCKET_PROXY_TAG=v0.4.2

# --- Database -------------------------------------------------------- [app] --
DB_NAME=dockhand
DB_USER=dockhand
#   openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__

# --- App Configuration ----------------------------------------------- [app] --
#   openssl rand -base64 32 | tr -d '\n'
ENCRYPTION_KEY=__REPLACE_ME__
APP_PUID=1000
APP_PGID=1000

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
