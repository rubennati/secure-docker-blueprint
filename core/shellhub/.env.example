# =============================================================================
# ShellHub – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=shellhub


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The gateway (web UI + API) only. The SSH rendezvous port below — where
# registered agents dial in and where you connect out — never goes through
# Traefik; see README.md#network-exposure.

APP_TRAEFIK_HOST=shellhub.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-modern
APP_TRAEFIK_ACCESS=acc-tailscale
APP_TRAEFIK_SECURITY=sec-3
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# shellhub-io/shellhub (https://github.com/shellhub-io/shellhub)
# server has NO stable Docker Hub tag as of this writing — only v0.27.0
# release candidates exist (verified: hub.docker.com/r/shellhubio/server/tags
# lists nine tags, all `-rc.N`). ui and gateway do have a stable v0.26.0.
# All three are pinned to the matching v0.27.0 RC so the three components
# stay on one version, per the vendor's own single-${SHELLHUB_VERSION}
# compose model — check for a stable v0.27.0+ tag before every deploy:
# https://hub.docker.com/r/shellhubio/server/tags
SHELLHUB_VERSION=v0.27.0-rc.11
VALKEY_TAG=9.1-alpine
DB_TAG=18.0


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_SERVER=${COMPOSE_PROJECT_NAME}-server
CONTAINER_NAME_UI=${COMPOSE_PROJECT_NAME}-ui
CONTAINER_NAME_GATEWAY=${COMPOSE_PROJECT_NAME}-gateway
CONTAINER_NAME_VALKEY=${COMPOSE_PROJECT_NAME}-valkey
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db


# --- Database -------------------------------------------------------- [app] --
DB_NAME=shellhub
DB_USER=shellhub


# --- App Configuration ----------------------------------------------- [app] --
# Direct, host-published port — not Traefik. Default upstream is 22, moved
# to 2222 here to avoid colliding with the host's own SSH daemon (verified
# default in upstream's own .env: SHELLHUB_SSH_PORT=22).
SHELLHUB_SSH_PORT=2222

# community is the only edition this deployment configures — SAML SSO is
# confirmed Enterprise-only (README.md#security-model). Kept explicit
# because the vendor's own compose reads this value.
SHELLHUB_EDITION=community

# Tells the server/gateway they sit behind a reverse proxy — verified
# upstream vars, default false. Required for Traefik's X-Forwarded-* headers
# to be trusted instead of ignored.
SHELLHUB_PROXY=true
SHELLHUB_PROXY_TRUSTED_IPS="0.0.0.0/0 ::/0"

# Gateway terminates its own TLS by default (SHELLHUB_AUTO_SSL). Left false:
# Traefik terminates TLS for every other stack in this repository, and
# ShellHub's own env vars exist specifically to support that instead.
SHELLHUB_AUTO_SSL=false

SHELLHUB_LOG_LEVEL=info
SHELLHUB_LOG_FORMAT=json


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# Two different mechanisms, matching upstream's own split interface:
#
# Real Docker Secrets (upstream reads these paths natively — verified in
# the official docker-compose.yml: PRIVATE_KEY, PUBLIC_KEY and
# SSH_HOST_KEY_FILE all point at /run/secrets/*):
#
#   mkdir -p .secrets volumes/postgres
#   ssh-keygen -t rsa -b 4096 -m PEM -f .secrets/ssh_private_key -N ""
#   openssl genrsa -out .secrets/api_private_key 4096
#   openssl rsa -in .secrets/api_private_key -pubout -out .secrets/api_public_key
#
# RSA/PEM chosen as the broadly-compatible default; not verified against
# ShellHub's exact key-format requirements — check server logs on first
# start and regenerate if it rejects either key.
#
# Plain env var (Postgres itself supports _FILE natively, but the server
# component's SHELLHUB_POSTGRES_PASSWORD does not — verified upstream
# compose. The database's own POSTGRES_PASSWORD_FILE is used below;
# server receives the same value in clear because it has no _FILE
# alternative. This is a deviation, not an oversight — see UPSTREAM.md):
#
#   openssl rand -hex 32 > .secrets/db_pwd.txt
#
# Copy .secrets/db_pwd.txt's contents into .env as SHELLHUB_POSTGRES_PASSWORD.
SHELLHUB_POSTGRES_PASSWORD=
