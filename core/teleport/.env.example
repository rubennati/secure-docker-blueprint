# =============================================================================
# Teleport – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# This stack does not go through Traefik at all — see README.md#network-exposure
# for why — so there is no [traefik] section here, unlike every other stack
# in this repository.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=teleport


# --- Images -------------------------------------------------------- [image] --
# gravitational/teleport (https://github.com/gravitational/teleport)
# -distroless: no shell, no package manager — smallest attack surface,
# verified: `docker run --entrypoint /bin/sh` fails, /bin/sh does not exist.
APP_TAG=18.11.0


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- App Configuration ----------------------------------------------- [app] --
# Direct, host-published ports — not Traefik. See README.md#network-exposure
# for why Traefik cannot sit in front of this stack's HTTPS port.
TELEPORT_AUTH_PORT=3025
TELEPORT_PROXY_PORT=3080

TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES HERE. Teleport takes no credentials via environment or
# compose at all — everything lives in ./config/teleport.yaml, generated
# once by the one-time setup command in README.md#setup, and in
# ./volumes/data, its BoltDB backend holding the cluster CA, host
# certificates and every issued user/host certificate. Treat both like
# Docker Secrets: back them up encrypted, never commit them, and restrict
# host filesystem permissions.
