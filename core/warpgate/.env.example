# =============================================================================
# Warpgate – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=warpgate


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The admin web UI only. The SSH (and any protocol) proxy ports below never go
# through Traefik — see README.md#network-exposure.

APP_TRAEFIK_HOST=warpgate.example.com

# Certificate resolver — only used when the certresolver label is uncommented
# in docker-compose.yml (per-domain certs). With a wildcard cert, leave alone.
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS profile. tls-modern (TLS 1.3 only) — an admin console for a PAM/bastion
# deserves the strictest available profile, matching core/vaultwarden's choice
# for the same reason.
APP_TRAEFIK_TLS_OPTION=tls-modern

# WHO may reach the admin UI. This console can create SSO/local users and
# manage every configured target — VPN-only by default, not acc-public.
APP_TRAEFIK_ACCESS=acc-tailscale

# WHAT headers / rate limit apply.
APP_TRAEFIK_SECURITY=sec-3

# Threat enforcement — empty by default: no CrowdSec bouncer on this router.
# See core/crowdsec/docs/profiles.md to enable one.
APP_TRAEFIK_THREAT=

# Shared proxy network, created by core/traefik. Same value in every app.
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# warp-tech/warpgate (https://github.com/warp-tech/warpgate)
APP_TAG=0.29.0


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- App Configuration ----------------------------------------------- [app] --
# Direct, host-published ports — not Traefik. See README.md#network-exposure
# for why these cannot be reverse-proxied and what reaches them.

# SSH protocol proxy. Reached by anyone with an account, from wherever your
# access policy allows — set this in warpgate.yaml, not here.
WARPGATE_SSH_PORT=2222

# MySQL protocol proxy. Only relevant once a MySQL target is configured in the
# admin UI — comment out the port publish in docker-compose.yml if unused.
WARPGATE_MYSQL_PORT=33306


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION. Warpgate has no _FILE-style secret input —
# verified: its non-interactive setup command takes the initial admin
# password as the WARPGATE_ADMIN_PASSWORD environment variable, consumed
# once and not persisted to compose. Generate it and use it only for the
# one-time setup command in README.md#setup:
#
#   openssl rand -base64 24 | tr -d '\n' > .secrets/admin_password.txt
#
# After setup, ./volumes/data/warpgate.yaml and its SQLite database ARE the
# secret — the admin password hash, every session/audit record, and (until
# replaced with a real certificate) the self-signed TLS key all live there.
# Treat that directory like a Docker Secret: back it up encrypted, never
# commit it, and keep it owned by UID 1000 (README.md#setup) — not world- or
# group-readable.
