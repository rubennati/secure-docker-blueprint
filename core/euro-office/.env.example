# =============================================
# Euro-Office Document Server – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================
#
# EU-governed fork of OnlyOffice (Nextcloud, IONOS, XWiki, Proton).
# Drop-in replacement for OnlyOffice Document Server — in-browser editing
# of docx/xlsx/pptx for Seafile, Nextcloud, or any WOPI-compatible app.
#
# After setup, each consuming app connects to:
#   https://<APP_TRAEFIK_HOST>/web-apps/apps/api/documents/api.js
# and authenticates with the JWT secret in ./.secrets/jwt_secret.txt
# =============================================

COMPOSE_PROJECT_NAME=euro-office

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=office.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# TLS profile: tls-basic (TLS 1.2), tls-aplus (TLS 1.2 strict), tls-modern (TLS 1.3 only)
APP_TRAEFIK_TLS_OPTION=tls-aplus
# Access: acc-public, acc-local, acc-tailscale, acc-private, acc-deny
APP_TRAEFIK_ACCESS=acc-public
# NOTE: APP_TRAEFIK_SECURITY is intentionally NOT used — every sec-* chain sets
# X-Frame-Options: DENY, which blocks iframe embedding in Seafile / Nextcloud.
# docker-compose.yml defines an iframe-friendly middleware chain instead.
APP_INTERNAL_PORT=80
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# ghcr.io/euro-office/documentserver (https://github.com/euro-office/DocumentServer)
APP_TAG=v9.3.2

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app

# --- Integration ---
# Domains allowed to embed Euro-Office in an iframe (CSP frame-ancestors).
# Space-separated, each with https:// prefix.
EURO_OFFICE_ALLOWED_ORIGINS=https://files.example.com https://cloud.example.com

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna
TZ=UTC

# --- Secrets ---
# Create the secrets directory and generate the JWT secret:
#   mkdir -p .secrets
#   openssl rand -base64 30 | tr -d '\n' > .secrets/jwt_secret.txt
#
# Each consuming app (Seafile, Nextcloud, …) needs the same secret.
