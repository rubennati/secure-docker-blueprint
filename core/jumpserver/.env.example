# =============================================================================
# JumpServer – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=jumpserver


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The web console + API only. The SSH gateway (koko, bundled inside this
# image) never goes through Traefik — see README.md#network-exposure.

APP_TRAEFIK_HOST=jumpserver.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns

# TLS profile. tls-modern — a PAM console deserves the strictest available
# profile, matching this repository's other privileged-access stacks.
APP_TRAEFIK_TLS_OPTION=tls-modern

# WHO may reach the web console. A traditional PAM platform holds every
# credential and every session recording it manages — VPN-only, not public.
APP_TRAEFIK_ACCESS=acc-tailscale

APP_TRAEFIK_SECURITY=sec-3
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# jumpserver/jms_all (https://hub.docker.com/r/jumpserver/jms_all) — the
# vendor's own all-in-one image: core + koko (SSH gateway) + web UI +
# bundled PostgreSQL + Redis + nginx, one process tree under supervisord.
# No first-party multi-service compose reference exists to decompose this
# into separate, individually-hardened containers — see UPSTREAM.md.
APP_TAG=v4.10.19


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app


# --- App Configuration ----------------------------------------------- [app] --
# Direct, host-published port — not Traefik. See README.md#network-exposure.
JUMPSERVER_SSH_PORT=2222

TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO _FILE SUPPORT — verified against the vendor's documented interface:
# SECRET_KEY and BOOTSTRAP_TOKEN are plain environment variables with no
# _FILE-suffixed alternative. Generate both, keep them in .secrets/ for
# reference (they are also this stack's record of what you generated), and
# copy their contents into .env directly. This is a documented deviation
# from this repository's Docker Secrets default — see UPSTREAM.md.
#
#   mkdir -p .secrets volumes/data volumes/postgres
#   openssl rand -base64 32 | tr -d '\n' > .secrets/secret_key.txt
#   openssl rand -base64 16 | tr -d '\n' > .secrets/bootstrap_token.txt
#
# Then, in .env (not committed):
#   SECRET_KEY=<contents of .secrets/secret_key.txt>
#   BOOTSTRAP_TOKEN=<contents of .secrets/bootstrap_token.txt>
SECRET_KEY=
BOOTSTRAP_TOKEN=
