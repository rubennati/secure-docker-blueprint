# Orion Belt agent — deployed on a protected host, not on the Orion Belt
# server host. See docker-compose.agent.yml.

ORION_AGENT_TAG=1.2.0

# The Orion Belt server's public address and SSH gateway port.
ORION_SERVER_HOST=orion-belt.example.com
ORION_SERVER_PORT=2222

# A name identifying this host in the console.
ORION_AGENT_NAME=changeme

ORION_AGENT_ENV=production

# ask | auto-accept | auto-reject — how the agent treats an unrecognized
# server host key. "ask" is not viable for a headless agent; pick a
# deliberate default instead.
ORION_STRICT_HOST_KEY_CHECKING=auto-accept
