# =============================================================================
# Orion Belt (EXPERIMENTAL) – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# EXPERIMENTAL — see README.md before deploying this. Single maintainer,
# 43 GitHub stars, repository created 2026-01, first stable tag 2026-07-14.
# A PAM tool is exactly the kind of software where a project's youth is a
# real risk to weigh, not a formality.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=orion-belt


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The API / web console only. The SSH gateway port never goes through
# Traefik — see README.md#network-exposure.

APP_TRAEFIK_HOST=orion-belt.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-modern
APP_TRAEFIK_ACCESS=acc-tailscale
APP_TRAEFIK_SECURITY=sec-3
APP_TRAEFIK_THREAT=

TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# orion-belt-dev/orion-belt (https://github.com/orion-belt-dev/orion-belt)
APP_TAG=1.2.0
DB_TAG=16-alpine


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db


# --- Database -------------------------------------------------------- [app] --
DB_NAME=orionbelt
DB_USER=orionbelt


# --- App Configuration ----------------------------------------------- [app] --
# Direct, host-published port — not Traefik. See README.md#network-exposure.
ORION_SSH_PORT=2222

# Advertised origin — what browsers and agents use to reach this gateway.
# Same value as APP_TRAEFIK_HOST, over HTTPS.
ORION_PUBLIC_URL=https://orion-belt.example.com
ORION_PUBLIC_HOST=orion-belt.example.com

# Local MFA — no OIDC/SSO connector was found in the documented
# configuration as of v1.2.0 (see UPSTREAM.md). WebAuthn on, TOTP-style
# password-only login not required by default; set to true once at least
# one user has enrolled a factor.
ORION_MFA_REQUIRED=false
ORION_WEBAUTHN_ENABLED=true

# Session recordings — see Security Model before enabling encryption
# without a real key.
ORION_RECORDING_RETENTION_DAYS=90

TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO _FILE SUPPORT — verified directly by reading the image's own
# /app/entrypoint.sh: POSTGRES_PASSWORD and ORION_JWT_SECRET are read as
# plain environment variables and written in clear into a generated config
# file inside the container. This is a deviation from this repository's
# Docker Secrets default, not an oversight — see UPSTREAM.md for the exact
# entrypoint behavior and the documented ORION_CONFIG_FILE escape hatch
# that could close this gap with more setup effort than this deployment
# takes on.
#
#   openssl rand -hex 32 > .secrets/db_pwd.txt
#   openssl rand -hex 32 > .secrets/jwt_secret.txt
#
# Copy both files' contents into .env directly:
POSTGRES_PASSWORD=
ORION_JWT_SECRET=

# Optional — encrypts session recordings at rest. Leave empty and
# recordings are stored unencrypted; generate one if you enable recording
# in the admin console.
#   openssl rand -hex 32 > .secrets/recording_key.txt
ORION_RECORDING_ENCRYPTION_KEY=
