# =============================================
# Portainer CE – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
# =============================================

COMPOSE_PROJECT_NAME=portainer

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=portainer.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# TLS: the deployment standard (TLS_DEFAULT_OPTION in core/traefik/.env) serves
# every router that names no option. This stack names one — a documented
# exception, kept from before the model:
# no reason recorded. Verify on a host whether the standard serves its clients,
# then remove this variable and the tls.options label in docker-compose.yml.
APP_TRAEFIK_TLS_OPTION=tls-strict
# Access: access-public, access-trusted, access-vpn, access-trusted-vpn, access-blocked
APP_TRAEFIK_ACCESS=access-vpn
# limit-strict (20/s, burst 40). Portainer's
# interface is a single-page app whose first load has not been counted against
# that bucket here. If the UI comes up blank or half-rendered on a cold cache,
# that is a 429 from the proxy and not Portainer: move to limit-standard, which
# keeps the headers and widens the burst to 500.
APP_TRAEFIK_LIMIT=limit-strict
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# auth posture: app-login — the application's own login governs every request
APP_TRAEFIK_AUTH=auth-none@file
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# portainer-ce (https://hub.docker.com/r/portainer/portainer-ce)
APP_TAG=2.39.7
# linuxserver/socket-proxy (https://hub.docker.com/r/linuxserver/socket-proxy)
SOCKET_PROXY_TAG=3.4.4

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_SOCKET_PROXY=${COMPOSE_PROJECT_NAME}-socket-proxy

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna, America/New_York
TZ=UTC

# --- Secrets ---
# No external secrets required. Portainer prompts for an admin password
# on first-time access through the web UI. Credentials are stored
# bcrypt-hashed in ./volumes/data/portainer.db.
