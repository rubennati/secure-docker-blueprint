# =============================================================================
# headscale – Environment
# =============================================================================
#   cp .env.example .env      # then fill in real values
#
# NEVER commit .env. Only .env.example (placeholders) belongs in git.
#
# Spec: docs/standards/env-structure.md · naming: naming-conventions.md
# =============================================================================


# --- Project ---------------------------------------------------- [compose] --
COMPOSE_PROJECT_NAME=headscale


# --- Domain & Traefik ------------------------------------------- [traefik] --
# The address every client is told to come back to. It becomes
# HEADSCALE_SERVER_URL, goes into every node's configuration, and has to be
# reachable by the clients you want to join.
APP_TRAEFIK_HOST=headscale.example.com

APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
APP_TRAEFIK_TLS_OPTION=tls-aplus

# WHO may reach it:
#   acc-public     everyone
#   acc-local      LAN only (RFC1918)
#   acc-tailscale  VPN only
#   acc-private    LAN + VPN
#   acc-deny       nobody — the emergency kill switch
#
# **This ships closed, like every other stack here.** A first start is for
# creating a user and a pre-auth key, not for accepting nodes from the
# internet — so the default is the LAN you set it up from.
#
# Opening it is a deliberate step, and it is the one this product eventually
# needs: a client that is not already on your network cannot join a control
# server it cannot reach. When you take that step, `acc-public` is not the only
# option — an IP allow-list, an SSH tunnel for the first join, or leaving it on
# the LAN and joining nodes there all work. README, "Letting clients in", has
# the trade-offs.
#
# Note what closed does NOT mean here: acc-tailscale would be circular, since
# this server is what that tailnet's control plane would be.
APP_TRAEFIK_ACCESS=acc-local

# WHAT headers / rate limit apply. Higher = stricter.
#   sec-0 … sec-5   see docs/standards/traefik-security.md
#
# Clients poll this endpoint and hold long connections open. Not measured under
# a real node count — see README, "Known limits".
APP_TRAEFIK_SECURITY=sec-2

APP_TRAEFIK_THREAT=
TRAEFIK_NETWORK=proxy-public


# --- Images -------------------------------------------------------- [image] --
# headscale (https://github.com/juanfont/headscale)
APP_TAG=v0.29.4


# --- Containers -------------------------------------------------- [compose] --
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}


# --- App Configuration ----------------------------------------------- [app] --
# The DNS suffix inside the tailnet: a node called `laptop` becomes
# `laptop.${APP_TAILNET_DOMAIN}`. It must NOT contain APP_TRAEFIK_HOST —
# headscale refuses to start if the control server's name sits inside it.
#
# A name you do not resolve publicly is the point; `.internal` is reserved for
# exactly this.
APP_TAILNET_DOMAIN=tailnet.internal

# The uid headscale runs as. The image declares root and does not need it;
# ./volumes/lib has to belong to this uid before the first start.
APP_UID=1000
APP_GID=1000

# Only used with derp.yml — the embedded relay's STUN port, published straight
# to the host because STUN is not HTTP and Traefik cannot route it.
APP_DERP_STUN_PORT=3478


# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC


# --- Secrets ------------------------------------------------------ [secrets] --
# NO VARIABLES IN THIS SECTION — only the commands that create the secret files.
#
# headscale has no password and no secret file of its own in this stack: the
# node key and the DERP key are generated on first start into ./volumes/lib,
# and clients authenticate with pre-auth keys you create.
#
#   ops/init.sh                  # the volume directory
#   sudo chown -R 1000:1000 volumes/lib
#   docker compose up -d
#   docker compose exec headscale /ko-app/headscale users create ops
#   docker compose exec headscale /ko-app/headscale users list          # note the ID
#   docker compose exec headscale /ko-app/headscale preauthkeys create --user 1 --expiration 1h
#
# `--user` takes the numeric ID, not the name — v0.29.4 rejects a name.
#
# **./volumes/lib/noise_private.key is the tailnet's identity.** Lose it and
# every node has to be re-registered. Back it up off this host.
#
# OIDC is supported and not configured here — `oidc.client_secret_path` reads a
# file, which is the shape a Docker Secret would take. See README.
