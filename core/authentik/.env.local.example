# Authentik — local
#
#   cp .env.local.example .env.local

# --- Images ------------------------------------------------------- [image] --
APP_TAG=2026.8.5
DB_TAG=18-alpine
REDIS_TAG=8.10-alpine
INIT_IMAGE=alpine:3.24

# --- Database -------------------------------------------------------- [app] --
DB_NAME=authentik
DB_USER=authentik
#   openssl rand -base64 32 | tr -d '\n'
DB_PASSWORD=__REPLACE_ME__

# --- App Configuration ----------------------------------------------- [app] --
#   openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=__REPLACE_ME__

# --- Timezone -------------------------------------------------------- [app] --
TZ=UTC
