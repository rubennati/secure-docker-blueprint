# =============================================
# Infisical – LOCAL test env  (docker-compose.local.yml)
# =============================================
# Copy to .env.local and fill in. Plain values, gitignored — LOCAL ONLY.
#   cp .env.local.example .env.local
# =============================================

# --- Images (same as prod) ---
APP_TAG=v0.162.13
DB_TAG=16-alpine
REDIS_TAG=7.4-alpine

# --- Database (HEX password — URL-safe) ---
DB_NAME=infisical
DB_USER=infisical
# openssl rand -hex 32
DB_PASSWORD=__REPLACE_ME__

# --- App secrets (plain env for local) ---
# openssl rand -hex 16
ENCRYPTION_KEY=__REPLACE_ME__
# openssl rand -base64 32 | tr -d '\n'
AUTH_SECRET=__REPLACE_ME__

# --- Timezone ---
TZ=Europe/Vienna
