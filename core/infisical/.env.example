# =============================================
# Infisical – Environment
# =============================================
# Copy this file to .env and adjust all values.
# NEVER commit the .env file.
#
# Infisical is a self-hosted central secret manager. It holds other apps'
# secrets — default access is VPN-only (access-vpn). See README.md.
# =============================================

COMPOSE_PROJECT_NAME=infisical

# --- Domain & Traefik ---
APP_TRAEFIK_HOST=secrets.example.com
APP_TRAEFIK_CERT_RESOLVER=cloudflare-dns
# Access — VPN-only by default: a central secret manager must not sit on the
# public internet. Other servers pull secrets over Tailscale. Change to access-public
# ONLY with a deliberate decision (then also raise the security chain).
APP_TRAEFIK_ACCESS=access-vpn
# limit-standard: the burst of 500 holds the SPA's first load.
APP_TRAEFIK_LIMIT=limit-standard
# WHICH response headers the proxy sets — always the HSTS base, never less.
APP_TRAEFIK_HEADERS=headers-standard
# WHO must be identified — auth-none@file, auth-authentik@file, or the stack's own gate.
APP_TRAEFIK_AUTH=auth-none@file
TRAEFIK_NETWORK=proxy-public

# --- Images ---
# infisical/infisical (https://hub.docker.com/r/infisical/infisical)
# Pin a specific release, never :latest. Digest-pin for immutability (see apps/caldiy).
APP_TAG=v0.165.10
# postgres (https://hub.docker.com/_/postgres)
DB_TAG=16-alpine
# redis (https://hub.docker.com/_/redis)
REDIS_TAG=7.4-alpine

# --- Containers ---
CONTAINER_NAME_APP=${COMPOSE_PROJECT_NAME}-app
CONTAINER_NAME_DB=${COMPOSE_PROJECT_NAME}-db
CONTAINER_NAME_REDIS=${COMPOSE_PROJECT_NAME}-redis

# --- Database ---
DB_NAME=infisical
DB_USER=infisical

# --- SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDRESS=infisical@example.com
SMTP_FROM_NAME=Infisical
SMTP_USERNAME=

# --- Timezone ---
# Examples: UTC, Europe/Berlin, Europe/Vienna
TZ=UTC

# --- Secrets ---
# Create the secrets directory and generate all required files:
#   mkdir -p .secrets volumes/postgres volumes/redis
#   openssl rand -hex 32 > .secrets/db_pwd.txt              # hex = URL-safe for the DB URI
#   openssl rand -hex 16 > .secrets/encryption_key.txt      # Infisical ENCRYPTION_KEY (32 hex chars)
#   openssl rand -base64 32 | tr -d '\n' > .secrets/auth_secret.txt
#   touch .secrets/smtp_password.txt                        # write SMTP password here (optional)
